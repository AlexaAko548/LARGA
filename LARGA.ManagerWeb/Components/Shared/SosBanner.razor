@* Red bar across every staff page while any SOS is unresolved, so an emergency is seen within
   seconds wherever the manager is - not only on SOS Dispatch, and without waiting for the bell
   (whose SOS entries come from a 3-minute background check). Rendered by DashboardSidebar,
   which every authenticated page includes. Hidden on SOS Dispatch itself. *@
@using LARGA.SharedCore.Services
@using LARGA.ManagerWeb.Services
@implements IAsyncDisposable
@inject SosDispatchService SosDispatch
@inject SosBannerState BannerState

@if (_activeCount > 0 && !OnSosPage && !BannerState.Dismissed)
{
    <div class="sos-banner" role="alert">
        <a class="sos-banner-link" href="/sos-dispatch">
            <Icon Name="triangle-alert" Class="sos-banner-icon" />
            <span class="sos-banner-text">
                @(_activeCount == 1 ? "1 active SOS" : $"{_activeCount} active SOS alerts") - a driver needs help
            </span>
            <span class="sos-banner-action">Open SOS Dispatch</span>
        </a>
        <button type="button" class="sos-banner-dismiss" title="Hide until a new alert comes in" aria-label="Dismiss" @onclick="Dismiss">×</button>
    </div>
}

@code {
    /// <summary>True on the SOS Dispatch page, which already lists the alerts.</summary>
    [Parameter] public bool OnSosPage { get; set; }

    /// <summary>Fires whenever the active-SOS count is (re)loaded, so a host like DashboardSidebar can show its own indicator (e.g. a nav badge) independent of whether this banner is dismissed.</summary>
    [Parameter] public EventCallback<int> OnActiveCountChanged { get; set; }

    // Same cadence as SOS Dispatch's own refresh.
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(10);

    private int _activeCount;

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _timerCts;

    // The dismiss button only hides the current situation - if the count changes at all (a new
    // SOS comes in, or one gets resolved) since it was dismissed, it's a different situation, so
    // the banner comes back. Tracked in BannerState (scoped per browser session) rather than on
    // this component, since navigating to another page tears this component down and a fresh one
    // would otherwise forget the dismissal was ever requested.
    private void Dismiss() => BannerState.Dismiss(_activeCount);

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        BannerState.ReconcileCount(_activeCount);
        await NotifyCountChangedAsync();

        _timerCts = new CancellationTokenSource();
        _timer = new PeriodicTimer(RefreshInterval);
        _ = PollLoopAsync(_timerCts.Token);
    }

    private async Task PollLoopAsync(CancellationToken token)
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync(token))
            {
                int before = _activeCount;
                await RefreshAsync();
                if (before != _activeCount)
                {
                    BannerState.ReconcileCount(_activeCount);
                    await InvokeAsync(StateHasChanged);
                    await NotifyCountChangedAsync();
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the component is disposed.
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            _activeCount = await SosDispatch.GetActiveCountAsync();
        }
        catch
        {
            // Same stance as NotificationBell: a Firestore hiccup keeps the last-known count
            // rather than breaking the page.
        }
    }

    private Task NotifyCountChangedAsync() =>
        OnActiveCountChanged.HasDelegate ? OnActiveCountChanged.InvokeAsync(_activeCount) : Task.CompletedTask;

    public ValueTask DisposeAsync()
    {
        _timerCts?.Cancel();
        _timer?.Dispose();
        _timerCts?.Dispose();
        return ValueTask.CompletedTask;
    }
}
