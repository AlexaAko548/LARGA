@using System.Security.Claims
@using System.Text.Json
@using LARGA.ManagerWeb.Models
@using LARGA.ManagerWeb.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Google.Cloud.Firestore
@inject IManagerAuthService ManagerAuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject Lazy<FirestoreDb> FirestoreDb
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject PayoutAccountService PayoutAccounts
@inject DuressPinService DuressPins

@* Header profile menu: the same pill the header always showed, now opening Settings
   (contact number, password) and Logout. Styled with the app's own header/modal classes. *@

<div class="manager-menu">
    <button class="manager-pill manager-menu-trigger" type="button" aria-haspopup="menu" aria-expanded="@_isDropdownOpen" title="@_roleLabel" @onclick="ToggleDropdown">
        <span class="manager-dot"></span>
        <span>@_displayName</span>
        <span class="caret"><Icon Name="chevron-down" /></span>
    </button>

    @if (_isDropdownOpen)
    {
        <div class="manager-menu-backdrop" @onclick="() => _isDropdownOpen = false"></div>
        <div class="manager-menu-dropdown" role="menu">
            <div class="manager-menu-theme">
                <span class="manager-menu-theme-label">Appearance</span>
                <div class="theme-switch" role="group" aria-label="Appearance">
                    @foreach (var (mode, label) in ThemeModes)
                    {
                        <button type="button" class="@(_themeMode == mode ? "active" : null)" aria-pressed="@(_themeMode == mode)" @onclick="() => SetThemeAsync(mode)">@label</button>
                    }
                </div>
            </div>
            <button type="button" class="manager-menu-item" role="menuitem" @onclick="OpenSettingsModal">Settings</button>
            <button type="button" class="manager-menu-item danger" role="menuitem" @onclick="HandleLogoutAsync">Logout</button>
        </div>
    }
</div>

@if (_isSettingsModalOpen)
{
    <div class="report-overlay" @onclick="CloseSettingsModal">
        <div class="report-modal" @onclick:stopPropagation="true">
            <div class="report-header">
                <h3>Manager Settings</h3>
                <button type="button" class="close-modal" aria-label="Close" @onclick="CloseSettingsModal">×</button>
            </div>

            <div class="report-body">
                <EditForm Model="_contactModel" FormName="manager-contact" OnValidSubmit="UpdateContactNumberAsync" class="report-section">
                    <DataAnnotationsValidator />
                    <label>Update contact number</label>

                    <div class="form-block">
                        <InputText @bind-Value="_contactModel.CurrentContactNumber" type="tel" maxlength="16" placeholder="Current number" />
                        <ValidationMessage For="() => _contactModel.CurrentContactNumber" class="field-error" />
                    </div>
                    <div class="form-block">
                        <InputText @bind-Value="_contactModel.NewContactNumber" type="tel" maxlength="16" placeholder="New number, e.g. 0917 123 4567" />
                        <ValidationMessage For="() => _contactModel.NewContactNumber" class="field-error" />
                    </div>
                    <div class="form-block">
                        <InputText @bind-Value="_contactModel.ConfirmContactNumber" type="tel" maxlength="16" placeholder="Confirm new number" />
                        <ValidationMessage For="() => _contactModel.ConfirmContactNumber" class="field-error" />
                    </div>

                    @if (!string.IsNullOrEmpty(_contactMessage))
                    {
                        <div class="@(_contactSaved ? "field-ok" : "field-error")">@_contactMessage</div>
                    }

                    <div class="manager-menu-form-actions">
                        <button class="download-btn" type="submit" disabled="@_isSavingContact" aria-busy="@_isSavingContact">@(_isSavingContact ? "Saving…" : "Update Number")</button>
                    </div>
                </EditForm>

                @if (IsManager)
                {
                    @* Target account verification: e-receipts sent to any other account are flagged in the
                       Quick Ledger (mobile) and the Financial Ledger. *@
                    <div class="report-section payout-accounts">
                        <label>Authorized payout accounts</label>
                        <span class="manager-menu-hint">GCash numbers and bank accounts drivers may send boundary payments to. Receipts sent anywhere else are flagged.</span>

                        @if (_payoutAccounts is null)
                        {
                            <span class="manager-menu-hint">Loading…</span>
                        }
                        else if (_payoutAccounts.Count == 0)
                        {
                            <span class="manager-menu-hint">None yet - receipts can't be checked until you add one.</span>
                        }
                        else
                        {
                            <ul class="payout-account-list">
                                @foreach (string account in _payoutAccounts)
                                {
                                    string current = account;
                                    <li>
                                        <span>@current</span>
                                        <button type="button" class="cancel-btn" disabled="@_isSavingPayout" @onclick="() => RemovePayoutAccountAsync(current)">Remove</button>
                                    </li>
                                }
                            </ul>
                        }

                        <div class="payout-account-add">
                            <input class="text-input" type="text" maxlength="@PayoutAccountService.MaxAccountLength" placeholder="e.g. 0917 123 4567 or BDO 001234567890"
                                   @bind="_newPayoutAccount" @bind:event="oninput" />
                            <button class="download-btn" type="button" disabled="@(_isSavingPayout || string.IsNullOrWhiteSpace(_newPayoutAccount))" @onclick="AddPayoutAccountAsync">Add</button>
                        </div>
                        @if (!string.IsNullOrEmpty(_payoutError))
                        {
                            <div class="field-error">@_payoutError</div>
                        }
                    </div>

                    @* Duress PIN: one PIN for every driver. Entered through "Enter PIN" on the app's
                       clock-out screen, it sends a silent Hostile SOS and the clock-out carries on. *@
                    <div class="report-section duress-pin">
                        <label>Emergency PIN (drivers)</label>
                        <span class="manager-menu-hint">
                            Share this with all drivers. Entering it through "Enter PIN" on the clock-out screen silently sends a hostile-situation SOS,
                            while the app carries on with a normal clock-out.
                        </span>
                        @if (_duressPin is null)
                        {
                            <span class="manager-menu-hint">Loading…</span>
                        }
                        else
                        {
                            <span class="manager-menu-hint">Current PIN: <strong>@(_duressPin.Length == 0 ? "not set" : _duressPin)</strong></span>
                        }
                        <div class="payout-account-add">
                            <input class="text-input" type="text" inputmode="numeric" maxlength="@DuressPinService.MaxLength"
                                   placeholder="@($"{DuressPinService.MinLength}-{DuressPinService.MaxLength} digits")"
                                   @bind="_newDuressPin" @bind:event="oninput" />
                            <button class="download-btn" type="button" disabled="@(_isSavingDuressPin || string.IsNullOrWhiteSpace(_newDuressPin))" @onclick="SaveDuressPinAsync">Save</button>
                        </div>
                        @if (!string.IsNullOrEmpty(_duressPinMessage))
                        {
                            <div class="@(_duressPinSaved ? "field-ok" : "field-error")">@_duressPinMessage</div>
                        }
                    </div>
                }

                <EditForm Model="_passwordModel" FormName="manager-password" OnValidSubmit="UpdatePasswordAsync" class="report-section">
                    <DataAnnotationsValidator />
                    <label>Update password</label>

                    <div class="form-block">
                        <InputText @bind-Value="_passwordModel.CurrentPassword" type="password" maxlength="64" placeholder="Current password" />
                        <ValidationMessage For="() => _passwordModel.CurrentPassword" class="field-error" />
                    </div>
                    <div class="form-block">
                        <InputText @bind-Value="_passwordModel.NewPassword" type="password" maxlength="64" placeholder="New password" />
                        <ValidationMessage For="() => _passwordModel.NewPassword" class="field-error" />
                    </div>
                    <div class="form-block">
                        <InputText @bind-Value="_passwordModel.ConfirmPassword" type="password" maxlength="64" placeholder="Confirm new password" />
                        <ValidationMessage For="() => _passwordModel.ConfirmPassword" class="field-error" />
                    </div>

                    @if (!string.IsNullOrEmpty(_passwordError))
                    {
                        <div class="field-error">@_passwordError</div>
                    }

                    <div class="manager-menu-form-actions">
                        <span class="manager-menu-hint">You'll be signed out after changing it.</span>
                        <button class="download-btn" type="submit" disabled="@_isSavingPassword" aria-busy="@_isSavingPassword">@(_isSavingPassword ? "Saving…" : "Save Password")</button>
                    </div>
                </EditForm>
            </div>

            <div class="report-actions">
                <button class="cancel-btn" type="button" @onclick="CloseSettingsModal">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isDropdownOpen;
    private bool _isSettingsModalOpen;

    private UpdateContactModel _contactModel = new();
    private string? _contactMessage;
    private bool _contactSaved;
    private bool _isSavingContact;

    private UpdatePasswordModel _passwordModel = new();
    private string? _passwordError;
    private bool _isSavingPassword;

    private IJSObjectReference? _firebaseModule;

    // Saved per browser by window.largaTheme (App.razor); "system" follows the OS setting.
    private static readonly (string Mode, string Label)[] ThemeModes =
        [("system", "System"), ("light", "Light"), ("dark", "Dark")];
    private string _themeMode = "system";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _themeMode = await JS.InvokeAsync<string>("largaTheme.get");
            StateHasChanged();
        }
        catch (JSException)
        {
            // Keep "system"; the switch still works.
        }
    }

    private async Task SetThemeAsync(string mode)
    {
        _themeMode = mode;
        try
        {
            await JS.InvokeVoidAsync("largaTheme.set", mode);
        }
        catch (JSException)
        {
        }
    }
    // Whoever is signed in: name from users/{uid}, falling back to the account's email. The role
    // comes from the session itself, so it's the same role the pages enforce.
    private string _displayName = "Manager";
    private string _roleLabel = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
            string? uid = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            string? email = authState.User.FindFirst(ClaimTypes.Email)?.Value;
            _roleLabel = authState.User.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;

            if (!string.IsNullOrWhiteSpace(email))
            {
                _displayName = email;
            }

            if (!string.IsNullOrEmpty(uid))
            {
                DocumentSnapshot profile = await FirestoreDb.Value.Collection("users").Document(uid).GetSnapshotAsync();
                if (profile.Exists && profile.TryGetValue("fullName", out string fullName) && !string.IsNullOrWhiteSpace(fullName))
                {
                    _displayName = fullName;
                }
            }
        }
        catch
        {
            // Keep the fallback name if the lookup fails; the header shouldn't break the page.
        }
    }

    private void ToggleDropdown() => _isDropdownOpen = !_isDropdownOpen;

    private bool IsManager => string.Equals(_roleLabel, ManagerSignInService.ManagerRole, StringComparison.OrdinalIgnoreCase);

    private List<string>? _payoutAccounts;
    private string _newPayoutAccount = string.Empty;
    private string? _payoutError;
    private bool _isSavingPayout;

    private async Task OpenSettingsModal()
    {
        _isDropdownOpen = false;
        _isSettingsModalOpen = true;
        if (IsManager)
        {
            await LoadPayoutAccountsAsync();
            await LoadDuressPinAsync();
        }
    }

    private string? _duressPin;
    private string _newDuressPin = string.Empty;
    private string? _duressPinMessage;
    private bool _duressPinSaved;
    private bool _isSavingDuressPin;

    private async Task LoadDuressPinAsync()
    {
        try
        {
            _duressPin = await DuressPins.GetAsync();
        }
        catch (Exception)
        {
            _duressPin = string.Empty;
            _duressPinSaved = false;
            _duressPinMessage = "Couldn't load the emergency PIN. Please try again.";
        }
    }

    private async Task SaveDuressPinAsync()
    {
        if (_isSavingDuressPin) return; // a second click while this is still running is ignored
        _isSavingDuressPin = true;
        _duressPinMessage = null;
        try
        {
            string? error = await DuressPins.SetAsync(_newDuressPin, await CurrentUserIdAsync());
            _duressPinSaved = error is null;
            _duressPinMessage = error ?? "Emergency PIN saved. Drivers' phones pick it up the next time they open the Active Shift screen.";
            if (error is null)
            {
                _newDuressPin = string.Empty;
                await LoadDuressPinAsync();
            }
        }
        catch (Exception)
        {
            _duressPinSaved = false;
            _duressPinMessage = "Couldn't save the emergency PIN. Please try again.";
        }
        finally
        {
            _isSavingDuressPin = false;
        }
    }

    private async Task LoadPayoutAccountsAsync()
    {
        try
        {
            _payoutAccounts = await PayoutAccounts.GetAsync();
        }
        catch (Exception)
        {
            _payoutAccounts = new List<string>();
            _payoutError = "Couldn't load the authorized accounts. Please try again.";
        }
    }

    private async Task<string> CurrentUserIdAsync() =>
        (await AuthStateProvider.GetAuthenticationStateAsync()).User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

    private async Task AddPayoutAccountAsync()
    {
        if (_isSavingPayout) return; // a second click while this is still running is ignored
        _isSavingPayout = true;
        _payoutError = null;
        try
        {
            _payoutError = await PayoutAccounts.AddAsync(_newPayoutAccount, await CurrentUserIdAsync());
            if (_payoutError is null)
            {
                _newPayoutAccount = string.Empty;
                await LoadPayoutAccountsAsync();
            }
        }
        catch (Exception)
        {
            _payoutError = "Couldn't save the account. Please try again.";
        }
        finally
        {
            _isSavingPayout = false;
        }
    }

    private async Task RemovePayoutAccountAsync(string account)
    {
        if (_isSavingPayout) return; // a second click while this is still running is ignored
        _isSavingPayout = true;
        _payoutError = null;
        try
        {
            await PayoutAccounts.RemoveAsync(account, await CurrentUserIdAsync());
            await LoadPayoutAccountsAsync();
        }
        catch (Exception)
        {
            _payoutError = "Couldn't remove the account. Please try again.";
        }
        finally
        {
            _isSavingPayout = false;
        }
    }

    private void CloseSettingsModal()
    {
        _isSettingsModalOpen = false;
        _contactModel = new();
        _passwordModel = new();
        _contactMessage = null;
        _contactSaved = false;
        _passwordError = null;
        _newPayoutAccount = string.Empty;
        _payoutError = null;
        _newDuressPin = string.Empty;
        _duressPinMessage = null;
    }

    private async Task UpdateContactNumberAsync()
    {
        if (_isSavingContact) return; // a second click while this is still running is ignored
        _isSavingContact = true;
        _contactMessage = null;
        try
        {
            var (success, error) = await ManagerAuthService.UpdateContactNumberAsync(_contactModel);
            _contactSaved = success;
            _contactMessage = success ? "Contact number updated." : error;
            if (success)
            {
                _contactModel = new();
            }
        }
        finally
        {
            _isSavingContact = false;
        }
    }

    // The current password is checked by Firebase itself (sign-in), in the browser - see
    // largaFirebaseChangePassword. The email is the signed-in manager's, from the server session.
    private async Task UpdatePasswordAsync()
    {
        if (_isSavingPassword) return; // a second click while this is still running is ignored
        _isSavingPassword = true;
        _passwordError = null;
        try
        {
            AuthenticationState state = await AuthStateProvider.GetAuthenticationStateAsync();
            string? email = state.User.FindFirst(ClaimTypes.Email)?.Value;
            if (string.IsNullOrEmpty(email))
            {
                _passwordError = "Couldn't verify your account. Please sign out and back in, then try again.";
                return;
            }

            IJSObjectReference module = await GetFirebaseModuleAsync();
            JsonElement result = await module.InvokeAsync<JsonElement>(
                "largaFirebaseChangePassword", email, _passwordModel.CurrentPassword, _passwordModel.NewPassword);

            if (result.TryGetProperty("ok", out JsonElement ok) && ok.ValueKind == JsonValueKind.True)
            {
                await HandleLogoutAsync();
                return;
            }

            _passwordError = result.TryGetProperty("message", out JsonElement message) && message.ValueKind == JsonValueKind.String
                ? message.GetString()
                : "Could not update your password. Please try again.";
        }
        catch (JSException)
        {
            _passwordError = "Could not update your password. Please try again.";
        }
        finally
        {
            _isSavingPassword = false;
        }
    }

    private async Task<IJSObjectReference> GetFirebaseModuleAsync() =>
        _firebaseModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/firebase-auth.js");

    // Ends both sessions: the browser's Firebase sign-in, then the server cookie.
    private async Task HandleLogoutAsync()
    {
        try
        {
            IJSObjectReference module = await GetFirebaseModuleAsync();
            await module.InvokeAsync<bool>("largaFirebaseSignOut");
        }
        catch (JSException)
        {
            // The server sign-out below still ends the portal session.
        }

        Navigation.NavigateTo("/auth/signout", forceLoad: true);
    }
}
