@using System.Globalization
@using System.Security.Claims
@using System.Text.Json
@using LARGA.ManagerWeb.Models
@using LARGA.ManagerWeb.Services
@using LARGA.SharedCore.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Google.Cloud.Firestore
@implements IAsyncDisposable
@inject IManagerAuthService ManagerAuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject Lazy<FirestoreDb> FirestoreDb
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject PayoutAccountService PayoutAccounts
@inject DuressPinService DuressPins
@inject BoundaryRateService BoundaryRates
@inject AccessRequestService AccessRequests
@inject PushTokenStore PushTokens

@* Header profile menu: the same pill the header always showed, now opening Settings
   (contact number, password) and Logout. Styled with the app's own header/modal classes. *@

<div class="manager-menu" data-popup>
    <button class="manager-pill manager-menu-trigger" type="button" aria-haspopup="menu" aria-expanded="@_isDropdownOpen" title="@_roleLabel" data-popup-toggle @onclick="ToggleDropdown">
        <span class="manager-dot"></span>
        <span>@_displayName</span>
        @if (_pendingAccessRequests > 0)
        {
            <span class="manager-menu-count" title="@_pendingAccessRequests access request(s) waiting - open Team & Access">@_pendingAccessRequests</span>
        }
        <span class="caret"><Icon Name="chevron-down" /></span>
    </button>

    @if (_isDropdownOpen)
    {
        <div class="manager-menu-dropdown" role="menu" data-popup-panel>
            <div class="manager-menu-theme">
                <span class="manager-menu-theme-label">Appearance</span>
                <div class="theme-switch" role="group" aria-label="Appearance">
                    @foreach (var (mode, label) in ThemeModes)
                    {
                        <button type="button" class="@(_themeMode == mode ? "active" : null)" aria-pressed="@(_themeMode == mode)" @onclick="() => SetThemeAsync(mode)">@label</button>
                    }
                </div>
            </div>
            <button type="button" class="manager-menu-item" role="menuitem" @onclick="OpenHelp">Help &amp; FAQs</button>
            <button type="button" class="manager-menu-item" role="menuitem" @onclick="OpenSettingsModal">Settings</button>
            @if (IsManager)
            {
                @* Owner only: who may use the dashboard - access requests and current Assistant Managers. *@
                <button type="button" class="manager-menu-item" role="menuitem" @onclick="OpenTeamAccess">
                    Team &amp; Access
                    @if (_pendingAccessRequests > 0)
                    {
                        <span class="manager-menu-count">@_pendingAccessRequests</span>
                    }
                </button>
            }
            <button type="button" class="manager-menu-item danger" role="menuitem" @onclick="HandleLogoutAsync">Logout</button>
        </div>
    }
</div>

@if (_isSettingsModalOpen)
{
    <div class="report-overlay" @onclick="CloseSettingsModal">
        <div class="report-modal settings-modal" role="dialog" aria-modal="true" aria-labelledby="settings-title" @onclick:stopPropagation="true">
            <div class="report-header">
                <h3 id="settings-title">Settings</h3>
                <button type="button" class="close-modal" aria-label="Close" @onclick="CloseSettingsModal">×</button>
            </div>

            <div class="report-body">
                @if (IsManager)
                {
                    <h4 class="settings-group">Fleet &amp; payments</h4>

                    @* The daily boundary. A new rate only applies to shifts that start after it's saved
                       (BoundaryRateSchedule), so it asks for confirmation first. *@
                    <section class="settings-section boundary-rate" aria-labelledby="settings-rate-title">
                        <div class="settings-about">
                            <h5 id="settings-rate-title">Boundary payment rate</h5>
                            <p>What a driver owes for one day. A new rate applies to shifts that start after you save it; earlier shifts keep their old rate.</p>
                        </div>
                        <div class="settings-controls">
                            <div class="settings-current">
                                <span>Current rate</span>
                                <strong>@(_boundaryRate is decimal rate ? $"₱{rate:N0} per day" : _boundaryRateLoadFailed ? "Unavailable" : "Loading…")</strong>
                            </div>

                            @if (_pendingBoundaryRate is decimal pending)
                            {
                                <div class="settings-confirm" role="alert">
                                    <span>Change the daily boundary from <strong>₱@($"{_boundaryRate:N0}")</strong> to <strong>₱@($"{pending:N0}")</strong>?</span>
                                    <div class="settings-actions">
                                        <button class="cancel-btn" type="button" disabled="@_isSavingBoundaryRate" @onclick="() => _pendingBoundaryRate = null">Cancel</button>
                                        <button class="download-btn" type="button" disabled="@_isSavingBoundaryRate" aria-busy="@_isSavingBoundaryRate" @onclick="SaveBoundaryRateAsync">@(_isSavingBoundaryRate ? "Saving…" : "Confirm change")</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="settings-field">
                                    <label for="settings-new-rate">New rate (₱ per day)</label>
                                    <div class="settings-inline">
                                        <input id="settings-new-rate" class="text-input" type="text" inputmode="numeric" maxlength="6" placeholder="e.g. 900" autocomplete="off"
                                               @bind="_newBoundaryRate" @bind:event="oninput" />
                                        <button class="download-btn" type="button" disabled="@(_boundaryRate is null || string.IsNullOrWhiteSpace(_newBoundaryRate))" @onclick="ReviewBoundaryRate">Update rate</button>
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(_boundaryRateMessage))
                            {
                                <div class="@(_boundaryRateSaved ? "field-ok" : "field-error")" role="status">@_boundaryRateMessage</div>
                            }
                        </div>
                    </section>

                    @* Target account verification: e-receipts sent to any other account are flagged in the
                       Quick Ledger (mobile) and the Financial Ledger. *@
                    <section class="settings-section payout-accounts" aria-labelledby="settings-payout-title">
                        <div class="settings-about">
                            <h5 id="settings-payout-title">Authorized payout accounts</h5>
                            <p>GCash numbers and bank accounts drivers may send boundary payments to. Receipts sent anywhere else are flagged.</p>
                        </div>
                        <div class="settings-controls">
                            @if (_payoutAccounts is null)
                            {
                                <span class="manager-menu-hint">Loading…</span>
                            }
                            else if (_payoutAccounts.Count == 0)
                            {
                                <span class="manager-menu-hint">None yet - receipts can't be checked until you add one.</span>
                            }
                            else
                            {
                                <ul class="payout-account-list">
                                    @foreach (string account in _payoutAccounts)
                                    {
                                        string current = account;
                                        <li>
                                            <span>@current</span>
                                            <button type="button" class="cancel-btn" disabled="@_isSavingPayout" @onclick="() => RemovePayoutAccountAsync(current)">Remove</button>
                                        </li>
                                    }
                                </ul>
                            }

                            <div class="settings-field">
                                <label for="settings-new-account">Add an account</label>
                                <div class="settings-inline">
                                    <input id="settings-new-account" class="text-input" type="text" maxlength="@PayoutAccountService.MaxAccountLength" placeholder="e.g. 0917 123 4567 or BDO 001234567890"
                                           @bind="_newPayoutAccount" @bind:event="oninput" />
                                    <button class="download-btn" type="button" disabled="@(_isSavingPayout || string.IsNullOrWhiteSpace(_newPayoutAccount))" @onclick="AddPayoutAccountAsync">Add</button>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(_payoutError))
                            {
                                <div class="field-error">@_payoutError</div>
                            }
                        </div>
                    </section>

                    @* Duress PIN: one PIN for every driver. Entered through "Enter PIN" on the app's
                       clock-out screen, it sends a silent Hostile SOS and the clock-out carries on. *@
                    <section class="settings-section duress-pin" aria-labelledby="settings-pin-title">
                        <div class="settings-about">
                            <h5 id="settings-pin-title">Emergency PIN (drivers)</h5>
                            <p>Share this with all drivers. Entering it through "Enter PIN" on the clock-out screen silently sends a hostile-situation SOS, while the app carries on with a normal clock-out.</p>
                        </div>
                        <div class="settings-controls">
                            <div class="settings-current">
                                <span>Current PIN</span>
                                <strong>@(_duressPin is null ? "Loading…" : _duressPin.Length == 0 ? "Not set" : _duressPin)</strong>
                            </div>
                            <div class="settings-field">
                                <label for="settings-new-pin">New PIN</label>
                                <div class="settings-inline">
                                    <input id="settings-new-pin" class="text-input" type="text" inputmode="numeric" maxlength="@DuressPinService.MaxLength" autocomplete="off"
                                           placeholder="@($"{DuressPinService.MinLength}-{DuressPinService.MaxLength} digits")"
                                           @bind="_newDuressPin" @bind:event="oninput" />
                                    <button class="download-btn" type="button" disabled="@(_isSavingDuressPin || string.IsNullOrWhiteSpace(_newDuressPin))" @onclick="SaveDuressPinAsync">Save</button>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(_duressPinMessage))
                            {
                                <div class="@(_duressPinSaved ? "field-ok" : "field-error")">@_duressPinMessage</div>
                            }
                        </div>
                    </section>
                }

                <h4 class="settings-group">Your account</h4>

                <section class="settings-section" aria-labelledby="settings-contact-title">
                    <div class="settings-about">
                        <h5 id="settings-contact-title">Contact number</h5>
                        <p>Your mobile number, used to reach you.</p>
                    </div>
                    <EditForm Model="_contactModel" FormName="manager-contact" OnValidSubmit="UpdateContactNumberAsync" class="settings-controls">
                        <DataAnnotationsValidator />
                        <div class="settings-field">
                            <label for="settings-contact-current">Current number</label>
                            <InputText id="settings-contact-current" @bind-Value="_contactModel.CurrentContactNumber" type="tel" class="text-input" maxlength="16" placeholder="Current number" />
                            <ValidationMessage For="() => _contactModel.CurrentContactNumber" class="field-error" />
                        </div>
                        <div class="settings-field">
                            <label for="settings-contact-new">New number</label>
                            <InputText id="settings-contact-new" @bind-Value="_contactModel.NewContactNumber" type="tel" class="text-input" maxlength="16" placeholder="e.g. 0917 123 4567" />
                            <ValidationMessage For="() => _contactModel.NewContactNumber" class="field-error" />
                        </div>
                        <div class="settings-field">
                            <label for="settings-contact-confirm">Confirm new number</label>
                            <InputText id="settings-contact-confirm" @bind-Value="_contactModel.ConfirmContactNumber" type="tel" class="text-input" maxlength="16" placeholder="Type it again" />
                            <ValidationMessage For="() => _contactModel.ConfirmContactNumber" class="field-error" />
                        </div>

                        @if (!string.IsNullOrEmpty(_contactMessage))
                        {
                            <div class="@(_contactSaved ? "field-ok" : "field-error")">@_contactMessage</div>
                        }

                        <div class="settings-actions">
                            <button class="download-btn" type="submit" disabled="@_isSavingContact" aria-busy="@_isSavingContact">@(_isSavingContact ? "Saving…" : "Update number")</button>
                        </div>
                    </EditForm>
                </section>

                <section class="settings-section" aria-labelledby="settings-password-title">
                    <div class="settings-about">
                        <h5 id="settings-password-title">Password</h5>
                        <p>You'll be signed out after changing it.</p>
                    </div>
                    <EditForm Model="_passwordModel" FormName="manager-password" OnValidSubmit="UpdatePasswordAsync" class="settings-controls">
                        <DataAnnotationsValidator />
                        <div class="settings-field">
                            <label for="settings-password-current">Current password</label>
                            <div class="password-field">
                                <InputText id="settings-password-current" @bind-Value="_passwordModel.CurrentPassword" type="@(_showCurrentPassword ? "text" : "password")" class="text-input" maxlength="64" autocomplete="current-password" />
                                <button type="button" class="password-toggle" @onclick="() => _showCurrentPassword = !_showCurrentPassword"
                                        aria-label="@(_showCurrentPassword ? "Hide password" : "Show password")" title="@(_showCurrentPassword ? "Hide password" : "Show password")">
                                    <Icon Name="@(_showCurrentPassword ? "eye-off" : "eye")" />
                                </button>
                            </div>
                            <ValidationMessage For="() => _passwordModel.CurrentPassword" class="field-error" />
                        </div>
                        <div class="settings-field">
                            <label for="settings-password-new">New password</label>
                            <div class="password-field">
                                <InputText id="settings-password-new" @bind-Value="_passwordModel.NewPassword" type="@(_showNewPassword ? "text" : "password")" class="text-input" maxlength="64" autocomplete="new-password" />
                                <button type="button" class="password-toggle" @onclick="() => _showNewPassword = !_showNewPassword"
                                        aria-label="@(_showNewPassword ? "Hide password" : "Show password")" title="@(_showNewPassword ? "Hide password" : "Show password")">
                                    <Icon Name="@(_showNewPassword ? "eye-off" : "eye")" />
                                </button>
                            </div>
                            <ValidationMessage For="() => _passwordModel.NewPassword" class="field-error" />
                        </div>
                        <div class="settings-field">
                            <label for="settings-password-confirm">Confirm new password</label>
                            <div class="password-field">
                                <InputText id="settings-password-confirm" @bind-Value="_passwordModel.ConfirmPassword" type="@(_showConfirmPassword ? "text" : "password")" class="text-input" maxlength="64" autocomplete="new-password" />
                                <button type="button" class="password-toggle" @onclick="() => _showConfirmPassword = !_showConfirmPassword"
                                        aria-label="@(_showConfirmPassword ? "Hide password" : "Show password")" title="@(_showConfirmPassword ? "Hide password" : "Show password")">
                                    <Icon Name="@(_showConfirmPassword ? "eye-off" : "eye")" />
                                </button>
                            </div>
                            <ValidationMessage For="() => _passwordModel.ConfirmPassword" class="field-error" />
                        </div>

                        @if (!string.IsNullOrEmpty(_passwordError))
                        {
                            <div class="field-error">@_passwordError</div>
                        }

                        <div class="settings-actions">
                            <button class="download-btn" type="submit" disabled="@_isSavingPassword" aria-busy="@_isSavingPassword">@(_isSavingPassword ? "Saving…" : "Save password")</button>
                        </div>
                    </EditForm>
                </section>
            </div>

            <div class="report-actions">
                <button class="cancel-btn" type="button" @onclick="CloseSettingsModal">Close</button>
            </div>
        </div>
    </div>
}

@if (_isTeamAccessOpen)
{
    <TeamAccessPanel ActorUserId="@_currentUid" OnClose="CloseTeamAccessAsync"
                     OnPendingChanged="count => _pendingAccessRequests = count" />
}

@code {
    private bool _isDropdownOpen;
    private bool _isSettingsModalOpen;
    private bool _isTeamAccessOpen;
    private int _pendingAccessRequests;
    private string _currentUid = string.Empty;

    // Help & FAQs is open to both roles (the page only needs a signed-in Manager or Assistant Manager).
    private void OpenHelp()
    {
        _isDropdownOpen = false;
        Navigation.NavigateTo("/help");
    }

    private void OpenTeamAccess()
    {
        _isDropdownOpen = false;
        _isTeamAccessOpen = true;
    }

    private UpdateContactModel _contactModel = new();
    private string? _contactMessage;
    private bool _contactSaved;
    private bool _isSavingContact;

    private UpdatePasswordModel _passwordModel = new();
    private string? _passwordError;
    private bool _isSavingPassword;
    private bool _showCurrentPassword;
    private bool _showNewPassword;
    private bool _showConfirmPassword;

    private IJSObjectReference? _firebaseModule;

    // Saved per browser by window.largaTheme (App.razor); "system" follows the OS setting.
    private static readonly (string Mode, string Label)[] ThemeModes =
        [("system", "System"), ("light", "Light"), ("dark", "Dark")];
    private string _themeMode = "system";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _themeMode = await JS.InvokeAsync<string>("largaTheme.get");
            StateHasChanged();
        }
        catch (JSException)
        {
            // Keep "system"; the switch still works.
        }
    }

    private async Task SetThemeAsync(string mode)
    {
        _themeMode = mode;
        try
        {
            await JS.InvokeVoidAsync("largaTheme.set", mode);
        }
        catch (JSException)
        {
        }
    }
    // Whoever is signed in: name from users/{uid}, falling back to the account's email. The role
    // comes from the session itself, so it's the same role the pages enforce.
    private string _displayName = "Manager";
    private string _roleLabel = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
            string? uid = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            string? email = authState.User.FindFirst(ClaimTypes.Email)?.Value;
            _roleLabel = authState.User.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;
            _currentUid = uid ?? string.Empty;
            if (IsManager)
            {
                await RefreshPendingCountAsync();
                _pendingCts = new CancellationTokenSource();
                _pendingTimer = new PeriodicTimer(PendingRefreshInterval);
                _ = PollPendingCountAsync(_pendingCts.Token);
            }

            if (!string.IsNullOrWhiteSpace(email))
            {
                _displayName = email;
            }

            if (!string.IsNullOrEmpty(uid))
            {
                DocumentSnapshot profile = await FirestoreDb.Value.Collection("users").Document(uid).GetSnapshotAsync();
                if (profile.Exists && profile.TryGetValue("fullName", out string fullName) && !string.IsNullOrWhiteSpace(fullName))
                {
                    _displayName = fullName;
                }
            }
        }
        catch
        {
            // Keep the fallback name if the lookup fails; the header shouldn't break the page.
        }
    }

    private async Task ToggleDropdown()
    {
        _isDropdownOpen = !_isDropdownOpen;
        if (_isDropdownOpen && IsManager)
        {
            await RefreshPendingCountAsync();
        }
    }

    // The access-request badge: polled while the page is open (same 60s as NotificationBell), and
    // re-read when the menu opens or Team & Access closes, so a new request shows without a reload.
    private static readonly TimeSpan PendingRefreshInterval = TimeSpan.FromSeconds(60);
    private PeriodicTimer? _pendingTimer;
    private CancellationTokenSource? _pendingCts;

    private async Task PollPendingCountAsync(CancellationToken token)
    {
        try
        {
            while (_pendingTimer is not null && await _pendingTimer.WaitForNextTickAsync(token))
            {
                await RefreshPendingCountAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the component is disposed.
        }
    }

    private async Task RefreshPendingCountAsync()
    {
        try
        {
            _pendingAccessRequests = await AccessRequests.CountPendingAsync();
        }
        catch (Exception)
        {
            // The badge is a hint; keep the last count. The panel itself still loads the list.
        }
    }

    private async Task CloseTeamAccessAsync()
    {
        _isTeamAccessOpen = false;
        await RefreshPendingCountAsync();
    }

    public ValueTask DisposeAsync()
    {
        _pendingCts?.Cancel();
        _pendingTimer?.Dispose();
        _pendingCts?.Dispose();
        return ValueTask.CompletedTask;
    }

    private bool IsManager => string.Equals(_roleLabel, ManagerSignInService.ManagerRole, StringComparison.OrdinalIgnoreCase);

    private List<string>? _payoutAccounts;
    private string _newPayoutAccount = string.Empty;
    private string? _payoutError;
    private bool _isSavingPayout;

    private async Task OpenSettingsModal()
    {
        _isDropdownOpen = false;
        _isSettingsModalOpen = true;
        if (IsManager)
        {
            await LoadBoundaryRateAsync();
            await LoadPayoutAccountsAsync();
            await LoadDuressPinAsync();
        }
    }

    private decimal? _boundaryRate;
    private bool _boundaryRateLoadFailed;
    private string _newBoundaryRate = string.Empty;
    private decimal? _pendingBoundaryRate; // typed and checked, waiting for "Confirm change"
    private string? _boundaryRateMessage;
    private bool _boundaryRateSaved;
    private bool _isSavingBoundaryRate;

    private async Task LoadBoundaryRateAsync()
    {
        _boundaryRateLoadFailed = false;
        try
        {
            _boundaryRate = await BoundaryRates.GetAsync();
        }
        catch (Exception)
        {
            _boundaryRate = null;
            _boundaryRateLoadFailed = true;
            _boundaryRateSaved = false;
            _boundaryRateMessage = "Couldn't load the boundary rate. Close Settings and try again.";
        }
    }

    private void ReviewBoundaryRate()
    {
        _boundaryRateSaved = false;
        decimal? typed = decimal.TryParse(_newBoundaryRate.Trim(), NumberStyles.AllowDecimalPoint | NumberStyles.AllowThousands,
            CultureInfo.InvariantCulture, out decimal value) ? value : null;
        _boundaryRateMessage = BoundaryRateService.Validate(typed)
            ?? (typed == _boundaryRate ? $"The boundary rate is already ₱{typed:N0}." : null);
        _pendingBoundaryRate = _boundaryRateMessage is null ? typed : null;
    }

    private async Task SaveBoundaryRateAsync()
    {
        if (_isSavingBoundaryRate || _pendingBoundaryRate is not decimal rate) return;
        _isSavingBoundaryRate = true;
        _boundaryRateMessage = null;
        try
        {
            string? error = await BoundaryRates.SetAsync(rate, await CurrentUserIdAsync());
            if (error is null)
            {
                _newBoundaryRate = string.Empty;
                await LoadBoundaryRateAsync();
            }
            _boundaryRateSaved = error is null;
            _boundaryRateMessage = error ?? $"Saved. Shifts that start from now on are charged ₱{rate:N0}.";
        }
        catch (Exception)
        {
            _boundaryRateSaved = false;
            _boundaryRateMessage = "Couldn't save the boundary rate. Please try again.";
        }
        finally
        {
            _pendingBoundaryRate = null;
            _isSavingBoundaryRate = false;
        }
    }

    private string? _duressPin;
    private string _newDuressPin = string.Empty;
    private string? _duressPinMessage;
    private bool _duressPinSaved;
    private bool _isSavingDuressPin;

    private async Task LoadDuressPinAsync()
    {
        try
        {
            _duressPin = await DuressPins.GetAsync();
        }
        catch (Exception)
        {
            _duressPin = string.Empty;
            _duressPinSaved = false;
            _duressPinMessage = "Couldn't load the emergency PIN. Please try again.";
        }
    }

    private async Task SaveDuressPinAsync()
    {
        if (_isSavingDuressPin) return; // a second click while this is still running is ignored
        _isSavingDuressPin = true;
        _duressPinMessage = null;
        try
        {
            string? error = await DuressPins.SetAsync(_newDuressPin, await CurrentUserIdAsync());
            _duressPinSaved = error is null;
            _duressPinMessage = error ?? "Emergency PIN saved. Drivers' phones pick it up the next time they open the Active Shift screen.";
            if (error is null)
            {
                _newDuressPin = string.Empty;
                await LoadDuressPinAsync();
            }
        }
        catch (Exception)
        {
            _duressPinSaved = false;
            _duressPinMessage = "Couldn't save the emergency PIN. Please try again.";
        }
        finally
        {
            _isSavingDuressPin = false;
        }
    }

    private async Task LoadPayoutAccountsAsync()
    {
        try
        {
            _payoutAccounts = await PayoutAccounts.GetAsync();
        }
        catch (Exception)
        {
            _payoutAccounts = new List<string>();
            _payoutError = "Couldn't load the authorized accounts. Please try again.";
        }
    }

    private async Task<string> CurrentUserIdAsync() =>
        (await AuthStateProvider.GetAuthenticationStateAsync()).User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

    private async Task AddPayoutAccountAsync()
    {
        if (_isSavingPayout) return; // a second click while this is still running is ignored
        _isSavingPayout = true;
        _payoutError = null;
        try
        {
            _payoutError = await PayoutAccounts.AddAsync(_newPayoutAccount, await CurrentUserIdAsync());
            if (_payoutError is null)
            {
                _newPayoutAccount = string.Empty;
                await LoadPayoutAccountsAsync();
            }
        }
        catch (Exception)
        {
            _payoutError = "Couldn't save the account. Please try again.";
        }
        finally
        {
            _isSavingPayout = false;
        }
    }

    private async Task RemovePayoutAccountAsync(string account)
    {
        if (_isSavingPayout) return; // a second click while this is still running is ignored
        _isSavingPayout = true;
        _payoutError = null;
        try
        {
            await PayoutAccounts.RemoveAsync(account, await CurrentUserIdAsync());
            await LoadPayoutAccountsAsync();
        }
        catch (Exception)
        {
            _payoutError = "Couldn't remove the account. Please try again.";
        }
        finally
        {
            _isSavingPayout = false;
        }
    }

    private void CloseSettingsModal()
    {
        _isSettingsModalOpen = false;
        _contactModel = new();
        _passwordModel = new();
        _showCurrentPassword = _showNewPassword = _showConfirmPassword = false;
        _contactMessage = null;
        _contactSaved = false;
        _passwordError = null;
        _newPayoutAccount = string.Empty;
        _payoutError = null;
        _newDuressPin = string.Empty;
        _duressPinMessage = null;
        _boundaryRate = null;
        _newBoundaryRate = string.Empty;
        _pendingBoundaryRate = null;
        _boundaryRateMessage = null;
    }

    private async Task UpdateContactNumberAsync()
    {
        if (_isSavingContact) return; // a second click while this is still running is ignored
        _isSavingContact = true;
        _contactMessage = null;
        try
        {
            var (success, error) = await ManagerAuthService.UpdateContactNumberAsync(_contactModel);
            _contactSaved = success;
            _contactMessage = success ? "Contact number updated." : error;
            if (success)
            {
                _contactModel = new();
            }
        }
        finally
        {
            _isSavingContact = false;
        }
    }

    // The current password is checked by Firebase itself (sign-in), in the browser - see
    // largaFirebaseChangePassword. The email is the signed-in manager's, from the server session.
    private async Task UpdatePasswordAsync()
    {
        if (_isSavingPassword) return; // a second click while this is still running is ignored
        _isSavingPassword = true;
        _passwordError = null;
        try
        {
            AuthenticationState state = await AuthStateProvider.GetAuthenticationStateAsync();
            string? email = state.User.FindFirst(ClaimTypes.Email)?.Value;
            if (string.IsNullOrEmpty(email))
            {
                _passwordError = "Couldn't verify your account. Please sign out and back in, then try again.";
                return;
            }

            IJSObjectReference module = await GetFirebaseModuleAsync();
            JsonElement result = await module.InvokeAsync<JsonElement>(
                "largaFirebaseChangePassword", email, _passwordModel.CurrentPassword, _passwordModel.NewPassword);

            if (result.TryGetProperty("ok", out JsonElement ok) && ok.ValueKind == JsonValueKind.True)
            {
                await HandleLogoutAsync();
                return;
            }

            _passwordError = result.TryGetProperty("message", out JsonElement message) && message.ValueKind == JsonValueKind.String
                ? message.GetString()
                : "Could not update your password. Please try again.";
        }
        catch (JSException)
        {
            _passwordError = "Could not update your password. Please try again.";
        }
        finally
        {
            _isSavingPassword = false;
        }
    }

    private async Task<IJSObjectReference> GetFirebaseModuleAsync() =>
        _firebaseModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/firebase-auth.js");

    // Ends both sessions: the browser's Firebase sign-in, then the server cookie. First this
    // browser stops getting this user's pushes: the service worker forgets who's signed in, the
    // FCM token is deleted, and it's removed from the account.
    private async Task HandleLogoutAsync()
    {
        try
        {
            IJSObjectReference push = await JS.InvokeAsync<IJSObjectReference>("import", "/web-push.js");
            string? token = await push.InvokeAsync<string?>("largaWebPushDisable");
            if (!string.IsNullOrWhiteSpace(token))
            {
                await PushTokens.RemoveAsync(await CurrentUserIdAsync(), token);
            }
        }
        catch (Exception)
        {
            // Not set up in this browser, or offline - a token left behind is dropped once FCM rejects it.
        }

        try
        {
            IJSObjectReference module = await GetFirebaseModuleAsync();
            await module.InvokeAsync<bool>("largaFirebaseSignOut");
        }
        catch (JSException)
        {
            // The server sign-out below still ends the portal session.
        }

        Navigation.NavigateTo("/auth/signout", forceLoad: true);
    }
}
