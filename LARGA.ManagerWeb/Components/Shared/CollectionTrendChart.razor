@using LARGA.SharedCore.Models.Dashboard

@* LAR-84: boundary collections per day - one stacked bar per day, collected (blue) on the
   bottom and still-outstanding (red) on top, so the bar's full height is what was due. *@

@if (Days is null || Days.Count == 0 || Days.All(d => d.Expected <= 0))
{
    <div class="chart-empty">@EmptyMessage</div>
}
else
{
    decimal max = Days.Max(d => Math.Max(d.Expected, d.Collected + d.Outstanding));

    <div class="bar-chart collection-chart">
        @foreach (CollectionDay day in Days)
        {
            double collectedPercent = Percent(day.Collected, max);
            double outstandingPercent = Percent(day.Outstanding, max);
            string title = $"{day.Date:ddd, MMM d}: due ₱{day.Expected:#,##0} · collected ₱{day.Collected:#,##0} · outstanding ₱{day.Outstanding:#,##0} · {day.Shifts} shift(s)";

            <div class="bar-chart-column" title="@title">
                <div class="bar-chart-value">@(day.Expected <= 0 ? "–" : $"₱{day.Collected:#,##0}")</div>
                <div class="bar-chart-track collection-track">
                    <div class="collection-outstanding" style="height: @Css(outstandingPercent)%"></div>
                    <div class="bar-chart-fill collection-collected" style="height: @Css(collectedPercent)%"></div>
                </div>
                <div class="bar-chart-label">@day.Date.ToString("ddd d")</div>
            </div>
        }
    </div>
}

@code {
    /// <summary>One entry per day, oldest first.</summary>
    [Parameter]
    public List<CollectionDay>? Days { get; set; }

    [Parameter]
    public string EmptyMessage { get; set; } = "No boundaries due in this period";

    private static double Percent(decimal value, decimal max) => max <= 0 || value <= 0 ? 0 : (double)(value / max) * 100;

    private static string Css(double percent) => percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
