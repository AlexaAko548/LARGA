    /// <summary>Normally a click toggles working/day off. When the driver's own unit is in
    /// the shop that day, it opens the substitute window instead - the manager's choice
    /// there includes marking the day off.</summary>
    private async Task OnScheduleCellClickedAsync(DriverScheduleRow row, ScheduleDayCell cell)
    {
        if (cell.IsOwnUnitUnderMaintenance && !cell.IsDayOff)
        {
            OpenSubstituteModal(row, cell);
