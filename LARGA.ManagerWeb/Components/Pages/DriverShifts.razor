    // -- LTO license scan ---------------------------------------------------
    // The manager uploads a photo of the driver's license; the browser OCRs it (ocr.js) and
    // LtoLicenseParser checks it's a Philippine LTO license, the holder is 18+, and it isn't
    // expired/expiring. Only a license passing all three fills in the fields below and gets
    // its photo attached on Save - anything else shows red text per failed check.

    private const long MaxLicensePhotoBytes = 10 * 1024 * 1024;

    private InputFile? _licenseInput;
    private IJSObjectReference? _ocrModule;
    private bool _isReadingLicense;
    private string? _licenseScanError;
    private string? _licensePreviewUrl;
    private LtoLicenseParser.Result? _licenseScan;
    private LtoLicenseParser.Validation? _licenseValidation;

    // Held until Save Changes, and only when the scanned license was valid.
    private byte[]? _pendingLicensePhoto;
    private string _pendingLicensePhotoType = "image/jpeg";

    private async Task OnLicenseSelectedAsync(InputFileChangeEventArgs e)
    {
        ResetLicenseScan();
        _isReadingLicense = true;
        StateHasChanged();

        try
        {
            if (e.File.Size > MaxLicensePhotoBytes)
            {
                _licenseScanError = "That photo is over 10 MB - use a smaller one.";
                return;
            }

            using var buffer = new MemoryStream();
            await e.File.OpenReadStream(MaxLicensePhotoBytes).CopyToAsync(buffer);
            byte[] photo = buffer.ToArray();

            _ocrModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/ocr.js");
            // First scan downloads the OCR engine, so allow well past the 60s default.
            OcrImageResult? ocr = await _ocrModule.InvokeAsync<OcrImageResult?>(
                "readImage", TimeSpan.FromMinutes(3), _licenseInput!.Element);
            if (ocr is null)
            {
                return;
            }

            _licensePreviewUrl = ocr.PreviewUrl;
            _licenseScan = LtoLicenseParser.ParseBest(ocr.Texts);
            _licenseValidation = LtoLicenseParser.Validate(_licenseScan, PhilippineTime.Now, _selectedProfile?.FullName);

            if (_licenseValidation.IsValid)
            {
                _editLicenseNumber = _licenseScan.LicenseNumber ?? _editLicenseNumber;
                _editLicenseClass = _licenseScan.Classification ?? _editLicenseClass;
                _editLicenseExpiry = _licenseScan.ExpiryDate;
                _pendingLicensePhoto = photo;
                _pendingLicensePhotoType = string.IsNullOrEmpty(e.File.ContentType) ? "image/jpeg" : e.File.ContentType;
            }
        }
        catch (Exception ex)
        {
            _licenseScanError = $"Couldn't read this photo: {ex.Message}";
        }
        finally
        {
            _isReadingLicense = false;
        }
    }

    private void ResetLicenseScan()
    {
        if (_licensePreviewUrl is not null && _ocrModule is not null)
        {
            _ = _ocrModule.InvokeVoidAsync("releasePreview", _licensePreviewUrl).AsTask();
        }

        _licensePreviewUrl = null;
        _licenseScan = null;
        _licenseValidation = null;
        _licenseScanError = null;
        _pendingLicensePhoto = null;
    }

    private static string LicenseDocumentLabel(LtoLicenseParser.Result scan) =>
        !scan.IsPhilippineLicense ? "Not recognised"
        : scan.Classification is null ? "PH LTO Driver's License"
        : $"PH LTO {scan.Classification} License";

    private sealed class OcrImageResult
    {
        public List<string> Texts { get; set; } = new();
        public string PreviewUrl { get; set; } = string.Empty;
    }

    private async Task SaveProfileAsync()
    {
        if (_selectedProfile is null)
        {
            return;
        }

        if (EditFormError is string formError)
        {
            _profileError = formError;
            return;
        }

        _isSavingProfile = true;
        _profileError = null;

        try
        {
            // Login email first: it's the step most likely to be refused (bad format, or the
            // address belongs to another account), and nothing else should be saved if it is.
            if (!string.Equals(_editEmail.Trim(), _selectedProfile.Email, StringComparison.OrdinalIgnoreCase))
            {
                ResetPasswordResult emailResult = await DriverManagement.UpdateDriverLoginEmailAsync(_selectedProfile.DriverId, _editEmail);
                if (!emailResult.Ok)
                {
                    _profileError = emailResult.ErrorMessage;
                    return;
                }
            }

            string? ltoIdPhotoUrl = _pendingLicensePhoto is null
                ? null
                : await DriverManagement.UploadLtoIdPhotoAsync(_selectedProfile.DriverId, _pendingLicensePhoto, _pendingLicensePhotoType);

            await DriverManagement.UpdateDriverProfileAsync(
                _selectedProfile.DriverId,
                _editPhone, _editAddress,
                _editLicenseNumber, _editLicenseClass, _editLicenseRestriction,
                _editLicenseExpiry,
                _editAssignedTaxi,
                ltoIdPhotoUrl);

            ResetLicenseScan();
            _isEditingProfile = false;
            _selectedProfile = await DriverManagement.GetDriverProfileAsync(_selectedProfile.DriverId);
            await LoadRosterAsync();
            // A renewed license (or a changed unit) changes which planner cells are locked -
            // reload so they go back to the driver's assigned unit right away.
            await ReloadDisplayedWeekAsync();
        }
        catch (Exception ex)
        {
            _profileError = ex.Message;
        }
        finally
        {
            _isSavingProfile = false;
        }
    }

