        await ToggleDayOffAsync(row.DriverId, cell.Date, cell.IsDayOff);
    }

    private static string? ScheduleCellTooltip(DriverScheduleRow row, ScheduleDayCell cell)
    {
        if (cell.IsLicenseIneligible)
        {
            return row.LicenseStatus == LicenseStatus.NotSet
                ? "License not set yet - add the driver's license in their profile to schedule them"
                : "License expired or expiring within a month of this date - cannot be scheduled";
        }
        if (cell.IsOwnUnitUnderMaintenance && !cell.IsDayOff)
        {
            return cell.SubstituteTaxiId is not null
                ? $"{row.DefaultTaxiId} is under maintenance ({cell.MaintenanceNote}) - driving {cell.SubstituteTaxiId} instead. Click to change."
                : $"{row.DefaultTaxiId} is under maintenance ({cell.MaintenanceNote}). Click to assign a substitute.";
        }
        return null;
    }

