    private void OpenSubstituteModal(DriverScheduleRow row, ScheduleDayCell cell)
    {
        _subRow = row;
        _subCell = cell;
        _subError = null;

        // Free units that day, plus the substitute already assigned (it counts as "in use"
        // by this same driver, so it isn't in the free list).
        int dayIndex = (cell.Date.Date - _weekSchedule!.WeekStart.Date).Days;
        _subChoices = _weekSchedule.FreeTaxiIdsByDay[dayIndex].ToList();
        if (cell.SubstituteTaxiId is not null && !_subChoices.Contains(cell.SubstituteTaxiId))
        {
            _subChoices.Insert(0, cell.SubstituteTaxiId);
        }

        _subSelected = cell.SubstituteTaxiId ?? _subChoices.FirstOrDefault() ?? string.Empty;
        _showSubstituteModal = true;
    }

    private void CloseSubstituteModal() => _showSubstituteModal = false;

    private async Task RunSubstituteActionAsync(Func<Task> action)
    {
        _isSavingSub = true;
        _subError = null;
        try
        {
            await action();
            _showSubstituteModal = false;
            await ReloadCurrentWeekAsync();
        }
        catch (Exception ex)
        {
            _subError = ex.Message;
        }
        finally
        {
            _isSavingSub = false;
        }
    }

    private Task AssignSubstituteAsync() => RunSubstituteActionAsync(() =>
        string.IsNullOrEmpty(_subSelected)
            ? throw new InvalidOperationException("Pick a unit first.")
            : DriverManagement.AssignSubstituteAsync(_subRow!.DriverId, _subCell!.Date, _subSelected));

    private Task RemoveSubstituteAsync() => RunSubstituteActionAsync(() =>
        DriverManagement.ClearScheduleAsync(_subRow!.DriverId, _subCell!.Date));

    private Task SubstituteDayOffAsync() => RunSubstituteActionAsync(() =>
        DriverManagement.MarkDayOffAsync(_subRow!.DriverId, _subCell!.Date));

