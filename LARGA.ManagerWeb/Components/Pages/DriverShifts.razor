    private static string Initials(string fullName)
    {
        string[] parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return "?";
        }
        if (parts.Length == 1)
        {
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        }
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private static string ShortId(string id) => "#" + (id.Length <= 6 ? id : id[..6]).ToUpperInvariant();

    private static string PercentText(double? percent) => percent is double p ? $"{p:0}%" : "—";

    private static string MeterText(double? percent) =>
        Math.Clamp(percent ?? 0, 0, 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture);

    private static string LicenseStatusLabel(LicenseStatus status) => status == LicenseStatus.NotSet ? "NOT SET" : status.ToString().ToUpperInvariant();

    private static string LicenseStatusCss(LicenseStatus status) => status switch
    {
        LicenseStatus.Valid => "status-success",
        LicenseStatus.Expiring => "status-warning",
        LicenseStatus.Expired => "status-danger",
        _ => "status-neutral",
    };

    private static string ShiftStatusCss(string status) => status switch
    {
        "Active" => "status-success",
        "Denied" => "status-danger",
        "Overdue" => "status-warning",
        "On Break" => "status-warning",
        "Late Return" => "status-danger",
        "Auto-Closed" => "status-danger",
        _ => "status-neutral",
    };

    private static string FormatLogDate(DateTime? dt)
    {
        if (dt is null)
        {
            return "—";
        }

        DateTime value = dt.Value.ToPhilippineTime();
        DateTime today = PhilippineTime.Now.Date;
        string day = value.Date == today ? "Today" : value.Date == today.AddDays(-1) ? "Yesterday" : value.ToString("MMM d");
        return $"{day}, {value:h:mm tt}";
    }

    private static bool IsToday(DateTime day) => day.Date == DateTime.UtcNow.Date;

    private string WeekLabel()
    {
        if (_weekSchedule is null)
        {
            return string.Empty;
        }

        DateTime start = _weekSchedule.WeekStart;
        DateTime end = start.AddDays(6);
        return start.Month == end.Month
            ? $"{start:MMM d} - {end:d}, {end:yyyy}"
            : $"{start:MMM d} - {end:MMM d}, {end:yyyy}";
    }
