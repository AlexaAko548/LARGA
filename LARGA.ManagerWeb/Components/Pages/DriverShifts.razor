    private async Task LoadShiftLogsAsync()
    {
        try
        {
            DateTime now = DateTime.UtcNow;
            DateTime from;
            DateTime to;

            if (_logDateFilter == "Today")
            {
                // The Philippine calendar day, not the UTC one - same reasoning as
                // FinancialLedgerService.GetDailySettlementAsync.
                from = now.ToPhilippineTime().Date - PhilippineTime.Offset;
                to = from.AddDays(1).AddTicks(-1);
            }
            else if (_logDateFilter == "Custom" && _logCustomFrom.HasValue && _logCustomTo.HasValue)
            {
                from = DateTime.SpecifyKind(_logCustomFrom.Value.Date, DateTimeKind.Utc);
                to = DateTime.SpecifyKind(_logCustomTo.Value.Date, DateTimeKind.Utc).AddDays(1).AddTicks(-1);
            }
            else
            {
                // "All Dates" is bounded to the last 30 days rather than truly unbounded -
                // same read-cost reasoning as FleetReportingService: shifts grow ~1/taxi/day
                // forever, so fetching the entire history on every visit to this tab would
                // get expensive as the fleet accumulates real operating history.
                from = now.AddDays(-30);
                to = now;
            }

            _shiftLogs = await DriverManagement.GetShiftLogsAsync(from, to);
            _shiftLogsLoaded = true;
            _shiftLogsError = null;
        }
        catch (Exception ex)
        {
            _shiftLogsError = ex.Message;
        }
    }

