@page "/driver-shifts"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using System.Text.Json
@using LARGA.SharedCore
@using LARGA.SharedCore.Models.DriverShifts
@using LARGA.SharedCore.Services
@rendermode InteractiveServer
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject DriverManagementService DriverManagement
@inject ClockInApprovalService ClockInApprovals
@implements IDisposable

<PageTitle>Driver & Shift Management</PageTitle>

@if (_isLoading)
{
    <div class="auth-page">
        <div class="auth-card">
            <h2>Loading...</h2>
        </div>
    </div>
}
else
{
<div class="dashboard-shell">
    <DashboardSidebar ActiveItem="DriverShifts" />

    <main class="dashboard-main">
        <header class="dashboard-header">
            <div class="header-title-wrap">
                <h1>DRIVER &amp; SHIFT MANAGEMENT</h1>
                <div class="header-date">Roster, dispatch, and personnel</div>
            </div>

            <div class="header-actions">
                <NotificationBell />
                <MessagesButton />
                <ManagerProfileMenu />
            </div>
        </header>

        @if (_rosterError is not null)
        {
            <div class="data-warning-banner">Driver data unavailable: @_rosterError</div>
        }

        @if (_clockInRequests.Count > 0)
        {
            <section class="clockin-approvals">
                <div class="clockin-approvals-header">
                    <h2>Clock-in approvals</h2>
                    <span class="status-pill small status-warning">@_clockInRequests.Count waiting</span>
                </div>
                <p class="clockin-approvals-hint">These drivers' pre-shift inspections flagged an issue, so their shift hasn't started. Review the photos and reports, then approve (the shift starts on their phone) or deny (the concern goes to the Garage).</p>

                @foreach (ClockInApprovalItem request in _clockInRequests)
                {
                    ClockInApprovalItem item = request;
                    <article class="clockin-request">
                        <div class="clockin-request-main">
                            <div class="clockin-request-title">
                                <div class="table-avatar">@Initials(item.DriverName)</div>
                                <div>
                                    <strong>@item.DriverName</strong> · @item.TaxiId
                                    <div class="clockin-request-time">Sent @item.CreatedAt.ToPhilippineTime().ToString("h:mm tt") · odometer @item.StartMileage.ToString("N0") km</div>
                                </div>
                            </div>

                            <ul class="clockin-request-reasons">
                                @foreach (string reason in item.FlagReasons)
                                {
                                    <li>@reason</li>
                                }
                            </ul>

                            @foreach (ClockInDefect defect in item.Defects)
                            {
                                <div class="clockin-defect">
                                    <strong>@defect.Title</strong> <span class="status-pill small status-neutral">@defect.Priority</span>
                                    @if (!string.IsNullOrWhiteSpace(defect.Description))
                                    {
                                        <div>@defect.Description</div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="clockin-request-photos">
                            @foreach ((string? url, string label) in new[] { (item.FuelPhotoUrl, "Fuel"), (item.OdometerPhotoUrl, "Odometer") }
                                .Concat(item.Defects.Select(d => (d.PhotoUrl, d.Title))))
                            {
                                @if (url is not null)
                                {
                                    <a href="@url" target="_blank" rel="noopener" title="@label">
                                        <img src="@url" alt="@label" loading="lazy" />
                                        <span>@label</span>
                                    </a>
                                }
                            }
                        </div>

                        <div class="clockin-request-actions">
                            @if (item.BlockedReason is not null)
                            {
                                <div class="field-error">Can't be approved: @item.BlockedReason.</div>
                            }
                            <button class="solid-btn" type="button" disabled="@(_isDecidingClockIn || item.BlockedReason is not null)" title="@(item.BlockedReason is null ? null : $"Can't be approved: {item.BlockedReason}")" @onclick="() => ApproveClockInAsync(item)">✓ Approve</button>
                            <button class="outline-btn danger" type="button" disabled="@_isDecidingClockIn" @onclick="() => OpenDenyClockIn(item)">✕ Deny</button>
                        </div>
                    </article>
                }

                @if (_clockInError is not null)
                {
                    <div class="report-error">@_clockInError</div>
                }
            </section>
        }

        <section class="stats-grid">
            <article class="stat-card">
                <div class="stat-icon">☺</div>
                <div class="stat-body">
                    <div class="stat-value">@(_roster?.TotalDrivers ?? 0)</div>
                    <div class="stat-label">Total Drivers</div>
                </div>
            </article>
            <article class="stat-card">
                <div class="stat-icon">◇</div>
                <div class="stat-body">
                    <div class="stat-value">@(_roster?.OnShiftCount ?? 0)</div>
                    <div class="stat-label">On Shift</div>
                </div>
            </article>
            <article class="stat-card">
                <div class="stat-icon">▭</div>
                <div class="stat-body">
                    <div class="stat-value">@(_roster?.OffDutyCount ?? 0)</div>
                    <div class="stat-label">Off Duty</div>
                </div>
            </article>
            <article class="stat-card">
                <div class="stat-icon">△</div>
                <div class="stat-body">
                    <div class="stat-value">@(_roster?.ExpiredLicenseCount ?? 0)</div>
                    <div class="stat-label">Expired License</div>
                </div>
            </article>
        </section>

        <section class="tab-bar">
            <div class="tab-group">
                <button class="tab-btn @(_activeTab == "roster" ? "active" : "")" type="button" @onclick='() => SelectTabAsync("roster")'>⌇ Live Roster</button>
                <button class="tab-btn @(_activeTab == "schedule" ? "active" : "")" type="button" @onclick='() => SelectTabAsync("schedule")'>▤ Schedule Planner</button>
                <button class="tab-btn @(_activeTab == "logs" ? "active" : "")" type="button" @onclick='() => SelectTabAsync("logs")'>▥ Shift Logs</button>
            </div>
            <div class="tab-actions">
                <button class="solid-btn" type="button" @onclick="OpenManagerNoteModal">+ Add Manager Note</button>
                <button class="solid-btn" type="button" @onclick="OpenAddDriverModal">+ Add New Driver</button>
            </div>
        </section>

        @if (_activeTab == "roster")
        {
            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Driver</th>
                            <th>Driver ID</th>
                            <th>License Status</th>
                            <th>Current Status</th>
                            <th>Assigned Unit</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_roster is null)
                        {
                            <tr><td colspan="6" class="table-empty">Loading roster...</td></tr>
                        }
                        else if (_roster.Drivers.Count == 0)
                        {
                            <tr><td colspan="6" class="table-empty">No drivers yet - use "Add New Driver" to create one.</td></tr>
                        }
                        else
                        {
                            @foreach (DriverRosterEntry d in _roster.Drivers)
                            {
                                <tr>
                                    <td class="driver-cell">
                                        <div class="table-avatar">@Initials(d.FullName)</div>
                                        <span>@d.FullName</span>
                                        @if (d.IsDebtFlagged)
                                        {
                                            <span class="status-pill small status-danger" title="Balance unpaid for 3+ days - see the Financial Ledger">⚑ DEBT</span>
                                        }
                                    </td>
                                    <td>@ShortId(d.DriverId)</td>
                                    <td><span class="status-pill @LicenseStatusCss(d.LicenseStatus)"><span class="dot"></span> @LicenseStatusLabel(d.LicenseStatus)</span></td>
                                    <td><span class="status-pill @RosterStatusCss(d)"><span class="dot"></span> @RosterStatusLabel(d)</span></td>
                                    <td>
                                        @(d.AssignedTaxiId ?? "—")
                                        @if (d.IsOnShift && DrivingOtherUnit(d.AssignedTaxiId, d.CurrentShiftTaxiId))
                                        {
                                            <div class="unit-note">On shift in @d.CurrentShiftTaxiId</div>
                                        }
                                    </td>
                                    <td><button class="profile-btn" type="button" @onclick="() => OpenProfileAsync(d.DriverId)">Profile</button></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (_activeTab == "schedule")
        {
            <div class="schedule-panel">
                @if (_scheduleError is not null)
                {
                    <div class="data-warning-banner">Schedule data unavailable: @_scheduleError</div>
                }
                <div class="schedule-toolbar">
                    <div class="schedule-week-label">
                        <button class="week-nav" type="button" @onclick="() => ChangeWeekAsync(-1)">◀</button>
                        <span>WEEK OF @WeekLabel()</span>
                        <button class="week-nav" type="button" @onclick="() => ChangeWeekAsync(1)">▶</button>
                    </div>
                    <div class="schedule-hint">Every day defaults to working - click a cell to toggle it to a day off</div>
                </div>

                @if (_weekSchedule is null)
                {
                    <div class="table-empty">Loading schedule...</div>
                }
                else
                {
                    <div class="data-table-wrap">
                        <table class="data-table schedule-table">
                            <thead>
                                <tr>
                                    <th>Driver</th>
                                    @for (int i = 0; i < 7; i++)
                                    {
                                        DateTime day = _weekSchedule.WeekStart.AddDays(i);
                                        int active = _weekSchedule.UnitsActiveByDay[i];
                                        <th class="@(IsToday(day) ? "schedule-today" : "")">
                                            @day.ToString("ddd").ToUpperInvariant() @day.ToString("d/M")
                                            <div class="schedule-day-count">@active/@_weekSchedule.TotalTaxis</div>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (DriverScheduleRow row in _weekSchedule.Rows)
                                {
                                    <tr>
                                        <td class="driver-cell">
                                            <div class="table-avatar">@Initials(row.FullName)</div>
                                            <div>
                                                <div>@row.FullName</div>
                                                <span class="status-pill small @LicenseStatusCss(row.LicenseStatus)">@LicenseStatusLabel(row.LicenseStatus)</span>
                                            </div>
                                        </td>
                                        @for (int i = 0; i < row.Days.Count; i++)
                                        {
                                            ScheduleDayCell cell = row.Days[i];
                                            DriverScheduleRow cellRow = row;
                                            <td class="schedule-cell-wrap @(IsToday(cell.Date) ? "schedule-today" : "")">
                                                <button class="schedule-cell @ScheduleCellCss(cell)" type="button"
                                                        disabled="@cell.IsLicenseIneligible"
                                                        title="@ScheduleCellTooltip(cellRow, cell)"
                                                        @onclick="() => OnScheduleCellClickedAsync(cellRow, cell)">
                                                    @if (cell.IsLicenseIneligible && cellRow.LicenseStatus == LicenseStatus.NotSet)
                                                    {
                                                        <span>🚫 NO LICENSE</span>
                                                    }
                                                    else if (cell.IsLicenseIneligible)
                                                    {
                                                        <span>🚫 INELIGIBLE</span>
                                                    }
                                                    else if (cell.IsDayOff)
                                                    {
                                                        <span>✕ DAY OFF</span>
                                                    }
                                                    else if (cell.SubstituteTaxiId is not null)
                                                    {
                                                        <span>↺ @cell.SubstituteTaxiId</span>
                                                    }
                                                    else if (cell.IsOwnUnitUnderMaintenance)
                                                    {
                                                        <span>🔧 @cellRow.DefaultTaxiId IN SHOP</span>
                                                    }
                                                    else if (cell.TaxiId is null)
                                                    {
                                                        <span>⚠ NO UNIT</span>
                                                    }
                                                    else
                                                    {
                                                        <span>✓ @cell.TaxiId</span>
                                                    }
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td>UNITS ACTIVE</td>
                                    @for (int i = 0; i < 7; i++)
                                    {
                                        DateTime footerDay = _weekSchedule.WeekStart.AddDays(i);
                                        <td class="@(IsToday(footerDay) ? "schedule-today" : "")">@_weekSchedule.UnitsActiveByDay[i]</td>
                                    }
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        }
        else if (_activeTab == "logs")
        {
            <div class="logs-panel">
                @if (_shiftLogsError is not null)
                {
                    <div class="data-warning-banner">Shift log data unavailable: @_shiftLogsError</div>
                }

                <div class="logs-filters">
                    <div class="filter-dropdown">
                        <button class="filter-btn" type="button" @onclick="() => _showDateFilterMenu = !_showDateFilterMenu">📅 @_logDateFilter</button>
                        @if (_showDateFilterMenu)
                        {
                            <div class="filter-menu">
                                <button type="button" @onclick='() => SetDateFilterAsync("All Dates")'>All Dates</button>
                                <button type="button" @onclick='() => SetDateFilterAsync("Today")'>Today</button>
                                <button type="button" @onclick='() => SetDateFilterAsync("Custom")'>Custom</button>
                            </div>
                        }
                    </div>

                    <div class="filter-dropdown">
                        <button class="filter-btn" type="button" @onclick="() => _showDriverFilterMenu = !_showDriverFilterMenu">☺ @_logDriverFilter</button>
                        @if (_showDriverFilterMenu)
                        {
                            <div class="filter-menu">
                                <button type="button" @onclick='() => SetDriverFilter("All Drivers")'>All Drivers</button>
                                @foreach (string name in DistinctDrivers)
                                {
                                    <button type="button" @onclick="() => SetDriverFilter(name)">@name</button>
                                }
                            </div>
                        }
                    </div>

                    <div class="filter-dropdown">
                        <button class="filter-btn" type="button" @onclick="() => _showUnitFilterMenu = !_showUnitFilterMenu">◌ @_logUnitFilter</button>
                        @if (_showUnitFilterMenu)
                        {
                            <div class="filter-menu">
                                <button type="button" @onclick='() => SetUnitFilter("All Units")'>All Units</button>
                                @foreach (string unit in DistinctUnits)
                                {
                                    <button type="button" @onclick="() => SetUnitFilter(unit)">@unit</button>
                                }
                            </div>
                        }
                    </div>

                    <div class="filter-dropdown">
                        <button class="filter-btn" type="button" @onclick="() => _showStatusFilterMenu = !_showStatusFilterMenu">◇ @_logStatusFilter</button>
                        @if (_showStatusFilterMenu)
                        {
                            <div class="filter-menu">
                                <button type="button" @onclick='() => SetStatusFilter("All Statuses")'>All Statuses</button>
                                @foreach (string status in DistinctStatuses)
                                {
                                    <button type="button" @onclick="() => SetStatusFilter(status)">@status</button>
                                }
                            </div>
                        }
                    </div>

                    <div class="logs-count">@FilteredLogs.Count() records</div>
                </div>

                @if (_logDateFilter == "Custom")
                {
                    <div class="date-range custom-log-range">
                        <div class="date-field"><span>From</span><input type="date" @bind="_logCustomFrom" @bind:after="LoadShiftLogsAsync" /></div>
                        <div class="date-field"><span>To</span><input type="date" @bind="_logCustomTo" @bind:after="LoadShiftLogsAsync" /></div>
                    </div>
                }

                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Date &amp; Time</th>
                                <th>Driver</th>
                                <th>Unit</th>
                                <th>Shift Status</th>
                                <th>Inspection Logs</th>
                                <th>Reports</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_shiftLogs is null)
                            {
                                <tr><td colspan="6" class="table-empty">Loading shift logs...</td></tr>
                            }
                            else if (!FilteredLogs.Any())
                            {
                                <tr><td colspan="6" class="table-empty">No shifts match these filters.</td></tr>
                            }
                            else
                            {
                                @foreach (ShiftLogEntry log in FilteredLogs)
                                {
                                    <tr>
                                        <td>@FormatLogDate(log.ShiftStart)</td>
                                        <td class="driver-cell"><div class="table-avatar">@Initials(log.DriverName)</div><span>@log.DriverName</span></td>
                                        <td>@log.TaxiId</td>
                                        <td><span class="status-pill @ShiftStatusCss(log.Status)"><span class="dot"></span> @log.Status</span></td>
                                        <td>
                                            @if (log.HasPreShiftChecklist || log.HasEndShiftChecklist)
                                            {
                                                <button class="checklist-link" type="button" @onclick="() => OpenChecklistAsync(log.ShiftId)">
                                                    @(log.HasPreShiftChecklist && log.HasEndShiftChecklist ? "Pre & Post Checklists" : log.HasPreShiftChecklist ? "Pre-Shift Checklist" : "Post-Shift Checklist")
                                                </button>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (log.DefectCount > 0)
                                            {
                                                <span class="status-pill status-danger"><span class="dot"></span> @log.DefectCount Defect@(log.DefectCount > 1 ? "s" : "")</span>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </main>
</div>

@if (_denyClockIn is not null)
{
    <div class="report-overlay" @onclick="CloseDenyClockIn">
        <div class="report-modal" @onclick:stopPropagation="true">
            <div class="report-header">
                <h3>Deny clock-in</h3>
                <button type="button" class="close-modal" @onclick="CloseDenyClockIn">×</button>
            </div>
            <div class="report-body">
                <div class="settlement-modal-subject">@_denyClockIn.DriverName · @_denyClockIn.TaxiId</div>
                <div class="report-section">
                    <label>Note to the driver (required)</label>
                    <textarea class="text-input textarea" maxlength="500" @bind="_denyNote" @bind:event="oninput" placeholder="e.g. Front tire is worn - the unit stays in the garage until it's replaced."></textarea>
                </div>
                <label class="checkbox-row">
                    <input type="checkbox" @bind="_denyMarkUnderMaintenance" />
                    Mark @_denyClockIn.TaxiId as Under Maintenance (the Shift Scheduler then offers a substitute unit)
                </label>
                <div class="info-banner">
                    @if (_denyClockIn.Defects.Count > 0)
                    {
                        @:The driver's defect report(s) are already in the Garage queue - they'll be raised to High priority.
                    }
                    else if (_denyClockIn.HasFailedItems)
                    {
                        @:A High-priority maintenance report will be created in the Garage for the failed inspection items.
                    }
                    else
                    {
                        @:Only the fuel level was flagged, so nothing is sent to the Garage.
                    }
                </div>
                @if (_clockInError is not null)
                {
                    <div class="report-error">@_clockInError</div>
                }
            </div>
            <div class="report-actions">
                <button class="cancel-btn" type="button" @onclick="CloseDenyClockIn">Cancel</button>
                <button class="download-btn" type="button" disabled="@(_isDecidingClockIn || string.IsNullOrWhiteSpace(_denyNote))" @onclick="ConfirmDenyClockInAsync">@(_isDecidingClockIn ? "Saving…" : "Deny Clock-in")</button>
            </div>
        </div>
    </div>
}

@if (_showChecklistModal && _selectedChecklists is not null)
{
    <div class="report-overlay" @onclick="CloseChecklistModal">
        <div class="report-modal wide checklist-modal" @onclick:stopPropagation="true">
            <div class="report-header">
                <div>
                    <h3>Inspection Checklist — @_selectedChecklists.TaxiId</h3>
                    <div class="checklist-subtitle">@_selectedChecklists.DriverName</div>
                </div>
                <button type="button" class="close-modal" @onclick="CloseChecklistModal">×</button>
            </div>

            <div class="report-body">
                @* Pre-Shift and Post-Shift are deliberately shown side by side rather than
                   merged/tab-switched, so a manager can compare the two directly. *@
                <div class="checklist-compare">
                    <ChecklistPanel Title="Pre-Shift" Detail="_selectedChecklists.PreShift" />
                    <ChecklistPanel Title="Post-Shift" Detail="_selectedChecklists.EndShift" />
                </div>

                @if (_selectedChecklists.PreviousChecklists.Count > 0 || _selectedChecklists.DamageHistory.Count > 0)
                {
                    <div class="checklist-history">
                        <div class="checklist-items-label">PREVIOUS INSPECTION &amp; DAMAGE HISTORY — @_selectedChecklists.TaxiId</div>
                        @if (_selectedChecklists.PreviousChecklists.Count > 0)
                        {
                            <div class="history-mini-list">
                                @foreach (ChecklistHistoryEntry h in _selectedChecklists.PreviousChecklists)
                                {
                                    <div class="history-mini-row">
                                        <span>@h.Timestamp.ToPhilippineTime().ToString("MMM d") · @h.ChecklistType</span>
                                        <span class="status-pill small @(h.AllPassed ? "status-success" : "status-warning")">@h.PassedCount/@h.TotalCheckableCount passed</span>
                                    </div>
                                }
                            </div>
                        }
                        @if (_selectedChecklists.DamageHistory.Count > 0)
                        {
                            <div class="history-mini-list">
                                @foreach (DamageHistoryEntry d in _selectedChecklists.DamageHistory)
                                {
                                    <div class="history-mini-row">
                                        <span>@d.DateLogged.ToPhilippineTime().ToString("MMM d") · @d.IssueTitle</span>
                                        <span class="status-pill small status-neutral">@d.Status.ToUpperInvariant()</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="report-actions checklist-footer">
                <span class="checklist-footer-note">Submitted by driver via LARGA Mobile App</span>
                <button class="download-btn" type="button" @onclick="CloseChecklistModal">Close</button>
            </div>
        </div>
    </div>
}

@if (_showSubstituteModal && _subRow is not null && _subCell is not null)
{
    <div class="report-overlay" @onclick="CloseSubstituteModal">
        <div class="report-modal" @onclick:stopPropagation="true">
            <div class="report-header">
                <h3>Assign Substitute Unit</h3>
                <button type="button" class="close-modal" @onclick="CloseSubstituteModal">×</button>
            </div>
            <div class="report-body">
                <div class="settlement-modal-subject">@_subRow.FullName · @_subCell.Date.ToString("dddd, MMM d")</div>

                <div class="info-banner">
                    🔧 <strong>@_subRow.DefaultTaxiId</strong> is under maintenance: @_subCell.MaintenanceNote.
                    A substitute applies to this day only - the driver goes back to @_subRow.DefaultTaxiId once the Garage finishes.
                </div>

                <div class="report-section">
                    <label>Substitute Unit</label>
                    @if (_subChoices.Count == 0)
                    {
                        <div class="field-error">No free units on this day - every other unit is under maintenance or already driven by someone.</div>
                    }
                    else
                    {
                        <select class="text-input" @bind="_subSelected">
                            @foreach (string taxiId in _subChoices)
                            {
                                <option value="@taxiId">@taxiId@(taxiId == _subCell.SubstituteTaxiId ? " (current)" : "")</option>
                            }
                        </select>
                        <small class="receipt-hint">Only units that are free this day are listed.</small>
                    }
                </div>

                @if (_subError is not null)
                {
                    <div class="report-error">@_subError</div>
                }
            </div>
            <div class="report-actions">
                <button class="cancel-btn" type="button" disabled="@_isSavingSub" @onclick="SubstituteDayOffAsync">Mark Day Off</button>
                @if (_subCell.SubstituteTaxiId is not null)
                {
                    <button class="cancel-btn" type="button" disabled="@_isSavingSub" @onclick="RemoveSubstituteAsync">Remove Substitute</button>
                }
                <button class="download-btn" type="button" disabled="@(_isSavingSub || _subChoices.Count == 0)" @onclick="AssignSubstituteAsync">
                    @(_isSavingSub ? "Saving…" : _subCell.SubstituteTaxiId is null ? "Assign" : "Change")
                </button>
            </div>
        </div>
    </div>
}

@if (_showAddDriverModal)
{
    <div class="report-overlay" @onclick="CloseAddDriverModal">
        <div class="report-modal" @onclick:stopPropagation="true">
            <div class="report-header">
                <h3>Register New Driver</h3>
                <button type="button" class="close-modal" @onclick="CloseAddDriverModal">×</button>
            </div>
            <div class="report-body">
                @if (_lastCreatedDriver is { Ok: true })
                {
                    <div class="info-banner success">
                        <p><strong>@_newDriverName</strong> was registered.</p>
                        <p>Assigned unit: <strong>@(string.IsNullOrEmpty(_newDriverTaxi) ? "None yet" : _newDriverTaxi)</strong></p>
                        <p>Login email: <code>@_lastCreatedDriver.GeneratedEmail</code></p>
                        <p>Temporary password: <code>@_lastCreatedDriver.TemporaryPassword</code></p>
                        <p>Share these with the driver directly - there is no self-registration, so this is the only place they are shown.</p>
                    </div>
                }
                else
                {
                    <div class="report-section">
                        <label>Full Name</label>
                        <input class="text-input @InvalidCss(ShowNew(_newDriverName), NewNameError)" maxlength="80" @bind="_newDriverName" @bind:event="oninput" placeholder="e.g. Mark Santos" />
                        <FieldError Show="ShowNew(_newDriverName)" Message="@NewNameError" />
                    </div>
                    <div class="report-section">
                        <label>Email <span class="field-optional">(optional)</span></label>
                        <input class="text-input @InvalidCss(ShowNew(_newDriverEmail), NewEmailError)" type="email" maxlength="254" @bind="_newDriverEmail" @bind:event="oninput" placeholder="e.g. mark.santos@gmail.com" autocomplete="off" />
                        <FieldError Show="ShowNew(_newDriverEmail)" Message="@NewEmailError" />
                        <small class="receipt-hint">The driver's own inbox, for Forgot Password. Leave blank to generate a login email.</small>
                    </div>
                    <div class="report-section">
                        <label>Contact Number</label>
                        <input class="text-input @InvalidCss(ShowNew(_newDriverPhone), NewPhoneError)" type="tel" inputmode="tel" maxlength="17" @bind="_newDriverPhone" @bind:event="oninput" placeholder="0917 123 4567" />
                        <FieldError Show="ShowNew(_newDriverPhone)" Message="@NewPhoneError" />
                        @if (NewPhoneError is null)
                        {
                            <small class="receipt-hint">Philippine mobile number - 09XX XXX XXXX or +63 9XX XXX XXXX. Saved as @InputValidator.FormatPhilippineMobile(_newDriverPhone).</small>
                        }
                    </div>
                    <div class="report-section">
                        <label>Assigned Unit</label>
                        <select class="text-input" @bind="_newDriverTaxi">
                            <option value="">Unassigned (set later)</option>
                            @foreach (string taxiId in _weekSchedule?.TaxiIds ?? new List<string>())
                            {
                                <option value="@taxiId">@TaxiOptionLabel(taxiId)</option>
                            }
                        </select>
                    </div>
                    <div class="report-section">
                        <label>Temporary Password</label>
                        <input class="text-input @InvalidCss(ShowNew(_newDriverPassword), NewPasswordError)" maxlength="64" @bind="_newDriverPassword" @bind:event="oninput" placeholder="Auto-generated or manual" autocomplete="off" />
                        <FieldError Show="ShowNew(_newDriverPassword)" Message="@NewPasswordError" />
                    </div>
                    <div class="info-banner">Leave password blank to auto-generate a secure temporary password.</div>
                    @if (_addDriverError is not null)
                    {
                        <div class="report-error">@_addDriverError</div>
                    }
                }
            </div>
            <div class="report-actions">
                @if (_lastCreatedDriver is { Ok: true })
                {
                    <button class="download-btn" type="button" @onclick="CloseAddDriverModal">Done</button>
                }
                else
                {
                    <button class="cancel-btn" type="button" @onclick="CloseAddDriverModal">Cancel</button>
                    <button class="download-btn" type="button" disabled="@_isCreatingDriver" @onclick="RegisterDriverAsync">@(_isCreatingDriver ? "Registering…" : "Register Driver")</button>
                }
            </div>
        </div>
    </div>
}

@if (_showManagerNoteModal)
