@if (_showProfilePanel && _selectedProfile is not null)
{
    <div class="profile-overlay" @onclick="CloseProfilePanel">
        <aside class="profile-panel" @onclick:stopPropagation="true">
            <div class="profile-panel-header">
                <h3>Driver Profile</h3>
                <button type="button" class="close-modal" @onclick="CloseProfilePanel">×</button>
            </div>

            <div class="profile-hero">
                <div class="table-avatar large">@Initials(_selectedProfile.FullName)</div>
                <div>
                    <div class="profile-name">@_selectedProfile.FullName</div>
                    <div class="profile-meta">@(_selectedProfile.DateJoined is { } joined ? $"Since {joined:MMM yyyy}" : "Join date not set")</div>
                    <span class="status-pill small @(_selectedProfile.IsOnShift ? "status-success" : "status-neutral")">@(_selectedProfile.IsOnShift ? "ON SHIFT" : "OFF DUTY")</span>
                    @if (_selectedProfile.AssignedTaxiId is not null)
                    {
                        <span class="profile-unit" title="Assigned unit">@_selectedProfile.AssignedTaxiId</span>
                    }
                    @if (_selectedProfile.IsOnShift && DrivingOtherUnit(_selectedProfile.AssignedTaxiId, _selectedProfile.CurrentShiftTaxiId))
                    {
                        <div class="unit-note">On shift in @_selectedProfile.CurrentShiftTaxiId</div>
                    }
                </div>
            </div>

            @if (_profileError is not null)
            {
                <div class="report-error">@_profileError</div>
            }
            @if (_lastResetPassword is { Ok: true })
            {
                <div class="info-banner success">
                    <p>Password changed. Mobile app login:</p>
                    <p>Email: <code>@_selectedProfile.Email</code></p>
                    <p>Password: <code>@_lastResetPassword.NewPassword</code></p>
                    <p>Share these with the driver directly - the password isn't shown again.</p>
                </div>
            }

            @if (!_isEditingProfile)
            {
                <div class="profile-section">
                    <div class="profile-section-label">Contact Information</div>
                    <div class="profile-field" title="Mobile app login email">✉ @(string.IsNullOrEmpty(_selectedProfile.Email) ? "No login email" : _selectedProfile.Email)</div>
                    <div class="profile-field">📞 @(string.IsNullOrEmpty(_selectedProfile.PhoneNumber) ? "Not set" : InputValidator.FormatPhilippineMobile(_selectedProfile.PhoneNumber))</div>
                    <div class="profile-field">📍 @(string.IsNullOrEmpty(_selectedProfile.Address) ? "Not set" : _selectedProfile.Address)</div>
                </div>

                <div class="profile-section">
                    <div class="profile-section-label">License Credentials</div>
                    <div class="profile-license-card">
                        <div>
                            <div>License No.</div>
                            <strong>@(string.IsNullOrEmpty(_selectedProfile.LicenseNumber) ? "Not set" : _selectedProfile.LicenseNumber)</strong>
                        </div>
                        <span class="status-pill small @LicenseStatusCss(_selectedProfile.LicenseStatus)">@LicenseStatusLabel(_selectedProfile.LicenseStatus)</span>
                    </div>
                    <div class="profile-field">📅 @(_selectedProfile.LicenseExpiryDate is { } exp ? $"Expires {exp:MMM d, yyyy}" : "No expiry date set")</div>
                    @if (string.IsNullOrEmpty(_selectedProfile.LtoIdPhotoUrl))
                    {
                        @if (_selectedProfile.LicenseExpiryDate is not null || !string.IsNullOrEmpty(_selectedProfile.LicenseNumber))
                        {
                            <div class="field-error">⚠ License details are on file but no photo of the license - re-scan it (Edit Details here, or the manager app) to attach one.</div>
                        }
                        else
                        {
                            <div class="profile-field">🖼 No LTO ID photo attached - upload one under Edit Details.</div>
                        }
                    }
                    else
                    {
                        <a class="receipt-preview" href="@_selectedProfile.LtoIdPhotoUrl" target="_blank" rel="noopener" title="Open full-size license photo">
                            <img src="@_selectedProfile.LtoIdPhotoUrl" alt="LTO driver's license on file" />
                        </a>
                    }
                </div>

                <div class="profile-section">
                    <div class="profile-section-label">Performance · last @DriverManagementService.PerformanceWindowDays days</div>
                    @{ DriverPerformance perf = _selectedProfile.Performance; }
                    <div class="profile-metric">
                        <div class="profile-metric-label"><span>Attendance</span><span>@PercentText(perf.AttendancePercent)</span></div>
                        <div class="profile-metric-track"><div class="profile-metric-fill" style="width:@MeterText(perf.AttendancePercent)%"></div></div>
                        <small class="receipt-hint">@(perf.ExpectedDays == 0 ? "No working days expected yet (no assigned unit, or days off / license / unit in the shop)." : $"Drove {perf.DaysWorked} of {perf.ExpectedDays} expected days · {perf.MissedDays} missed")</small>
                    </div>
                    <div class="profile-metric">
                        <div class="profile-metric-label"><span>Punctuality</span><span>@PercentText(perf.PunctualityPercent)</span></div>
                        <div class="profile-metric-track"><div class="profile-metric-fill" style="width:@MeterText(perf.PunctualityPercent)%"></div></div>
                        <small class="receipt-hint">@(perf.PunctualityPercent is null ? "No shifts yet." : $"{perf.ShiftsCompleted - perf.LateReturns} on-time returns · {perf.LateReturns} late · {perf.MissedDays} missed day(s) count as not punctual")</small>
                    </div>
                    <div class="profile-metric">
                        <div class="profile-metric-label"><span>Payment Reliability</span><span>@PercentText(perf.PaymentReliabilityPercent)</span></div>
                        <div class="profile-metric-track"><div class="profile-metric-fill" style="width:@MeterText(perf.PaymentReliabilityPercent)%"></div></div>
                        <small class="receipt-hint">@(perf.BoundariesDue == 0 ? "No boundaries due yet." : $"{perf.BoundariesPaidOnTime} of {perf.BoundariesDue} boundaries paid in full by the next day")</small>
                    </div>
                    <div class="profile-field">Incidents: <strong>@perf.Incidents</strong> <span class="field-optional">(@perf.SosAlerts SOS, @perf.DamageIncidents accident)</span> · Boundaries Remitted: <strong>₱ @perf.BoundariesRemitted.ToString("N0")</strong></div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_selectedProfile.ManagerNote))
                {
                    <div class="profile-section">
                        <div class="profile-section-label">Current Manager Note</div>
                        <div class="profile-field">@_selectedProfile.ManagerNote</div>
                    </div>
                }

                <div class="profile-section">
                    <div class="profile-section-label">Account Settings</div>
                    <button class="profile-action-btn" type="button" @onclick="StartEditProfile">Edit Details</button>
                    @if (!_showPasswordForm)
                    {
                        <button class="profile-action-btn" type="button" @onclick="OpenPasswordForm">Change Mobile App Password</button>
                    }
                    else
                    {
                        @* Two steps on purpose - this used to change the password on a single click. *@
                        <div class="password-form">
                            <label>New Password</label>
                            <input class="text-input" type="text" maxlength="64" @bind="_newPasswordInput" @bind:event="oninput"
                                   placeholder="Leave blank to generate one" autocomplete="off" />
                            <FieldError Show="_newPasswordInput.Length > 0" Message="@InputValidator.ValidatePassword(_newPasswordInput, required: false)" />
                            <small class="receipt-hint">The driver's current password stops working immediately.</small>
                            <div class="profile-edit-actions">
                                <button class="cancel-btn" type="button" disabled="@_isResettingPassword" @onclick="() => _showPasswordForm = false">Cancel</button>
                                <button class="download-btn" type="button" disabled="@(_isResettingPassword || InputValidator.ValidatePassword(_newPasswordInput, required: false) is not null)" @onclick="ResetPasswordAsync">
                                    @(_isResettingPassword ? "Saving…" : "Set Password")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="profile-section">
                    <div class="profile-section-label">Edit Driver Details</div>
                    <label>Login Email (mobile app)</label>
                    <input class="text-input @InvalidCss(true, EditEmailError)" type="email" maxlength="254" @bind="_editEmail" @bind:event="oninput" placeholder="driver's personal email" />
                    <FieldError Show="true" Message="@EditEmailError" />
                    <small class="receipt-hint">Use an address the driver can open - the mobile app's Forgot Password sends its reset link here.</small>
                    <label>Phone Number</label>
                    <input class="text-input @InvalidCss(true, EditPhoneError)" type="tel" inputmode="tel" maxlength="17" @bind="_editPhone" @bind:event="oninput" placeholder="0917 123 4567" />
                    <FieldError Show="true" Message="@EditPhoneError" />
                    <label>Address <span class="field-optional">(optional)</span></label>
                    <input class="text-input @InvalidCss(true, EditAddressError)" maxlength="200" @bind="_editAddress" @bind:event="oninput" />
                    <FieldError Show="true" Message="@EditAddressError" />
                    <label>Assigned Taxi</label>
                    <select class="text-input" @bind="_editAssignedTaxi">
                        <option value="">Unassigned</option>
                        @if (_weekSchedule is not null)
                        {
                            @foreach (string taxiId in _weekSchedule.TaxiIds)
                            {
                                <option value="@taxiId">@TaxiOptionLabel(taxiId, _selectedProfile?.DriverId)</option>
                            }
                        }
                    </select>
                </div>

                <div class="profile-section">
                    <div class="profile-section-label">Scan LTO Driver's License</div>
                    <div class="receipt-scan-row license-scan-row">
                        <label class="receipt-scan-btn @(_isReadingLicense ? "busy" : "")" for="lto-license-input">
                            <span aria-hidden="true">📷</span> @(_isReadingLicense ? "Reading license…" : _licensePreviewUrl is null ? "Upload license photo" : "Upload another")
                        </label>
                        <InputFile id="lto-license-input" class="receipt-file-input" accept="image/*"
                                   disabled="@_isReadingLicense" OnChange="OnLicenseSelectedAsync" @ref="_licenseInput" />
                    </div>

                    @if (_licenseScanError is not null)
                    {
                        <div class="field-error">@_licenseScanError</div>
                    }

                    @if (_licensePreviewUrl is not null)
                    {
                        <a class="receipt-preview" href="@_licensePreviewUrl" target="_blank" rel="noopener" title="Open full-size photo">
                            <img src="@_licensePreviewUrl" alt="Uploaded driver's license" />
                        </a>
                    }

                    @if (_licenseScan is not null && _licenseValidation is not null)
                    {
                        <div class="license-scan-results">
                            <div class="license-scan-field">
                                <span>Document</span>
                                <strong>@LicenseDocumentLabel(_licenseScan)</strong>
                            </div>
