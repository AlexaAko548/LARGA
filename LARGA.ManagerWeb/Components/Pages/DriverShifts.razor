                            {
                                <div class="field-error">@_licenseValidation.LicenseError</div>
                            }

                            @if (_licenseScan.IsPhilippineLicense)
                            {
                                <div class="license-scan-field"><span>Name on card</span><strong>@(_licenseScan.FullName ?? "—")</strong></div>
                                @if (_licenseValidation.NameError is not null)
                                {
                                    <div class="field-error">@_licenseValidation.NameError</div>
                                }
                                <div class="license-scan-field"><span>License No.</span><strong>@(_licenseScan.LicenseNumber ?? "—")</strong></div>

                                <div class="license-scan-field">
                                    <span>Date of Birth</span>
                                    <strong>@(_licenseScan.DateOfBirth is DateTime dob ? $"{dob:MMM d, yyyy} (age {_licenseValidation.Age})" : "—")</strong>
                                </div>
                                @if (_licenseValidation.DateOfBirthError is not null)
                                {
                                    <div class="field-error">@_licenseValidation.DateOfBirthError</div>
                                }

                                <div class="license-scan-field">
                                    <span>Expiration Date</span>
                                    <strong>@(_licenseScan.ExpiryDate is DateTime exp ? exp.ToString("MMM d, yyyy") : "—")</strong>
                                </div>
                                @if (_licenseValidation.ExpiryError is not null)
                                {
                                    <div class="field-error">@_licenseValidation.ExpiryError</div>
                                }
                            }

                            @if (_licenseValidation.IsValid)
                            {
                                <div class="field-ok">✓ Valid license - details filled in below. Save Changes to keep them and attach the photo.</div>
                            }
                            else
                            {
                                <div class="field-error">Not applied - nothing below was changed and the photo won't be saved. Upload a valid license to continue.</div>
                            }
                        </div>
                    }

                    <label>License Number</label>
                    <input class="text-input @InvalidCss(true, EditLicenseNumberError)" maxlength="16" @bind="_editLicenseNumber" @bind:event="oninput" placeholder="A01-23-456789" />
                    <FieldError Show="true" Message="@EditLicenseNumberError" />
                    <label>License Classification (DL codes)</label>
                    <input class="text-input @InvalidCss(true, EditLicenseClassError)" maxlength="40" @bind="_editLicenseClass" @bind:event="oninput" placeholder="e.g. A, B, B1, B2" />
                    <FieldError Show="true" Message="@EditLicenseClassError" />
                    <label>License Restriction Code <span class="field-optional">(optional)</span></label>
                    <input class="text-input @InvalidCss(true, EditRestrictionError)" maxlength="20" @bind="_editLicenseRestriction" @bind:event="oninput" placeholder="e.g. 1, 2 or None" />
                    <FieldError Show="true" Message="@EditRestrictionError" />
                    <label>License Expiry Date</label>
                    <input type="date" class="text-input @InvalidCss(true, EditExpiryError)" max="@PhilippineTime.Now.AddYears(10).ToString("yyyy-MM-dd")" @bind="_editLicenseExpiry" />
                    <FieldError Show="true" Message="@EditExpiryError" />
                    @if (!string.IsNullOrWhiteSpace(_editLicenseNumber) && _editLicenseExpiry is null)
                    {
                        <div class="field-error">Add the expiry date too - without it the license status stays NOT SET.</div>
                    }
                </div>

                <div class="profile-section profile-edit-actions">
                    <button class="cancel-btn" type="button" @onclick="CancelEditProfile">Cancel</button>
                    <button class="download-btn" type="button" disabled="@(_isSavingProfile || EditFormError is not null)" title="@EditFormError" @onclick="SaveProfileAsync">@(_isSavingProfile ? "Saving…" : "Save Changes")</button>
                </div>
            }
        </aside>
    </div>
}
}

@code {
    // True until the first data load finishes. Access itself is enforced server-side by [Authorize].
    private bool _isLoading = true;
    private string _managerUserId = string.Empty;

    private string _activeTab = "roster";

    private RosterSnapshot? _roster;
    private string? _rosterError;

    private WeekSchedule? _weekSchedule;
    private string? _scheduleError;

    private List<ShiftLogEntry>? _shiftLogs;
    private string? _shiftLogsError;
    private bool _shiftLogsLoaded;
    private string _logDateFilter = "All Dates";
    private DateTime? _logCustomFrom;
    private DateTime? _logCustomTo;
    private string _logDriverFilter = "All Drivers";
    private string _logUnitFilter = "All Units";
    private string _logStatusFilter = "All Statuses";
    private bool _showDateFilterMenu, _showDriverFilterMenu, _showUnitFilterMenu, _showStatusFilterMenu;

    private ShiftChecklists? _selectedChecklists;
    private bool _showChecklistModal;

    private bool _showAddDriverModal;
    private string _newDriverName = string.Empty;
    private string _newDriverEmail = string.Empty;
    private string _newDriverPhone = string.Empty;
    private string _newDriverPassword = string.Empty;
    private string _newDriverTaxi = string.Empty;
    private bool _isCreatingDriver;
    private string? _addDriverError;
    private CreateDriverResult? _lastCreatedDriver;

    private bool _showManagerNoteModal;
    private string _managerNoteDriverId = string.Empty;
    private string _managerNoteText = string.Empty;
    private bool _isSavingNote;
    private string? _noteError;

    private bool _showProfilePanel;
    private DriverProfileDetail? _selectedProfile;
    private bool _isEditingProfile;
    private string? _profileError;
    private string _editEmail = string.Empty;
    private string _editPhone = string.Empty;
    private string _editAddress = string.Empty;
    private string _editLicenseNumber = string.Empty;
    private string _editLicenseClass = string.Empty;
    private string _editLicenseRestriction = string.Empty;
    private DateTime? _editLicenseExpiry;
    private string _editAssignedTaxi = string.Empty;
    private bool _isSavingProfile;
    private bool _isResettingPassword;
    private ResetPasswordResult? _lastResetPassword;

    private IEnumerable<ShiftLogEntry> FilteredLogs =>
        (_shiftLogs ?? new List<ShiftLogEntry>())
            .Where(l => _logDriverFilter == "All Drivers" || l.DriverName == _logDriverFilter)
            .Where(l => _logUnitFilter == "All Units" || l.TaxiId == _logUnitFilter)
            .Where(l => _logStatusFilter == "All Statuses" || l.Status == _logStatusFilter);

    private List<string> DistinctDrivers => (_shiftLogs ?? new List<ShiftLogEntry>()).Select(l => l.DriverName).Distinct().OrderBy(n => n).ToList();
    private List<string> DistinctUnits => (_shiftLogs ?? new List<ShiftLogEntry>()).Select(l => l.TaxiId).Distinct().OrderBy(n => n).ToList();
    private List<string> DistinctStatuses => (_shiftLogs ?? new List<ShiftLogEntry>()).Select(l => l.Status).Distinct().OrderBy(n => n).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Audit entries are attributed to the signed-in manager, from the server session.
        AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _managerUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        await LoadRosterAsync();
        await LoadClockInRequestsAsync();
        await LoadScheduleAsync(DateTime.UtcNow);

        _isLoading = false;
        StateHasChanged();

        _ = AutoRefreshLoopAsync(_refreshCts.Token);
    }

    // Drivers clock in/out, go on break and submit checklists from the mobile app while a
    // manager has this page open - re-read those parts periodically so they show up without
    // a manual reload. The schedule is included because a driver can renew their license from
    // the mobile app, which unlocks their planner cells.
    private static readonly TimeSpan AutoRefreshInterval = TimeSpan.FromSeconds(20);
    private readonly CancellationTokenSource _refreshCts = new();

    private async Task AutoRefreshLoopAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(AutoRefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await LoadRosterAsync();
                await LoadClockInRequestsAsync();
                await ReloadDisplayedWeekAsync();
                if (_shiftLogsLoaded)
                {
                    await LoadShiftLogsAsync();
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Page closed.
        }
    }

    // -- Clock-in approvals (flagged pre-shift inspections, paper Ch. IV) -------------------

    private List<ClockInApprovalItem> _clockInRequests = new();
    private bool _isDecidingClockIn;
    private string? _clockInError;
    private ClockInApprovalItem? _denyClockIn;
    private string _denyNote = string.Empty;
    private bool _denyMarkUnderMaintenance;

    private async Task LoadClockInRequestsAsync()
    {
        try
        {
            _clockInRequests = await ClockInApprovals.GetPendingAsync();
        }
        catch (Exception ex)
        {
            _clockInError = $"Clock-in requests unavailable: {ex.Message}";
        }
    }

    private async Task ApproveClockInAsync(ClockInApprovalItem item)
    {
        _isDecidingClockIn = true;
        _clockInError = null;
        try
        {
            ClockInDecisionResult result = await ClockInApprovals.ApproveAsync(item.RequestId, null);
            if (!result.Ok)
            {
                _clockInError = result.ErrorMessage;
            }
            await LoadClockInRequestsAsync();
        }
        finally
        {
            _isDecidingClockIn = false;
        }
    }

    private void OpenDenyClockIn(ClockInApprovalItem item)
    {
        _denyClockIn = item;
        _denyNote = string.Empty;
        // Default: take the unit off the road when something on it actually failed.
        _denyMarkUnderMaintenance = item.HasFailedItems || item.Defects.Count > 0;
        _clockInError = null;
    }

    private void CloseDenyClockIn() => _denyClockIn = null;

    private async Task ConfirmDenyClockInAsync()
    {
        if (_denyClockIn is null)
        {
            return;
        }

        _isDecidingClockIn = true;
        _clockInError = null;
        try
        {
            ClockInDecisionResult result = await ClockInApprovals.DenyAsync(_denyClockIn.RequestId, _denyNote, _denyMarkUnderMaintenance);
            if (!result.Ok)
            {
                _clockInError = result.ErrorMessage;
                return;
            }

            _denyClockIn = null;
            await LoadClockInRequestsAsync();
            await ReloadDisplayedWeekAsync(); // an Under Maintenance unit shows up in the planner
        }
        finally
        {
            _isDecidingClockIn = false;
        }
