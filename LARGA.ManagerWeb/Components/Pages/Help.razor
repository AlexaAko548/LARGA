@page "/help"
@using Microsoft.AspNetCore.Authorization
@using LARGA.ManagerWeb.Services.Faq
@* Any signed-in Manager or Assistant Manager (the default policy); no Manager-only restriction. *@
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Help & FAQs</PageTitle>

<div class="dashboard-shell">
    <DashboardSidebar ActiveItem="Help" />

    <main class="dashboard-main">
        <header class="dashboard-header">
            <div class="header-title-wrap">
                <h1>HELP &amp; FAQS</h1>
                <div class="header-date">Answers to common questions</div>
            </div>

            <div class="header-actions">
                <NotificationBell />
                <MessagesButton />
                <ManagerProfileMenu />
            </div>
        </header>

        <section class="faq-toolbar">
            <div class="search-box faq-search">
                <input type="search" class="input-search" maxlength="80" placeholder="Search questions…" aria-label="Search questions"
                       value="@_query" @oninput="e => _query = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="faq-chips" role="group" aria-label="Filter by category">
                <button type="button" class="faq-chip @(_category is null ? "selected" : null)" aria-pressed="@(_category is null)" @onclick="() => _category = null">All</button>
                @foreach (FaqCategory category in FaqCatalog.Categories)
                {
                    string id = category.Id;
                    <button type="button" class="faq-chip @(_category == id ? "selected" : null)" aria-pressed="@(_category == id)" @onclick="() => _category = id">@category.Title</button>
                }
            </div>
        </section>

        @{
            IReadOnlyList<FaqEntry> shown = FaqSearch.Filter(FaqCatalog.Entries, _query, _category);
            bool searching = !string.IsNullOrWhiteSpace(_query);
        }

        @if (shown.Count == 0)
        {
            <div class="table-empty">No questions match. Try fewer or different words.</div>
        }

        @foreach (FaqCategory category in FaqCatalog.Categories)
        {
            List<FaqEntry> items = shown.Where(e => e.CategoryId == category.Id).ToList();
            if (items.Count == 0)
            {
                continue;
            }

            <section class="faq-category" id="faq-@category.Id">
                <h2 class="faq-category-title">@category.Title</h2>
                @foreach (FaqEntry entry in items)
                {
                    <details class="faq-item" id="faq-q-@entry.Id" open="@searching" @key="entry.Id">
                        <summary>
                            <span class="faq-question">@entry.Question</span>
                            @if (entry.ManagerOnly)
                            {
                                <span class="status-pill small status-warning faq-tag">Manager only</span>
                            }
                        </summary>
                        <div class="faq-answer">
                            @if (entry.ManagerOnly && !_isManager)
                            {
                                <div class="info-banner">Only the Manager can do this. You can read how it works, but the buttons are hidden for Assistant Managers.</div>
                            }
                            @foreach (string block in Blocks(entry.Answer))
                            {
                                if (block.StartsWith("• ", StringComparison.Ordinal))
                                {
                                    <ul>
                                        @foreach (string line in block.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <li>@line.TrimStart('•', ' ')</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p>@block</p>
                                }
                            }
                        </div>
                    </details>
                }
            </section>
        }
    </main>
</div>

@code {
    private string _query = string.Empty;
    private string? _category;
    private bool _isManager;
    private IJSObjectReference? _module;

    // Paragraphs are separated by a blank line. Lines starting "• " stay together as one list.
    private static IEnumerable<string> Blocks(string answer) =>
        answer.Replace("\r\n", "\n").Split("\n\n", StringSplitOptions.RemoveEmptyEntries).Select(b => b.Trim());

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthStateProvider.GetAuthenticationStateAsync();
        _isManager = state.User.IsInRole(ManagerSignInService.ManagerRole);
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ScrollToFragmentAsync();
        }
    }

    // /help#ledger (from a tour's last step) scrolls to that category.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(ScrollToFragmentAsync);

    private async Task ScrollToFragmentAsync()
    {
        string id = new Uri(Navigation.Uri).Fragment.TrimStart('#');
        if (id.Length == 0 || FaqCatalog.Categories.All(c => c.Id != id))
        {
            return;
        }

        try
        {
            _query = string.Empty;
            _category = null;
            StateHasChanged();
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/help.js");
            await _module.InvokeVoidAsync("scrollToCategory", id);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // The page still shows every category; only the scroll is lost.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch (Exception ex) when (ex is JSException or JSDisconnectedException) { }
        }
    }
}
