@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.Authorization
@using LARGA.ManagerWeb.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage SessionStorage
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>LARGA Fleet OS</PageTitle>

@if (_isCheckingSession)
{
    <div style="height: 100vh; display: flex; justify-content: center; align-items: center; background-color: #f8f9fa;">
        <span style="color: #4a5568; font-weight: bold;">Verifying secure session...</span>
    </div>
}
else
{
    <div class="landing-shell">
        <div class="landing-panel">
            <div class="landing-brand">
                <img class="fleet-logo" src="/images/larga-logo-taxi.png" alt="LARGA Fleet OS logo" />
                <h1>LARGA FLEET OS</h1>
                <div class="hero-subtitle">Internal Operations Management System</div>

                <div class="status-row">
                    <span class="status-dot"></span>
                    <span>SYSTEM ONLINE • AUTHORIZED ACCESS ONLY</span>
                </div>

                <p class="hero-copy">
                    This is a private fleet management portal commissioned exclusively for authorized managers.
                    Unauthorized access is strictly prohibited.
                </p>

                <div class="feature-grid">
                    <div class="feature-item"><span class="feature-icon">◔</span><span>Fleet Monitoring</span></div>
                    <div class="feature-item"><span class="feature-icon">$</span><span>Boundary Collections</span></div>
                    <div class="feature-item"><span class="feature-icon">▣</span><span>Fuel Verification</span></div>
                    <div class="feature-item"><span class="feature-icon">🛠</span><span>Maintenance Logs</span></div>
                    <div class="feature-item"><span class="feature-icon">👥</span><span>Driver Management</span></div>
                    <div class="feature-item"><span class="feature-icon">▤</span><span>Full Audit Trail</span></div>
                </div>
            </div>

            <div class="landing-footer">v2.1.0 • © 2026 LARGA Fleet OS • All rights reserved</div>
        </div>

        <aside class="manager-panel">
            <div class="portal-box">
                <h2>Manager Portal</h2>
                <p>Sign in with your authorized manager credentials to access the fleet operations dashboard.</p>

                <a class="primary-btn" href="/login">SIGN IN TO DASHBOARD <span>›</span></a>
                <a class="secondary-btn" href="/register">Request Manager Access <span>›</span></a>

                <div class="divider">DRIVER ACCESS</div>

                <div class="driver-box">
                    <div class="mini-icon">◔</div>
                    <div>
                        <h3>Are you a driver?</h3>
                        <p>Driver access is exclusively through the LARGA mobile app. Contact your manager for login credentials.</p>
                    </div>
                </div>

                <div class="security-note">
                    <span class="shield-icon">◈</span>
                    <span>Secured • Private System</span>
                    <div>Unauthorized use is prohibited</div>
                </div>
            </div>
        </aside>
    </div>
}

@code {
    private bool _isCheckingSession = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Ask the provider for the state
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();

            // If logged in, redirect to dashboard
            if (authState.User.Identity?.IsAuthenticated ?? false)
            {
                Navigation.NavigateTo("/dashboard", replace: true);
                return;
            }

            // If not logged in, stop the loading screen and show the Landing UI
            _isCheckingSession = false;
            StateHasChanged();
        }
    }
}