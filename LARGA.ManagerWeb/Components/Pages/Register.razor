@page "/register"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

@* "Request Manager Access" (Landing, Login). Accounts are no longer created here (audit B-01): this page
   let anyone on the internet create a Firebase account and try to make it a Manager. Manager and
   driver accounts are created by the fleet owner from inside the dashboard (Admin SDK). *@

<PageTitle>Request Access - web</PageTitle>

<div class="auth-page">
    <div class="back-link">
        <a href="/"><Icon Name="arrow-left" /> Back to Home</a>
    </div>

    <div class="auth-card register-card">
        <div class="brand-lockup compact">
            <img class="mini-logo" src="/images/larga-logo-taxi.png" alt="LARGA Fleet OS logo" />
            <div class="brand-title">LARGA Fleet OS</div>
            <div class="brand-subtitle">Manager Portal</div>
        </div>

        <h2>Request Manager Access</h2>
        <p>
            Manager accounts are created by the fleet owner. Ask BLM Taxi's owner or manager to add you,
            and you'll receive your login email and a temporary password.
        </p>
        <p>Drivers use the LARGA mobile app with the account their manager created for them.</p>

        <div class="auth-divider"><span>OR</span></div>

        <div class="switch-copy">
            Already have an account? <a href="/login">Sign In</a>
        </div>
    </div>

    <div class="portal-note">
        <span class="shield-icon"><Icon Name="shield-check" /></span>
        <span>Manager-only portal</span>
        <span class="dot-separator">•</span>
        <span>Drivers use the mobile app</span>
    </div>
</div>
