@page "/register/password"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject NavigationManager Navigation

@* Step 2 of the old self-registration, which created a Firebase account from the browser. Removed
   (audit B-01); old links and bookmarks land on the Request Access page instead. *@

@code {
    protected override void OnInitialized() => Navigation.NavigateTo("/register", replace: true);
}
