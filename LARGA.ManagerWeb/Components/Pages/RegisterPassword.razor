@page "/register/password"
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using System.Text.RegularExpressions
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Register - web</PageTitle>

<div class="auth-page">
    <div class="back-link">
        <a href="/">← Back to Home</a>
    </div>

    <EditForm Model="_model" FormName="manager-register-password" OnValidSubmit="HandleCreateAccount" class="auth-card register-card">
        <DataAnnotationsValidator />

        <div class="brand-lockup compact">
            <img class="mini-logo" src="/images/larga-logo-taxi.png" alt="LARGA Fleet OS logo" />
            <div class="brand-title">LARGA Fleet OS</div>
            <div class="brand-subtitle">Manager Portal</div>
        </div>

        <div class="step-indicator">
            <div class="step inactive">1</div>
            <div class="step active">2</div>
        </div>

        <h2>Secure Your Account</h2>
        <p>Choose a strong password for your manager portal.</p>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="login-error">@_errorMessage</div>
        }

        <div class="form-block">
            <label for="password">CREATE PASSWORD</label>
            <InputText id="password" @bind-Value="_model.Password" class="form-control" type="password" placeholder="Min. 8 characters" />
        </div>

        <div class="form-block">
            <label for="confirmPassword">CONFIRM PASSWORD</label>
            <InputText id="confirmPassword" @bind-Value="_model.ConfirmPassword" class="form-control" type="password" placeholder="Re-enter password" />
        </div>

        <div class="criteria-grid">
            <div class="criterion">@(_model.Password.Length >= 8 ? "✓" : "◯") 8+ characters</div>
            <div class="criterion">@(Regex.IsMatch(_model.Password, "[A-Z]") ? "✓" : "◯") Uppercase letter</div>
            <div class="criterion">@(Regex.IsMatch(_model.Password, "[0-9]") ? "✓" : "◯") Number</div>
            <div class="criterion">@(_model.Password == _model.ConfirmPassword && !string.IsNullOrWhiteSpace(_model.ConfirmPassword) ? "✓" : "◯") Passwords match</div>
        </div>

        <div class="button-row">
            <a class="secondary-btn small" href="/register">Back</a>
            <button class="primary-btn" type="submit" disabled="@_isSubmitting">
                @(_isSubmitting ? "CREATING..." : "CREATE ACCOUNT")
            </button>
        </div>

        <div class="auth-divider"><span>OR</span></div>

        <div class="switch-copy">
            Already have an account? <a href="/login">Sign In</a>
        </div>
    </EditForm>

    <div class="portal-note">
        <span class="shield-icon">◈</span>
        <span>Manager-only portal</span>
        <span class="dot-separator">•</span>
        <span>Drivers use the mobile app</span>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "fullName")]
    public string FullName { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "email")]
    public string Email { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "fleetSize")]
    public string FleetSize { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "phone")]
    public string Phone { get; set; } = string.Empty;

    private readonly RegisterPasswordModel _model = new();
    private bool _isSubmitting;
    private string? _errorMessage;
    private IJSObjectReference? _firebaseModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _firebaseModule = await JS.InvokeAsync<IJSObjectReference>("import", "/firebase-auth.js");
        }
    }

    private async Task HandleCreateAccount()
    {
        _errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(_model.Password) || string.IsNullOrWhiteSpace(_model.ConfirmPassword))
        {
            _errorMessage = "Please enter and confirm your password.";
            return;
        }

        if (_model.Password.Length < 8)
        {
            _errorMessage = "Password must be at least 8 characters long.";
            return;
        }

        if (!Regex.IsMatch(_model.Password, "[A-Z]"))
        {
            _errorMessage = "Password must include at least one uppercase letter.";
            return;
        }

        if (!Regex.IsMatch(_model.Password, "[0-9]"))
        {
            _errorMessage = "Password must include at least one number.";
            return;
        }

        if (!string.Equals(_model.Password, _model.ConfirmPassword, StringComparison.Ordinal))
        {
            _errorMessage = "Passwords do not match.";
            return;
        }

        _isSubmitting = true;

        try
        {
            if (_firebaseModule is null)
            {
                _firebaseModule = await JS.InvokeAsync<IJSObjectReference>("import", "/firebase-auth.js");
            }

            var result = await _firebaseModule.InvokeAsync<JsonElement>("largaFirebaseRegister", Email, _model.Password, FullName);

            if (result.TryGetProperty("ok", out var okProp) && okProp.ValueKind == JsonValueKind.True)
            {
                Navigation.NavigateTo("/login", forceLoad: false);
                return;
            }

            if (result.TryGetProperty("message", out var msgProp) && msgProp.ValueKind == JsonValueKind.String)
            {
                _errorMessage = msgProp.GetString();
            }
            else
            {
                _errorMessage = "Unable to create your account. Please check your Firebase configuration.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private class RegisterPasswordModel
    {
        [Required(ErrorMessage = "Password is required.")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters long.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
