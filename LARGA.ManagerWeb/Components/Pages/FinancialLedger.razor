@page "/financial-ledger"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using System.Text.Json
@using LARGA.SharedCore
@using LARGA.SharedCore.Models.DriverShifts
@using LARGA.SharedCore.Models.FinancialLedger
@using LARGA.SharedCore.Services
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject FinancialLedgerService Ledger
@inject FleetReportingService FleetReporting
@inject DriverManagementService DriverManagement

<PageTitle>Financial Ledger &amp; Debts</PageTitle>

@if (_isLoading)
{
    <div class="auth-page">
        <div class="auth-card">
            <h2>Loading...</h2>
        </div>
    </div>
}
else
{
<div class="dashboard-shell">
    <DashboardSidebar ActiveItem="FinancialLedger" />

    <main class="dashboard-main">
        <header class="dashboard-header">
            <div class="header-title-wrap">
                <h1>FINANCIAL LEDGER &amp; DEBTS</h1>
                <div class="header-date">Clearances, adjustments, debt rollover</div>
            </div>

            <div class="header-actions">
                <NotificationBell />
                <MessagesButton />
                <ManagerProfileMenu />
            </div>
        </header>

        @if (_activeTab == "daily" && _settlementError is not null)
        {
            <div class="data-warning-banner">Settlement data unavailable: @_settlementError</div>
        }
        @if (_activeTab == "master" && _ledgerError is not null)
        {
            <div class="data-warning-banner">Debt ledger data unavailable: @_ledgerError</div>
        }

        <section class="tab-bar">
            <div class="tab-group">
                <button class="tab-btn @(_activeTab == "daily" ? "active" : "")" type="button" @onclick='() => SelectTabAsync("daily")'>▦ Daily Settlements</button>
                <button class="tab-btn @(_activeTab == "master" ? "active" : "")" type="button" @onclick='() => SelectTabAsync("master")'>▥ Master Debt Ledger</button>
            </div>
            <div class="tab-actions">
                <button class="solid-btn" type="button" @onclick="OpenAdjustmentModal">+ Adjustment</button>
                <button class="outline-btn" type="button" disabled="@_isExportingCsv" @onclick="ExportCsvAsync">@(_isExportingCsv ? "Exporting…" : "⬇ Export")</button>
            </div>
        </section>

        @if (_exportError is not null)
        {
            <div class="report-error">@_exportError</div>
        }

        @if (_activeTab == "daily")
        {
        @if (_snapshot is null)
        {
            <div class="table-empty">Loading settlements...</div>
        }
        else
        {
            <section class="settlement-summary">
                <div class="settlement-summary-header">
                    <div>
                        <div class="settlement-summary-title">@(IsSettlementToday ? "TODAY'S SUMMARY" : "DAY SUMMARY")</div>
                        <div class="settlement-day-nav">
                            <button type="button" class="settlement-day-btn" title="Previous day" disabled="@_isLoadingSettlement" @onclick="() => ShiftSettlementDayAsync(-1)">‹</button>
                            <input type="date" class="settlement-day-input" value="@_settlementDay.ToString("yyyy-MM-dd")" max="@PhilippineTime.Now.ToString("yyyy-MM-dd")" @onchange="OnSettlementDayPickedAsync" />
                            <button type="button" class="settlement-day-btn" title="Next day" disabled="@(_isLoadingSettlement || IsSettlementToday)" @onclick="() => ShiftSettlementDayAsync(1)">›</button>
                            @if (!IsSettlementToday)
                            {
                                <button type="button" class="settlement-today-link" @onclick="() => ShiftSettlementDayAsync(0)">Today</button>
                            }
                        </div>
                    </div>
                    <div class="settlement-pills">
                        <span class="status-pill status-success"><span class="dot"></span> @_snapshot.ClearedCount Cleared</span>
                        <span class="status-pill status-warning"><span class="dot"></span> @_snapshot.PartialCount Partial</span>
                        <span class="status-pill status-neutral"><span class="dot"></span> @_snapshot.WaitingCount Waiting</span>
                    </div>
                </div>

                <div class="settlement-figures">
                    <div class="settlement-figure">
                        <div class="settlement-figure-label">EXPECTED COLLECTION</div>
                        <div class="settlement-figure-value">₱ @_snapshot.ExpectedCollection.ToString("N0")</div>
                    </div>
                    <div class="settlement-figure">
                        <div class="settlement-figure-label">COLLECTED SO FAR</div>
                        <div class="settlement-figure-value">₱ @_snapshot.CollectedSoFar.ToString("N0")</div>
                        @if (_snapshot.CreditApplied > 0)
                        {
                            <div class="settlement-credit-note">+ ₱ @_snapshot.CreditApplied.ToString("N0") covered by credit</div>
                        }
                    </div>
                    <div class="settlement-figure">
                        <div class="settlement-figure-label">STILL OUTSTANDING</div>
                        <div class="settlement-figure-value">₱ @_snapshot.StillOutstanding.ToString("N0")</div>
                    </div>
                </div>

                <div class="settlement-progress-track">
                    <div class="settlement-progress-fill" style="width:@(Math.Min(100, _snapshot.PercentCollected).ToString("0"))%"></div>
                </div>
                <div class="settlement-progress-label">@_snapshot.PercentCollected.ToString("0")% collected</div>
            </section>

            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Driver</th>
                            <th>Unit</th>
                            <th>Shift Ended</th>
                            <th>Boundary</th>
                            <th>Paid</th>
                            <th>Balance</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_snapshot.Rows.Count == 0)
                        {
                            <tr><td colspan="8" class="table-empty">No shifts today yet.</td></tr>
                        }
                        else
                        {
                            @foreach (SettlementRow row in _snapshot.Rows)
                            {
                                <tr>
                                    <td><span class="status-pill @StatusCss(row.Status)"><span class="dot"></span> @row.Status.ToString().ToUpperInvariant()</span></td>
                                    <td class="driver-cell"><div class="table-avatar">@Initials(row.DriverName)</div><span>@row.DriverName</span></td>
                                    <td>@row.TaxiId</td>
                                    <td>@(row.ShiftEnd.HasValue ? row.ShiftEnd.Value.ToPhilippineTime().ToString("h:mm tt") : "On road")</td>
                                    <td>₱ @row.ExpectedTotal.ToString("N0")</td>
                                    <td>
                                        @if (row.AmountPaid > 0 || row.CreditApplied > 0)
                                        {
                                            <span>@(row.AmountPaid > 0 ? $"₱ {row.AmountPaid:N0}" : "–")</span>
                                            @if (row.Status == SettlementStatus.Cleared)
                                            {
                                                <span class="settlement-check">✓</span>
                                            }
                                            @if (row.CreditApplied > 0)
                                            {
                                                <div class="settlement-credit-note" title="Covered by money the driver paid above another shift's boundary">+ ₱ @row.CreditApplied.ToString("N0") credit</div>
                                            }
                                        }
                                        else
                                        {
                                            <span>–</span>
                                        }
                                    </td>
                                    <td>
                                        @if (row.Status == SettlementStatus.Cleared)
                                        {
                                            <span class="settlement-closed">Closed</span>
                                        }
                                        else
                                        {
                                            <span>₱ @row.Balance.ToString("N0")</span>
                                        }
                                    </td>
                                    <td>
                                        @if (row.Status != SettlementStatus.Cleared)
                                        {
                                            <button class="profile-btn" type="button" @onclick="() => OpenPaymentModalAsync(row)">@(row.Status == SettlementStatus.Partial ? "Add Payment" : "Record Payment")</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    @if (_snapshot.Rows.Count > 0)
                    {
                        <tfoot>
                            <tr class="totals-row">
                                <td colspan="4">TOTAL</td>
                                <td>₱ @_snapshot.ExpectedCollection.ToString("N0")</td>
                                <td>₱ @_snapshot.CollectedSoFar.ToString("N0")</td>
                                <td>₱ @_snapshot.StillOutstanding.ToString("N0")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        }
        }
        else if (_activeTab == "master")
        {
            @if (_ledgerSnapshot is null)
            {
                <div class="table-empty">Loading the debt ledger...</div>
            }
            else
            {
                <section class="stats-grid">
                    <article class="stat-card">
                        <div class="stat-icon">☺</div>
                        <div class="stat-body">
                            <div class="stat-value">@_ledgerSnapshot.DriversWithDebtCount</div>
                            <div class="stat-label">Drivers With Debt</div>
                        </div>
                    </article>
                    <article class="stat-card">
                        <div class="stat-icon">₱</div>
                        <div class="stat-body">
                            <div class="stat-value">₱ @_ledgerSnapshot.TotalOutstandingDebt.ToString("N0")</div>
                            <div class="stat-label">Total Outstanding Debt</div>
                        </div>
                    </article>
                    <article class="stat-card">
                        <div class="stat-icon">✓</div>
                        <div class="stat-body">
                            <div class="stat-value">@_ledgerSnapshot.DebtFreeDriverCount</div>
                            <div class="stat-label">Debt-Free Drivers</div>
                        </div>
                    </article>
                </section>

                <div class="data-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Driver</th>
                                <th>Unit</th>
                                <th>Unpaid Days</th>
                                <th>Last Payment Date</th>
                                <th>Last Payment Amount</th>
                                <th>Debt</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_ledgerSnapshot.Rows.Count == 0)
                            {
                                <tr><td colspan="7" class="table-empty">No drivers yet.</td></tr>
                            }
                            else
                            {
                                @foreach (DebtLedgerRow row in _ledgerSnapshot.Rows)
                                {
                                    <tr>
                                        <td class="driver-cell">
                                            <div class="table-avatar">@Initials(row.DriverName)</div>
                                            <span>@row.DriverName</span>
                                            @if (row.IsDebtFlagged)
                                            {
                                                <span class="status-pill small status-danger" title="Balance unpaid for @row.DaysUnpaid days - flagged for review">⚑ FLAGGED</span>
                                            }
                                        </td>
                                        <td>@(row.TaxiId ?? "–")</td>
                                        <td>
                                            @if (row.UnpaidCount > 0)
                                            {
                                                <span>@row.UnpaidCount @(row.UnpaidCount == 1 ? "shift" : "shifts")</span>
                                                <div class="ledger-unpaid-age @(row.IsDebtFlagged ? "overdue" : "")">oldest @row.DaysUnpaid @(row.DaysUnpaid == 1 ? "day" : "days") ago</div>
                                            }
                                            else
                                            {
                                                @:–
                                            }
                                        </td>
                                        <td>@(row.LastPaymentDate.HasValue ? row.LastPaymentDate.Value.ToPhilippineTime().ToString("MMM d") : "–")</td>
                                        <td>@(row.LastPaymentAmount.HasValue ? $"₱ {row.LastPaymentAmount.Value:N0}" : "–")</td>
                                        <td>
                                            ₱ @row.TotalDebt.ToString("N0")
                                            @if (row.AdvanceCredit > 0)
                                            {
                                                <div class="settlement-credit-note">₱ @row.AdvanceCredit.ToString("N0") advance credit</div>
                                            }
                                        </td>
                                        <td class="ledger-actions">
                                            @if (row.TotalDebt > 0)
                                            {
                                                <button class="profile-btn" type="button" @onclick="() => OpenSettleModal(row)">Settle</button>
                                            }
                                            <button class="profile-btn" type="button" @onclick="() => OpenHistoryModalAsync(row)">History</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        @if (_ledgerSnapshot.Rows.Count > 0)
                        {
                            <tfoot>
                                <tr class="totals-row">
                                    <td colspan="5">TOTAL</td>
                                    <td>₱ @_ledgerSnapshot.TotalOutstandingDebt.ToString("N0")</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            }
        }
    </main>
</div>
}

@if (_showPaymentModal && _paymentRow is not null)
{
    <div class="report-overlay" @onclick="ClosePaymentModal">
        <div class="report-modal payment-modal @(_paymentMethod == "EWallet" ? "with-receipt" : "")" @onclick:stopPropagation="true">
            <div class="report-header">
                <h3>Record Payment</h3>
                <button type="button" class="close-modal" @onclick="ClosePaymentModal">×</button>
            </div>
            <div class="report-body payment-body">
                <div class="payment-main">
                <div class="settlement-modal-subject">@_paymentRow.DriverName · @_paymentRow.TaxiId</div>

                <div class="settlement-modal-figures">
                    @if (_paymentRow.LateFee > 0 || _paymentRow.FuelPenalty > 0)
                    {
                        <div class="settlement-modal-figure-row"><span>Boundary</span><span>₱ @((_paymentRow.ExpectedTotal - _paymentRow.LateFee - _paymentRow.FuelPenalty).ToString("N0"))</span></div>
                        @if (_paymentRow.LateFee > 0)
                        {
                            <div class="settlement-modal-figure-row"><span>+ Late return fee</span><span>₱ @_paymentRow.LateFee.ToString("N0")</span></div>
                        }
                        @if (_paymentRow.FuelPenalty > 0)
                        {
                            <div class="settlement-modal-figure-row"><span>+ Low fuel penalty (below ½ tank)</span><span>₱ @_paymentRow.FuelPenalty.ToString("N0")</span></div>
                        }
                    }
                    <div class="settlement-modal-figure-row"><span>Total Due</span><strong>₱ @_paymentRow.ExpectedTotal.ToString("N0")</strong></div>
                    <div class="settlement-modal-figure-row"><span>Already Paid</span><strong>₱ @_paymentRow.AmountPaid.ToString("N0")</strong></div>
                    @if (_paymentRow.CreditApplied > 0)
                    {
                        <div class="settlement-modal-figure-row"><span>Covered by credit</span><strong>₱ @_paymentRow.CreditApplied.ToString("N0")</strong></div>
                    }
                    <div class="settlement-modal-figure-row"><span>Remaining</span><strong>₱ @PaymentRemaining.ToString("N0")</strong></div>
                </div>

                <div class="report-section">
                    <label>Amount Received (PHP)</label>
                    <input class="text-input @(PaymentAmountError is not null && _paymentAmountInput != 0 ? "invalid" : "")" type="number" min="0" max="@MaxPayment" step="0.01" @bind="_paymentAmountInput" @bind:event="oninput"
                           readonly="@(_paymentMethod == "EWallet")" placeholder="@(_paymentMethod == "EWallet" ? "Filled in from the receipt" : "")" />
                    <FieldError Show="_paymentAmountInput != 0" Message="@PaymentAmountError" />
                </div>

                <div class="payment-method-toggle">
                    <button type="button" class="payment-method-btn @(_paymentMethod == "Cash" ? "active" : "")" @onclick='() => SetPaymentMethod("Cash")'>CASH</button>
                    <button type="button" class="payment-method-btn @(_paymentMethod == "EWallet" ? "active" : "")" @onclick='() => SetPaymentMethod("EWallet")'>E-WALLET (GCASH)</button>
                </div>

                <div class="settlement-status-preview">
                    <span>New status →</span>
                    <span class="status-pill small @StatusCss(PreviewStatus)">@PreviewStatus.ToString().ToUpperInvariant()</span>
                    @if (PreviewStatus == SettlementStatus.Partial)
                    {
                        <span class="settlement-remaining-note">₱ @PreviewShortfall.ToString("N0") → Master Ledger</span>
                    }
                </div>

                @if (PaymentExtra > 0 && _paymentOtherDebt is decimal otherDebt)
                {
                    <div class="settlement-allocation">
                        @if (Math.Min(PaymentExtra, otherDebt) > 0)
                        {
                            <div>₱ @Math.Min(PaymentExtra, otherDebt).ToString("N0") → @_paymentRow.DriverName's older unpaid debt</div>
                        }
                        @if (PaymentAdvance > 0)
                        {
                            <div>₱ @PaymentAdvance.ToString("N0") → advance credit (covers their next boundary)</div>
                        }
                    </div>
                }

                @if (_paymentError is not null)
                {
                    <div class="report-error">@_paymentError</div>
                }
                </div>

                @if (_paymentMethod == "EWallet")
                {
                    <div class="payment-receipt">@ReceiptScanSection</div>
                }
            </div>
            <div class="report-actions">
                <button class="cancel-btn" type="button" @onclick="ClosePaymentModal">Cancel</button>
                <button class="download-btn" type="button" disabled="@(_isSavingPayment || PaymentAmountError is not null || (PaymentExtra > 0 && _paymentOtherDebt is null) || (_paymentMethod == "EWallet" && !IsReceiptReady))" @onclick="ConfirmPaymentAsync">@(_isSavingPayment ? "Saving…" : "Confirm Payment")</button>
            </div>
        </div>
    </div>
}

@if (_showAdjustmentModal)
{
    <div class="report-overlay" @onclick="CloseAdjustmentModal">
        <div class="report-modal" @onclick:stopPropagation="true">
            <div class="report-header">
                <h3>Manual Adjustment / Penalty</h3>
                <button type="button" class="close-modal" @onclick="CloseAdjustmentModal">×</button>
            </div>
            <div class="report-body">
                <div class="report-section">
                    <label>Driver</label>
                    <select class="text-input" @bind="_adjustmentDriverId">
                        <option value="">Select a driver…</option>
                        @if (_driverOptions is not null)
                        {
                            @foreach (DriverRosterEntry d in _driverOptions)
                            {
                                <option value="@d.DriverId">@d.FullName</option>
                            }
                        }
                    </select>
                </div>

                <div class="report-section">
                    <label>Amount (PHP)</label>
                    <input class="text-input @(AdjustmentAmountError is not null && _adjustmentAmountInput != 0 ? "invalid" : "")" type="number" min="0" max="@MaxAdjustment" step="0.01" placeholder="e.g. 200" @bind="_adjustmentAmountInput" @bind:event="oninput" />
                    <FieldError Show="_adjustmentAmountInput != 0" Message="@AdjustmentAmountError" />
                </div>

                <div class="report-section">
                    <label>Type</label>
                    <select class="text-input" @bind="_adjustmentDirection">
                        <option value="Add">Penalty / Add to Debt</option>
                        <option value="Credit">Credit / Write-off</option>
                    </select>
                </div>

                <div class="report-section">
                    <label>Note</label>
                    <textarea class="text-input textarea" maxlength="300" @bind="_adjustmentReason" @bind:event="oninput" placeholder="Reason for adjustment (required)"></textarea>
                    <FieldError Show="_adjustmentReason.Length > 0" Message="@AdjustmentReasonError" />
                    <small class="receipt-hint">@_adjustmentReason.Length / 300</small>
                </div>

                <div class="info-banner">Adjustments don't touch today's boundary payments - they're a separate correction that feeds the Master Debt Ledger balance.</div>

                @if (_adjustmentError is not null)
                {
                    <div class="report-error">@_adjustmentError</div>
                }
            </div>
            <div class="report-actions">
                <button class="cancel-btn" type="button" @onclick="CloseAdjustmentModal">Cancel</button>
                <button class="download-btn" type="button" disabled="@(_isSavingAdjustment || string.IsNullOrEmpty(_adjustmentDriverId) || AdjustmentAmountError is not null || AdjustmentReasonError is not null)" @onclick="ConfirmAdjustmentAsync">@(_isSavingAdjustment ? "Saving…" : "Save Adjustment")</button>
            </div>
        </div>
    </div>
}

@if (_showSettleModal && _settleRow is not null)
{
    <div class="report-overlay" @onclick="CloseSettleModal">
        <div class="report-modal payment-modal @(_settleMethod == "EWallet" ? "with-receipt" : "")" @onclick:stopPropagation="true">
            <div class="report-header">
                <h3>Settle Outstanding Debt</h3>
                <button type="button" class="close-modal" @onclick="CloseSettleModal">×</button>
            </div>
            <div class="report-body payment-body">
                <div class="payment-main">
                <div class="settlement-modal-subject">@_settleRow.DriverName · @(_settleRow.TaxiId ?? "No unit assigned")</div>

                <div class="settlement-modal-figures">
                    <div class="settlement-modal-figure-row"><span>Current Debt Balance</span><strong>₱ @_settleRow.TotalDebt.ToString("N0")</strong></div>
                </div>

                <div class="report-section">
                    <label>Amount Received (PHP)</label>
                    <input class="text-input @(SettleAmountError is not null && _settleAmountInput != 0 ? "invalid" : "")" type="number" min="0" max="@MaxPayment" step="0.01" @bind="_settleAmountInput" @bind:event="oninput"
                           readonly="@(_settleMethod == "EWallet")" placeholder="@(_settleMethod == "EWallet" ? "Filled in from the receipt" : "")" />
                    <FieldError Show="_settleAmountInput != 0" Message="@SettleAmountError" />
                </div>

                <div class="payment-method-toggle">
                    <button type="button" class="payment-method-btn @(_settleMethod == "Cash" ? "active" : "")" @onclick='() => SetSettleMethod("Cash")'>CASH</button>
                    <button type="button" class="payment-method-btn @(_settleMethod == "EWallet" ? "active" : "")" @onclick='() => SetSettleMethod("EWallet")'>E-WALLET (GCASH)</button>
                </div>


                <div class="settlement-modal-figures">
                    <div class="settlement-modal-figure-row"><span>New Remaining Balance</span><strong>₱ @SettlePreviewRemaining.ToString("N0")</strong></div>
                </div>

                <div class="settlement-status-preview">
                    <span>Status →</span>
                    <span class="status-pill small @(SettlePreviewRemaining <= 0 ? "status-success" : "status-warning")">@(SettlePreviewRemaining <= 0 ? "CLEARED" : "OUTSTANDING")</span>
                    @if (SettlePreviewOverpaid > 0)
                    {
                        <span class="settlement-remaining-note">₱ @SettlePreviewOverpaid.ToString("N0") → advance credit (covers their next boundary)</span>
                    }
                </div>

                @if (_settleError is not null)
                {
                    <div class="report-error">@_settleError</div>
                }
                </div>

                @if (_settleMethod == "EWallet")
                {
                    <div class="payment-receipt">@ReceiptScanSection</div>
                }
            </div>
            <div class="report-actions">
                <button class="cancel-btn" type="button" @onclick="CloseSettleModal">Cancel</button>
                <button class="download-btn" type="button" disabled="@(_isSavingSettle || SettleAmountError is not null || (_settleMethod == "EWallet" && !IsReceiptReady))" @onclick="ConfirmSettleAsync">@(_isSavingSettle ? "Saving…" : "Confirm Payment")</button>
            </div>
        </div>
    </div>
}

@if (_showHistoryModal)
{
    <div class="report-overlay" @onclick="CloseHistoryModal">
        <div class="report-modal wide" @onclick:stopPropagation="true">
            <div class="report-header">
                <h3>Financial History</h3>
                <button type="button" class="close-modal" @onclick="CloseHistoryModal">×</button>
            </div>
            <div class="report-body">
                @if (_history is null)
                {
                    <div class="table-empty">Loading history...</div>
                }
                else
                {
                    <div class="settlement-modal-subject">@_history.DriverName</div>
                    <div class="settlement-modal-figures">
                        <div class="settlement-modal-figure-row"><span>Current Outstanding Debt</span><strong>₱ @_history.CurrentOutstandingDebt.ToString("N0")</strong></div>
                    </div>

                    <div class="history-toolbar">
                        <label>Filter by date:
                            <select class="text-input" @bind="_historyDateFilter">
                                <option value="10">Last 10 Days</option>
                                <option value="30">Last 30 Days</option>
                                <option value="0">All Time</option>
                            </select>
                        </label>
                        <button class="outline-btn" type="button" @onclick="ExportHistoryCsv">⬇ Export</button>
                    </div>

                    <div class="data-table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Transaction Type</th>
                                    <th>Expected</th>
                                    <th>Amount Paid</th>
                                    <th>Running Debt</th>
                                    <th>Receipt</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (FilteredHistoryTransactions.Count == 0)
                                {
                                    <tr><td colspan="6" class="table-empty">No transactions in this range.</td></tr>
                                }
                                else
                                {
                                    @foreach (LedgerTransaction tx in FilteredHistoryTransactions)
                                    {
                                        <tr>
                                            <td>@tx.Timestamp.ToPhilippineTime().ToString("MMM d, yyyy")</td>
                                            <td>
                                                <div class="history-type @HistoryTypeCss(tx)">@tx.TransactionType</div>
                                                @if (tx.Subtitle is not null)
                                                {
                                                    <div class="history-sub">@tx.Subtitle</div>
                                                }
                                                @foreach (string line in tx.Details)
                                                {
                                                    <div class="history-allocation">@line</div>
                                                }
                                            </td>
                                            <td>@(tx.Expected.HasValue ? $"₱ {tx.Expected.Value:N0}" : "–")</td>
                                            <td>
                                                @if (tx.AmountPaid.HasValue)
                                                {
                                                    @($"₱ {tx.AmountPaid.Value:N0}")
                                                }
                                                else if (tx.AdjustmentAmount.HasValue)
                                                {
                                                    @($"{(tx.AdjustmentAmount.Value >= 0 ? "+" : "-")}₱ {Math.Abs(tx.AdjustmentAmount.Value):N0}")
                                                }
                                                else
                                                {
                                                    @:–
                                                }
                                            </td>
                                            <td>₱ @tx.RunningDebt.ToString("N0")</td>
                                            <td>
                                                @if (tx.ReceiptUrl is not null)
                                                {
                                                    <a class="history-receipt" href="@tx.ReceiptUrl" target="_blank" rel="noopener" title="@(tx.ReceiptReferenceNo is null ? "Open GCash receipt" : $"Ref. No. {tx.ReceiptReferenceNo}")">
                                                        <img src="@tx.ReceiptUrl" alt="GCash receipt" loading="lazy" />
                                                    </a>
                                                }
                                                else
                                                {
                                                    @:–
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    // True until the first data load finishes. Access itself is enforced server-side by [Authorize].
    private bool _isLoading = true;
    private IJSObjectReference? _fileDownloadModule;

    private string _activeTab = "daily";

    private DailySettlementSnapshot? _snapshot;
    private string? _settlementError;

    private DebtLedgerSnapshot? _ledgerSnapshot;
    private string? _ledgerError;

    private List<DriverRosterEntry>? _driverOptions;

    private bool _isExportingCsv;
    private string? _exportError;

    private bool _showPaymentModal;
    private SettlementRow? _paymentRow;
    private decimal _paymentAmountInput;

    // Amount checks (InputValidator) - one handover is never more than this, so a bigger number
    // is a typo (an extra zero) rather than a real payment.
    private const decimal MaxPayment = 100_000m;
    private const decimal MaxAdjustment = 50_000m;
    private string? PaymentAmountError => InputValidator.ValidateAmount(_paymentAmountInput, "the amount received", MaxPayment);
    private string? SettleAmountError => InputValidator.ValidateAmount(_settleAmountInput, "the amount received", MaxPayment);
    private string? AdjustmentAmountError => InputValidator.ValidateAmount(_adjustmentAmountInput, "the amount", MaxAdjustment);
    private string? AdjustmentReasonError => InputValidator.ValidateText(_adjustmentReason, "a reason", 300, required: true, minLength: 5);
    private string _paymentMethod = "Cash";
    private bool _isSavingPayment;
    private string? _paymentError;

    private bool _showAdjustmentModal;
    private string _adjustmentDriverId = string.Empty;
    private string _adjustmentDirection = "Add";
    private decimal _adjustmentAmountInput;
    private string _adjustmentReason = string.Empty;
    private bool _isSavingAdjustment;
    private string? _adjustmentError;

    private bool _showSettleModal;
    private DebtLedgerRow? _settleRow;
    private decimal _settleAmountInput;
    private string _settleMethod = "Cash";
    private bool _isSavingSettle;
    private string? _settleError;

    private bool _showHistoryModal;
    private DriverLedgerHistory? _history;
    private string _historyDateFilter = "10";

    private decimal PaymentRemaining => _paymentRow?.Balance ?? 0;

    private SettlementStatus PreviewStatus
    {
        get
        {
            if (_paymentRow is null)
            {
                return SettlementStatus.Waiting;
            }

            decimal totalPaid = _paymentRow.AmountPaid + _paymentRow.CreditApplied + Math.Max(0, _paymentAmountInput);
            if (totalPaid >= _paymentRow.ExpectedTotal)
            {
                return SettlementStatus.Cleared;
            }

            return totalPaid > 0 ? SettlementStatus.Partial : SettlementStatus.Waiting;
        }
    }

    private decimal PreviewShortfall => Math.Max(0, PaymentRemaining - Math.Max(0, _paymentAmountInput));

    // What the driver owes apart from this shift (older unpaid shifts + adjustment debt, net of
    // overpayment credit) - loaded when Record Payment opens; null while loading. Money above
    // this shift's balance goes there (paper: carried debt is added onto the day's rent).
    private decimal? _paymentOtherDebt;

    private decimal PaymentExtra => Math.Max(0, Math.Max(0, _paymentAmountInput) - PaymentRemaining);

    // Above this shift and all older debt: kept as advance credit toward the next boundary.
    private decimal PaymentAdvance => _paymentOtherDebt is decimal other ? Math.Max(0, PaymentExtra - other) : 0;

    private decimal SettlePreviewRemaining => _settleRow is null
        ? 0
        : Math.Max(0, _settleRow.TotalDebt - Math.Max(0, _settleAmountInput));

    private decimal SettlePreviewOverpaid => _settleRow is null
        ? 0
        : Math.Max(0, Math.Max(0, _settleAmountInput) - _settleRow.TotalDebt);

    private List<LedgerTransaction> FilteredHistoryTransactions
    {
        get
        {
            if (_history is null)
            {
                return new List<LedgerTransaction>();
            }

            if (_historyDateFilter == "0")
            {
                return _history.Transactions;
            }

            int days = int.Parse(_historyDateFilter);
            DateTime cutoff = DateTime.UtcNow.AddDays(-days);
            return _history.Transactions.Where(t => t.Timestamp >= cutoff).ToList();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }


        await LoadSettlementAsync();

        try
        {
            _driverOptions = (await DriverManagement.GetRosterSnapshotAsync()).Drivers;
        }
        catch
        {
            // Adjustment modal's driver dropdown just stays empty - not worth surfacing a
            // second warning banner for a page whose primary data already loaded fine.
        }

        _isLoading = false;
        StateHasChanged();
    }

    // The Philippine calendar day Daily Settlements shows - today by default. Shifts are filed
    // under the day they started, so a shift that ran past midnight is on the previous day.
    private DateTime _settlementDay = PhilippineTime.Now.Date;
    private bool _isLoadingSettlement;
    private bool IsSettlementToday => _settlementDay >= PhilippineTime.Now.Date;

    private async Task LoadSettlementAsync()
    {
        _isLoadingSettlement = true;
        try
        {
            // Noon PH time on that day, as UTC - GetDailySettlementAsync works out the PH day from it.
            DateTime dayUtc = DateTime.SpecifyKind(_settlementDay.AddHours(12) - PhilippineTime.Offset, DateTimeKind.Utc);
            _snapshot = await Ledger.GetDailySettlementAsync(dayUtc);
            _settlementError = null;
        }
        catch (Exception ex)
        {
            _settlementError = ex.Message;
        }
        finally
        {
            _isLoadingSettlement = false;
        }
    }

    /// <summary>-1 / +1 = previous / next day; 0 = back to today.</summary>
    private async Task ShiftSettlementDayAsync(int days)
    {
        DateTime today = PhilippineTime.Now.Date;
        DateTime target = days == 0 ? today : _settlementDay.AddDays(days);
        _settlementDay = target > today ? today : target;
        await LoadSettlementAsync();
    }

    private async Task OnSettlementDayPickedAsync(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime picked))
        {
            DateTime today = PhilippineTime.Now.Date;
            _settlementDay = picked.Date > today ? today : picked.Date;
            await LoadSettlementAsync();
        }
    }

    // Both tabs read the same boundary_payments documents, so switching tabs always reloads -
    // a payment recorded in one shows up in the other.
    private async Task SelectTabAsync(string tab)
    {
        _activeTab = tab;
        if (tab == "master")
        {
            await LoadLedgerAsync();
        }
        else
        {
            await LoadSettlementAsync();
        }
    }

    private async Task LoadLedgerAsync()
    {
        try
        {
            _ledgerSnapshot = await Ledger.GetDebtLedgerAsync();
            _ledgerError = null;
        }
        catch (Exception ex)
        {
            _ledgerError = ex.Message;
        }
    }

    private async Task OpenPaymentModalAsync(SettlementRow row)
    {
        _paymentRow = row;
        _paymentAmountInput = Math.Max(0, row.ExpectedTotal - row.AmountPaid);
        _paymentMethod = "Cash";
        _paymentError = null;
        _paymentOtherDebt = null;
        _ = ResetReceiptAsync();
        _showPaymentModal = true;
        StateHasChanged();

        try
        {
            _paymentOtherDebt = await Ledger.GetOtherDebtForShiftAsync(row.ShiftId);
        }
        catch (Exception ex)
        {
            _paymentError = $"Couldn't load this driver's other debt: {ex.Message}";
        }
    }

    private void ClosePaymentModal()
    {
        _showPaymentModal = false;
        _paymentRow = null;
        _ = ResetReceiptAsync();
    }

    // -- GCash receipt OCR -------------------------------------------------
    // The driver pays online and sends the manager a screenshot of the GCash receipt; the
    // manager uploads it here, the browser OCRs it (ocr.js) and GcashReceiptParser
    // fills in Amount / Date / Reference No. for the manager to check. The fields stay
    // editable since OCR can misread.

    private const long MaxReceiptBytes = 10 * 1024 * 1024;

    private IJSObjectReference? _receiptOcrModule;
    private InputFile? _receiptInput;

    // The scanned receipt image, uploaded with the payment on Confirm (see PaymentReceipt).
    private byte[]? _pendingReceiptImage;
    private string _pendingReceiptType = "image/jpeg";

    /// <summary>A GCash payment can only be confirmed with a scanned receipt whose amount was
    /// read and matches Amount Received.</summary>
    private bool IsReceiptReady =>
        _pendingReceiptImage is not null && _receiptAmountValue is > 0 && !ReceiptAmountMismatch && !_isReadingReceipt;

    private PaymentReceipt? PendingReceipt() =>
        _pendingReceiptImage is null ? null : new PaymentReceipt(_pendingReceiptImage, _pendingReceiptType, _receiptReference);

    // Switching to GCash takes the amount from the scanned receipt (none yet = 0); switching
    // back to cash leaves it editable.
    private void SetPaymentMethod(string method)
    {
        _paymentMethod = method;
        if (method == "EWallet")
        {
            _paymentAmountInput = _receiptAmountValue ?? 0;
        }
    }

    private void SetSettleMethod(string method)
    {
        _settleMethod = method;
        if (method == "EWallet")
        {
            _settleAmountInput = _receiptAmountValue ?? 0;
        }
    }
    private bool _isReadingReceipt;
    private string? _receiptError;
    private string? _receiptPreviewUrl;
    private string _receiptAmount = string.Empty;
    private string _receiptDate = string.Empty;
    private string _receiptReference = string.Empty;

    private decimal? _receiptAmountValue =>
        decimal.TryParse(_receiptAmount.Replace(",", string.Empty).Replace("₱", string.Empty).Trim(),
            System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out decimal v) ? v : null;

    // Only one payment window is open at a time, so they share the scanner and its state;
    // this is the Amount Received of whichever one is open.
    private decimal ReceiptCompareAmount => _showSettleModal ? _settleAmountInput : _paymentAmountInput;

    private bool ReceiptAmountMismatch =>
        _receiptAmountValue is decimal amount && ReceiptCompareAmount > 0 && amount != ReceiptCompareAmount;

    /// <summary>Receipt upload + OCR'd Amount / Date / Reference No. - shown in both Record
    /// Payment (Daily Settlements) and Settle Debt (Master Debt Ledger) when E-Wallet is picked.</summary>
    private RenderFragment ReceiptScanSection => @<text>
        <div class="receipt-scan-row">
            <label class="receipt-scan-btn @(_isReadingReceipt ? "busy" : "")" for="gcash-receipt-input">
                <span aria-hidden="true">📷</span> @(_isReadingReceipt ? "Reading receipt…" : _receiptPreviewUrl is null ? "Scan receipt" : "Scan another")
            </label>
            <InputFile id="gcash-receipt-input" class="receipt-file-input" accept="image/*"
                       disabled="@_isReadingReceipt" OnChange="OnReceiptSelectedAsync" @ref="_receiptInput" />
        </div>

        @if (_receiptPreviewUrl is not null)
        {
            <a class="receipt-preview" href="@_receiptPreviewUrl" target="_blank" rel="noopener" title="Open full-size receipt">
                <img src="@_receiptPreviewUrl" alt="Uploaded GCash receipt" />
            </a>
        }

        <div class="report-section receipt-details">
            <label>Receipt Details</label>
            <input class="text-input" type="text" placeholder="Amount (read from the receipt)" value="@_receiptAmount" readonly />
            <input class="text-input" type="text" placeholder="Date (read from the receipt)" value="@_receiptDate" readonly />
            <input class="text-input" type="text" placeholder="Reference No. (read from the receipt)" value="@_receiptReference" readonly />
        </div>

        @if (_receiptError is not null)
        {
            <div class="report-error">@_receiptError</div>
        }
        else if (ReceiptAmountMismatch)
        {
            <div class="receipt-mismatch">Receipt shows ₱ @_receiptAmountValue!.Value.ToString("N2"), but Amount Received is ₱ @ReceiptCompareAmount.ToString("N2") - they must match to confirm.</div>
        }
        else if (_pendingReceiptImage is null && !_isReadingReceipt)
        {
            <small class="receipt-hint">Scan the driver's GCash receipt - the amount received is taken from it.</small>
        }
        else if (_pendingReceiptImage is not null && _receiptAmountValue is null && !_isReadingReceipt)
        {
            <div class="receipt-mismatch">No amount could be read from this receipt - scan a clearer image.</div>
        }
    </text>;

    private async Task OnReceiptSelectedAsync(InputFileChangeEventArgs e)
    {
        _isReadingReceipt = true;
        _receiptError = null;
        _pendingReceiptImage = null;
        _receiptAmount = string.Empty;
        _receiptDate = string.Empty;
        _receiptReference = string.Empty;
        StateHasChanged();

        try
        {
            if (e.File.Size > MaxReceiptBytes)
            {
                _receiptError = "That image is over 10 MB - use a smaller screenshot.";
                return;
            }

            using var buffer = new MemoryStream();
            await e.File.OpenReadStream(MaxReceiptBytes).CopyToAsync(buffer);
            _pendingReceiptImage = buffer.ToArray();
            _pendingReceiptType = string.IsNullOrEmpty(e.File.ContentType) ? "image/jpeg" : e.File.ContentType;

            _receiptOcrModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/ocr.js");

            // First scan downloads the OCR engine + language data, so allow well past the
            // default 60s JS interop timeout on a slow connection.
            ReceiptOcrResult? ocr = await _receiptOcrModule.InvokeAsync<ReceiptOcrResult?>(
                "readImage", TimeSpan.FromMinutes(3), _receiptInput!.Element);
            if (ocr is null)
            {
                return;
            }

            await ReleasePreviewAsync();
            _receiptPreviewUrl = ocr.PreviewUrl;

            GcashReceiptParser.Result parsed = GcashReceiptParser.ParseBest(ocr.Texts);
            _receiptAmount = parsed.Amount?.ToString("N2") ?? string.Empty;
            _receiptDate = parsed.Date is DateTime d
                ? (d.TimeOfDay == TimeSpan.Zero ? d.ToString("MMM d, yyyy") : d.ToString("MMM d, yyyy h:mm tt"))
                : string.Empty;
            _receiptReference = parsed.ReferenceNumber ?? string.Empty;

            // The receipt is the payment, so its amount is what was received - fill it in
            // (still editable) for whichever window is open.
            decimal receiptAmount = parsed.Amount is decimal a && a > 0 ? a : 0;
            if (_showSettleModal)
            {
                _settleAmountInput = receiptAmount;
            }
            else
            {
                _paymentAmountInput = receiptAmount;
            }

            if (parsed.Amount is null && parsed.Date is null && parsed.ReferenceNumber is null)
            {
                _receiptError = "Couldn't find an amount, date or reference number on this image - is it a GCash receipt? Try a clearer screenshot.";
            }
        }
        catch (Exception ex)
        {
            _receiptError = $"Couldn't read this receipt: {ex.Message}";
        }
        finally
        {
            _isReadingReceipt = false;
        }
    }

    private async Task ResetReceiptAsync()
    {
        _pendingReceiptImage = null;
        _receiptError = null;
        _receiptAmount = string.Empty;
        _receiptDate = string.Empty;
        _receiptReference = string.Empty;
        _isReadingReceipt = false;
        await ReleasePreviewAsync();
    }

    private async Task ReleasePreviewAsync()
    {
        string? url = _receiptPreviewUrl;
        _receiptPreviewUrl = null;
        if (url is not null && _receiptOcrModule is not null)
        {
            try { await _receiptOcrModule.InvokeVoidAsync("releasePreview", url); } catch (JSDisconnectedException) { }
        }
    }

    private sealed class ReceiptOcrResult
    {
        public List<string> Texts { get; set; } = new();
        public string PreviewUrl { get; set; } = string.Empty;
    }

    private async Task ConfirmPaymentAsync()
    {
        if (_paymentRow is null || PaymentAmountError is not null)
        {
            return;
        }

        _isSavingPayment = true;
        _paymentError = null;
        try
        {
            RecordPaymentResult result = await Ledger.RecordPaymentAsync(_paymentRow.ShiftId, _paymentAmountInput, _paymentMethod,
                _paymentMethod == "EWallet" ? PendingReceipt() : null);
            if (!result.Ok)
            {
                _paymentError = result.ErrorMessage ?? "Could not save this payment.";
                return;
            }

            _showPaymentModal = false;
            _paymentRow = null;
            _ = ResetReceiptAsync();
            await LoadSettlementAsync();
        }
        finally
        {
            _isSavingPayment = false;
        }
    }

    private void OpenAdjustmentModal()
    {
        _adjustmentDriverId = string.Empty;
        _adjustmentDirection = "Add";
        _adjustmentAmountInput = 0;
        _adjustmentReason = string.Empty;
        _adjustmentError = null;
        _showAdjustmentModal = true;
    }

    private void CloseAdjustmentModal() => _showAdjustmentModal = false;

    private async Task ConfirmAdjustmentAsync()
    {
        if (string.IsNullOrEmpty(_adjustmentDriverId) || AdjustmentAmountError is not null || AdjustmentReasonError is not null)
        {
            return;
        }

        _isSavingAdjustment = true;
        _adjustmentError = null;
        try
        {
            decimal signedAmount = _adjustmentDirection == "Credit" ? -_adjustmentAmountInput : _adjustmentAmountInput;
            AdjustmentResult result = await Ledger.AddAdjustmentAsync(_adjustmentDriverId, signedAmount, _adjustmentReason);
            if (!result.Ok)
            {
                _adjustmentError = result.ErrorMessage ?? "Could not save this adjustment.";
                return;
            }

            _showAdjustmentModal = false;
            if (_ledgerSnapshot is not null)
            {
                await LoadLedgerAsync();
            }
        }
        finally
        {
            _isSavingAdjustment = false;
        }
    }

    private void OpenSettleModal(DebtLedgerRow row)
    {
        _settleRow = row;
        // Deliberately NOT pre-filled to row.TotalDebt: that made every "Confirm Payment"
        // pay off the whole debt in one click (since managers naturally just click Confirm
        // without editing a pre-filled number), silently closing the row out and hiding
        // "Settle" (debt = 0) far sooner than intended. Blank forces a deliberate amount,
        // matching the mockup itself showing a partial typed-in amount, not the full balance.
        _settleAmountInput = 0;
        _settleMethod = "Cash";
        _settleError = null;
        _ = ResetReceiptAsync();
        _showSettleModal = true;
    }

    private void CloseSettleModal()
    {
        _showSettleModal = false;
        _settleRow = null;
        _ = ResetReceiptAsync();
    }

    private async Task ConfirmSettleAsync()
    {
        if (_settleRow is null || SettleAmountError is not null)
        {
            return;
        }

        _isSavingSettle = true;
        _settleError = null;
        try
        {
            SettleDebtResult result = await Ledger.SettleDebtAsync(_settleRow.DriverId, _settleAmountInput, _settleMethod,
                _settleMethod == "EWallet" ? PendingReceipt() : null);
            if (!result.Ok)
            {
                _settleError = result.ErrorMessage ?? "Could not save this settlement.";
                return;
            }

            _showSettleModal = false;
            _settleRow = null;
            _ = ResetReceiptAsync();
            // Settling pays off the driver's oldest shifts' boundary_payments - the same
            // documents Daily Settlements shows - so refresh both.
            await LoadLedgerAsync();
            await LoadSettlementAsync();
        }
        finally
        {
            _isSavingSettle = false;
        }
    }

    private async Task OpenHistoryModalAsync(DebtLedgerRow row)
    {
        _showHistoryModal = true;
        _history = null;
        _historyDateFilter = "10";
        StateHasChanged();

        try
        {
            _history = await Ledger.GetDriverHistoryAsync(row.DriverId);
        }
        catch (Exception ex)
        {
            _ledgerError = $"History unavailable: {ex.Message}";
            _showHistoryModal = false;
        }
    }

    private void CloseHistoryModal()
    {
        _showHistoryModal = false;
        _history = null;
    }

    private static string HistoryTypeCss(LedgerTransaction tx) => tx.TransactionType switch
    {
        "Payment" => "payment",
        "Boundary Due" => "due",
        "Penalty" => "penalty",
        _ => "credit",
    };

    private async Task ExportHistoryCsv()
    {
        if (_history is null)
        {
            return;
        }

        var headers = new[] { "Date", "Transaction Type", "Details", "Expected", "Amount Paid", "Running Debt" };
        var rows = FilteredHistoryTransactions.Select(t => new object?[]
        {
            t.Timestamp.ToPhilippineTime().ToString("yyyy-MM-dd"),
            t.TransactionType,
            string.Join("; ", new[] { t.Subtitle }.Concat(t.Details).Where(x => !string.IsNullOrEmpty(x))),
            t.Expected,
            t.AmountPaid ?? t.AdjustmentAmount,
            t.RunningDebt,
        });

        string csv = BuildCsv(headers, rows);
        string fileName = $"Financial_History_{_history.DriverName.Replace(" ", "_")}_{DateTime.UtcNow:yyyyMMdd}.csv";

        _fileDownloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/file-download.js");
        await _fileDownloadModule.InvokeVoidAsync("downloadFile", fileName, csv, "text/csv");
    }

    private async Task ExportCsvAsync()
    {
        _exportError = null;
        _isExportingCsv = true;
        try
        {
            string csv;
            string fileName;

            if (_activeTab == "master")
            {
                DebtLedgerSnapshot snapshot = _ledgerSnapshot ?? await Ledger.GetDebtLedgerAsync();
                var headers = new[] { "Driver", "Unit", "UnpaidDays", "LastPaymentDate", "LastPaymentAmount", "Debt" };
                var rows = snapshot.Rows.Select(r => new object?[]
                {
                    r.DriverName, r.TaxiId, r.UnpaidCount,
                    r.LastPaymentDate.ToPhilippineTime()?.ToString("yyyy-MM-dd"), r.LastPaymentAmount, r.TotalDebt,
                });
                csv = BuildCsv(headers, rows);
                fileName = $"Master_Debt_Ledger_{DateTime.UtcNow:yyyyMMdd}.csv";
            }
            else
            {
                DateTime dayStart = DateTime.SpecifyKind(DateTime.UtcNow.Date, DateTimeKind.Utc);
                DateTime dayEnd = dayStart.AddDays(1).AddTicks(-1);
                csv = await FleetReporting.BuildReportCsvAsync("Financial Summary", dayStart, dayEnd);
                fileName = $"Daily_Settlements_{dayStart:yyyyMMdd}.csv";
            }

            _fileDownloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/file-download.js");
            await _fileDownloadModule.InvokeVoidAsync("downloadFile", fileName, csv, "text/csv");
        }
        catch (Exception ex)
        {
            _exportError = $"Export failed: {ex.Message}";
        }
        finally
        {
            _isExportingCsv = false;
        }
    }

    private static string BuildCsv(IEnumerable<string> headers, IEnumerable<object?[]> rows)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine(string.Join(',', headers.Select(CsvEscape)));
        foreach (object?[] row in rows)
        {
            sb.AppendLine(string.Join(',', row.Select(v => CsvEscape(v?.ToString() ?? string.Empty))));
        }
        return sb.ToString();
    }

    private static string CsvEscape(string value) =>
        value.IndexOfAny(new[] { ',', '"', '\n', '\r' }) >= 0
            ? "\"" + value.Replace("\"", "\"\"") + "\""
            : value;

    private static string Initials(string fullName)
    {
        string[] parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return "?";
        }
        if (parts.Length == 1)
        {
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        }
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private static string StatusCss(SettlementStatus status) => status switch
    {
        SettlementStatus.Cleared => "status-success",
        SettlementStatus.Partial => "status-warning",
        _ => "status-neutral",
    };
}
