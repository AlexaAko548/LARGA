            _isSavingSettle = false;
        }
    }

    private async Task OpenHistoryModalAsync(DebtLedgerRow row)
    {
        _showHistoryModal = true;
        _history = null;
        _historyDateFilter = "10";
        StateHasChanged();

        try
        {
            _history = await Ledger.GetDriverHistoryAsync(row.DriverId);
        }
        catch (Exception ex)
        {
            _ledgerError = $"History unavailable: {ex.Message}";
            _showHistoryModal = false;
        }
    }

    private void CloseHistoryModal()
    {
        _showHistoryModal = false;
        _history = null;
    }

    private async Task ExportHistoryCsv()
    {
        if (_history is null)
        {
            return;
        }

        var headers = new[] { "Date", "Transaction Type", "Expected", "Amount Paid", "Running Debt" };
        var rows = FilteredHistoryTransactions.Select(t => new object?[]
        {
            t.Timestamp.ToPhilippineTime().ToString("yyyy-MM-dd"),
            t.TransactionType,
            t.Expected,
            t.AmountPaid ?? t.AdjustmentAmount,
            t.RunningDebt,
        });

        string csv = BuildCsv(headers, rows);
        string fileName = $"Financial_History_{_history.DriverName.Replace(" ", "_")}_{DateTime.UtcNow:yyyyMMdd}.csv";

        _fileDownloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/file-download.js");
        await _fileDownloadModule.InvokeVoidAsync("downloadFile", fileName, csv, "text/csv");
    }

    private async Task ExportCsvAsync()
    {
        _exportError = null;
        _isExportingCsv = true;
        try
        {
            string csv;
            string fileName;

            if (_activeTab == "master")
            {
                DebtLedgerSnapshot snapshot = _ledgerSnapshot ?? await Ledger.GetDebtLedgerAsync();
                var headers = new[] { "Driver", "Unit", "UnpaidDays", "LastPaymentDate", "LastPaymentAmount", "Debt" };
                var rows = snapshot.Rows.Select(r => new object?[]
                {
                    r.DriverName, r.TaxiId, r.UnpaidCount,
                    r.LastPaymentDate.ToPhilippineTime()?.ToString("yyyy-MM-dd"), r.LastPaymentAmount, r.TotalDebt,
                });
                csv = BuildCsv(headers, rows);
                fileName = $"Master_Debt_Ledger_{DateTime.UtcNow:yyyyMMdd}.csv";
            }
            else
            {
                DateTime dayStart = DateTime.SpecifyKind(DateTime.UtcNow.Date, DateTimeKind.Utc);
                DateTime dayEnd = dayStart.AddDays(1).AddTicks(-1);
                csv = await FleetReporting.BuildReportCsvAsync("Financial Summary", dayStart, dayEnd);
                fileName = $"Daily_Settlements_{dayStart:yyyyMMdd}.csv";
            }

            _fileDownloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/file-download.js");
            await _fileDownloadModule.InvokeVoidAsync("downloadFile", fileName, csv, "text/csv");
        }
        catch (Exception ex)
        {
            _exportError = $"Export failed: {ex.Message}";
        }
        finally
        {
            _isExportingCsv = false;
        }
    }

    private static string BuildCsv(IEnumerable<string> headers, IEnumerable<object?[]> rows)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine(string.Join(',', headers.Select(CsvEscape)));
        foreach (object?[] row in rows)
        {
            sb.AppendLine(string.Join(',', row.Select(v => CsvEscape(v?.ToString() ?? string.Empty))));
        }
        return sb.ToString();
    }

    private static string CsvEscape(string value) =>
        value.IndexOfAny(new[] { ',', '"', '\n', '\r' }) >= 0
            ? "\"" + value.Replace("\"", "\"\"") + "\""
            : value;

    private static string Initials(string fullName)
    {
        string[] parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return "?";
        }
        if (parts.Length == 1)
        {
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        }
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private static string StatusCss(SettlementStatus status) => status switch
    {
        SettlementStatus.Cleared => "status-success",
        SettlementStatus.Partial => "status-warning",
        _ => "status-neutral",
    };
