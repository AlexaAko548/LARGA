@page "/forgot-password"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@using System.Text.Json
@inject IJSRuntime JS

<PageTitle>Forgot password - web</PageTitle>

<div class="auth-page">
        <div class="back-link">
            <a href="/login"><Icon Name="arrow-left" /> Back to Sign In</a>
        </div>

        <EditForm Model="_model" FormName="manager-forgot-password" OnValidSubmit="SendResetAsync" class="auth-card">
            <DataAnnotationsValidator />

            <div class="brand-lockup">
                <img class="mini-logo" src="/images/larga-logo-taxi.png" alt="LARGA Fleet OS logo" />
                <div class="brand-title">Manager Portal</div>
            </div>

            <h2>Reset your password</h2>
            <p>Enter your manager account's email and we'll send you a link to set a new password.</p>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="login-error">@_errorMessage</div>
            }

            @if (_sent)
            {
                <div class="field-ok">If an account exists for that email, a reset link is on its way. Check your inbox (and spam folder).</div>
            }

            <div class="form-block">
                <label for="email">EMAIL ADDRESS</label>
                <InputText id="email" @bind-Value="_model.Email" class="form-control" type="email" maxlength="254" placeholder="manager@company.com" />
                <ValidationMessage For="() => _model.Email" class="field-error" />
            </div>

            <button class="primary-btn full-width" type="submit" disabled="@_isSubmitting">
                @(_isSubmitting ? "SENDING..." : "SEND RESET LINK")
            </button>
        </EditForm>
</div>

@code {
    private readonly ForgotPasswordModel _model = new();
    private bool _isSubmitting;
    private bool _sent;
    private string? _errorMessage;

    private async Task SendResetAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;
        _sent = false;
        try
        {
            IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "/firebase-auth.js");
            JsonElement result = await module.InvokeAsync<JsonElement>("largaFirebaseSendPasswordReset", _model.Email.Trim());

            // The page never says whether the email has an account (largaFirebaseSendPasswordReset
            // reports "ok" for unknown emails too), so it can't be used to find accounts.
            if (result.TryGetProperty("ok", out JsonElement ok) && ok.ValueKind == JsonValueKind.True)
            {
                _sent = true;
            }
            else
            {
                _errorMessage = result.TryGetProperty("message", out JsonElement message) && message.ValueKind == JsonValueKind.String
                    ? message.GetString()
                    : "Could not send the reset email. Please try again.";
            }
        }
        catch (JSException)
        {
            _errorMessage = "Could not send the reset email. Please try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private class ForgotPasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter your email address.")]
        [LARGA.ManagerWeb.Validation.StrictEmail]
        public string Email { get; set; } = string.Empty;
    }
}
