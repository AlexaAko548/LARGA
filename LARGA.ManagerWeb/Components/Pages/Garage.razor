    private async Task OpenPartsModalAsync(WorkOrderEntry workOrder)
    {
        _partsWorkOrder = workOrder;
        _partRows = new List<PartUsageRow> { new() };
        _partsError = null;
        _availableParts = null;
        _showPartsModal = true;

        try
        {
            _availableParts = await InventoryAudit.GetSparePartsAsync();
        }
        catch (Exception ex)
        {
            _partsError = $"Spare parts unavailable: {ex.Message}";
            _availableParts = new List<SparePart>();
        }
    }

    private void CloseLogPartsModal()
    {
        _showPartsModal = false;
        _partsWorkOrder = null;
        _availableParts = null;
        _partRows = new List<PartUsageRow>();
        _partsError = null;
    }

    private void AddPartRow() => _partRows.Add(new PartUsageRow());

    private void RemovePartRow(PartUsageRow row)
    {
        _partRows.Remove(row);
        if (_partRows.Count == 0)
        {
            _partRows.Add(new PartUsageRow());
        }
    }

    private async Task ConfirmLogPartsAsync()
    {
        if (_partsWorkOrder is null || _availableParts is null)
        {
            return;
        }

        _partsError = null;

        // Add up quantities per part first, so a part listed on two rows is checked against stock once.
        var totals = new Dictionary<string, int>();
        foreach (PartUsageRow row in _partRows)
        {
            if (string.IsNullOrWhiteSpace(row.PartId))
            {
                _partsError = "Pick a part for every row, or remove the empty ones.";
                return;
            }
            if (row.Quantity <= 0)
            {
                _partsError = "Each quantity must be more than zero.";
                return;
            }
            totals[row.PartId] = totals.GetValueOrDefault(row.PartId) + row.Quantity;
        }

        // The service clamps stock at zero rather than refusing, so block over-use here.
        var usage = new List<(string PartId, int Quantity)>();
        foreach ((string partId, int quantity) in totals)
        {
            SparePart? part = _availableParts.FirstOrDefault(p => p.PartId == partId);
            if (part is null)
            {
                _partsError = "One of the selected parts no longer exists. Reopen this form and try again.";
                return;
            }
            if (quantity > part.StockQuantity)
            {
                _partsError = $"Only {part.StockQuantity} {part.Unit} of {part.PartName} left in stock.";
                return;
            }
            usage.Add((partId, quantity));
        }

        _isSavingParts = true;
        try
        {
            GarageActionResult result = await GarageService.LogPartsUsedAsync(_partsWorkOrder.MaintenanceId, usage, _managerUserId);
            if (!result.Ok)
            {
                _partsError = result.ErrorMessage ?? "Could not log these parts.";
                return;
            }

            CloseLogPartsModal();
        }
        finally
        {
            _isSavingParts = false;
        }
    }

    private async Task OpenScheduleModal(RoutineCheckEntry check)
    {
        _scheduleCheck = check;
        _scheduleMode = "Auto";
        _scheduleDate = null;
        _scheduleError = null;
        _showScheduleModal = true;
        await RefreshAutoDateAsync();
    }

    private async Task SelectScheduleModeAsync(string mode)
    {
        _scheduleMode = mode;
        if (mode == "Auto")
        {
            await RefreshAutoDateAsync();
        }
        else
        {
            // Manual: seed with tomorrow if nothing's picked yet, otherwise leave whatever
            // Auto had already found - a reasonable starting point either way.
            _scheduleDate ??= DateTime.UtcNow.Date.AddDays(1);
        }
    }

    private async Task RefreshAutoDateAsync()
    {
        _isLoadingAutoDate = true;
        StateHasChanged();
        try
        {
            _scheduleDate = await GarageService.GetNextAvailableScheduleDateAsync();
        }
        finally
        {
            _isLoadingAutoDate = false;
        }
    }

    private void CloseScheduleModal()
    {
        _showScheduleModal = false;
        _scheduleCheck = null;
    }

    private async Task ConfirmScheduleAsync()
    {
        if (_scheduleCheck is null || !_scheduleDate.HasValue)
        {
            return;
        }

        _isSavingSchedule = true;
        _scheduleError = null;
        try
        {
            DateTime scheduledUtc = DateTime.SpecifyKind(_scheduleDate.Value, DateTimeKind.Utc);
            GarageActionResult result = await GarageService.ScheduleRoutineCheckAsync(_scheduleCheck.CheckId, scheduledUtc);
            if (!result.Ok)
            {
                _scheduleError = result.ErrorMessage ?? "Could not schedule this check.";
                return;
            }

            _ = DriverNotifier.NotifyUnitBookedForShopAsync(_scheduleCheck.TaxiId, _scheduleDate.Value.Date, _scheduleDate.Value.Date, _scheduleCheck.CheckName);

            _showScheduleModal = false;
            _scheduleCheck = null;
            await LoadSnapshotAsync();
        }
        finally
        {
            _isSavingSchedule = false;
        }
    }

    private async Task OpenHistoryModalAsync()
    {
        _showHistoryModal = true;
        _history = null;
        StateHasChanged();

        try
        {
            _history = await GarageService.GetHistoryAsync();
        }
        catch (Exception ex)
        {
            _actionError = $"History unavailable: {ex.Message}";
            _showHistoryModal = false;
        }
    }

    private void CloseHistoryModal() => _showHistoryModal = false;

    private static string PriorityCss(PriorityLevel priority) => priority switch
    {
        PriorityLevel.High => "priority-high",
        PriorityLevel.Medium => "priority-medium",
        _ => "priority-low",
    };
