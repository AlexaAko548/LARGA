@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<div style="height: 100vh; display: flex; justify-content: center; align-items: center; background-color: #f8f9fa;">
    <span style="color: #4a5568; font-weight: bold;">Verifying secure session...</span>
</div>

@code {
    protected override void OnInitialized()
    {
        string returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        string target = string.IsNullOrWhiteSpace(returnUrl)
            ? "/login"
            : $"/login?ReturnUrl=/{Uri.EscapeDataString(returnUrl)}";

        Navigation.NavigateTo(target, forceLoad: true, replace: true);
    }
}