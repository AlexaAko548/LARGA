{
  "name": "larga-rules-tests",
  "private": true,
  "description": "Firestore security rules tests for LARGA - run against the local Firebase emulator only.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-larga-rules \"mocha --timeout 20000 firestore.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase": "11.3.1",
    "firebase-tools": "13.35.1",
    "mocha": "10.8.2"
  }
}
