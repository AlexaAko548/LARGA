<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseMauiEssentials>true</UseMauiEssentials>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LARGA.Shared.Models\LARGA.Shared.Models.csproj" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Google.Cloud.Storage.V1" Version="4.10.0" />
		<!-- Only the Firebase modules the apps use (audit F-03). The "Plugin.Firebase" meta-package also
		     shipped Analytics (advertising ID, silent usage collection), Crashlytics, Functions, Remote
		     Config and App Check. Same versions the meta-package resolved to. Add Plugin.Firebase.AppCheck
		     back when App Check is rolled out (audit C-02). -->
		<PackageReference Include="Plugin.Firebase.Core" Version="4.1.0" />
		<PackageReference Include="Plugin.Firebase.Auth" Version="4.0.1" />
		<PackageReference Include="Plugin.Firebase.Firestore" Version="4.0.0" />
		<PackageReference Include="Plugin.Firebase.Storage" Version="4.0.0" />
		<PackageReference Include="Plugin.Firebase.CloudMessaging" Version="4.0.1" />
		<PackageReference Include="Google.Cloud.Firestore" Version="4.4.0" />
		<PackageReference Include="FirebaseAdmin" Version="3.6.0" />
		<!-- NotificationService.cs uses Microsoft.Maui.ApplicationModel.Permissions. Since
		     .NET 8, UseMauiEssentials=true (above) no longer auto-includes this package on
		     its own (MA002) - add it explicitly, pinned to the same version as MobileApp's
		     MauiVersion-based packages. -->
		<PackageReference Include="Microsoft.Maui.Essentials" Version="9.0.120" />
		<PackageReference Include="SkiaSharp" Version="3.119.2" />
	</ItemGroup>

</Project>
