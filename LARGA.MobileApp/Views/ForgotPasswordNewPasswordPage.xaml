<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels"
             x:Class="LARGA.MobileApp.Views.ForgotPasswordNewPasswordPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">

	<Grid RowDefinitions="7*, 3*">
		<!-- Top Blue Area -->
		<Border Grid.Row="0"
                BackgroundColor="{StaticResource LargaLightBlue}"
                StrokeShape="RoundRectangle 0,0,40,40"
                StrokeThickness="0">
			<Grid RowDefinitions="Auto, *">
				<Grid Grid.Row="0" Padding="20">
					<ImageButton Source="back_icon.png" HorizontalOptions="Start" WidthRequest="24" HeightRequest="24" BackgroundColor="Transparent" Clicked="OnBackButtonClicked" />
				</Grid>

				<VerticalStackLayout Grid.Row="1" Padding="30, 10, 30, 30" Spacing="15" VerticalOptions="Center">
					<Label Text="Forgot password"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="{StaticResource LargaDarkText}"
                           HorizontalOptions="Center"
                           Margin="0, 0, 0, 10" />

					<Label Text="Create your new account password."
                           HorizontalTextAlignment="Center"
                           FontSize="14"
                           TextColor="{StaticResource LargaDarkText}"
                           Margin="0, 0, 0, 30"/>

					<Border BackgroundColor="#0099CC" StrokeShape="RoundRectangle 10" StrokeThickness="0" HeightRequest="50">
						<Grid ColumnDefinitions="*, Auto" Padding="15, 0">
							<Entry x:Name="NewPasswordEntry" Placeholder="Enter new password" Text="{Binding NewPassword}" IsPassword="True" PlaceholderColor="White" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center" Grid.Column="0" />
							<ImageButton Source="eye_off.png" WidthRequest="20" HeightRequest="20" BackgroundColor="Transparent" Clicked="OnTogglePasswordClicked" VerticalOptions="Center" Grid.Column="1" />
						</Grid>
					</Border>

					<Border BackgroundColor="#0099CC" StrokeShape="RoundRectangle 10" StrokeThickness="0" HeightRequest="50">
						<Grid ColumnDefinitions="*, Auto" Padding="15, 0">
							<Entry x:Name="ConfirmPasswordEntry" Placeholder="Confirm new password" Text="{Binding ConfirmNewPassword}" IsPassword="True" PlaceholderColor="White" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center" Grid.Column="0" />
							<ImageButton Source="eye_off.png" WidthRequest="20" HeightRequest="20" BackgroundColor="Transparent" Clicked="OnToggleConfirmPasswordClicked" VerticalOptions="Center" Grid.Column="1" />
						</Grid>
					</Border>
				</VerticalStackLayout>
			</Grid>
		</Border>

		<!-- Bottom White Area -->
		<VerticalStackLayout Grid.Row="1" Padding="30" VerticalOptions="Center">
			<Button Text="Continue" Style="{StaticResource LargaButtonStyle}" Command="{Binding ResetPasswordCommand}" WidthRequest="200" HorizontalOptions="Center" />
		</VerticalStackLayout>
	</Grid>
</ContentPage>