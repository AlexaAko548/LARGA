<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             x:Class="LARGA.MobileApp.Views.Driver.DefectReportDetailPage"
             x:DataType="vm:DefectReportDetailViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource LargaWhite}">

    <ScrollView>
        <VerticalStackLayout Padding="20,0" Spacing="15">

            <Label Text="Report Details" FontSize="32" Margin="0,-10,0,0" Style="{StaticResource HeaderStyle}" TextColor="{StaticResource LargaDarkText}" />

            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10">
                <Label Text="{Binding Status}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" HorizontalTextAlignment="Center" />
            </Border>

            <!-- Title -->
            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Title" FontSize="12" TextColor="{StaticResource LargaDarkText}" />
                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" />
                </VerticalStackLayout>
            </Border>

            <!-- Description -->
            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Description" FontSize="12" TextColor="{StaticResource LargaDarkText}" />
                    <Label Text="{Binding Description}" FontSize="14" TextColor="{StaticResource LargaDarkText}" />
                </VerticalStackLayout>
            </Border>

            <!-- Priority + Date -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Priority" FontSize="12" TextColor="{StaticResource LargaDarkText}" />
                        <Label Text="{Binding Priority}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Date Logged" FontSize="12" TextColor="{StaticResource LargaDarkText}" />
                        <Label Text="{Binding DateLoggedDisplay}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Supporting Photo -->
            <Border IsVisible="{Binding HasPhoto}" BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Supporting Photo" FontSize="12" TextColor="{StaticResource LargaDarkText}" />
                    <Image Source="{Binding Photo}" HeightRequest="180" Aspect="AspectFit" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
