<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             xmlns:controls="clr-namespace:LARGA.MobileApp.Controls"
             xmlns:core="clr-namespace:LARGA.SharedCore;assembly=LARGA.SharedCore"
             x:Class="LARGA.MobileApp.Views.Driver.VehicleDefectPage"
             x:DataType="vm:VehicleDefectViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource ThemeSurface}">

    <ScrollView>
        <VerticalStackLayout Padding="20,0" Spacing="15" Margin="0,10">
            <Label Text="Submit Report" FontSize="32" Style="{StaticResource HeaderStyle}" TextColor="{DynamicResource LargaDarkText}" Margin="0,-10,0,0" />

            <Border Grid.Column="1" BackgroundColor="{DynamicResource LargaLightBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10">
                <Label Text="VEHICLE DEFECT" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource LargaDarkText}" HorizontalTextAlignment="Center" />
            </Border>

            <!-- Title Report -->
            <Border BackgroundColor="{DynamicResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Title Report" FontSize="12" TextColor="{DynamicResource LargaDarkText}" />
                    <Entry Text="{Binding TitleReport}" Placeholder="e.g. Flat Tire" BackgroundColor="{DynamicResource ThemeSurface}" />
                </VerticalStackLayout>
            </Border>

            <!-- Description -->
            <Border BackgroundColor="{DynamicResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Description" FontSize="12" TextColor="{DynamicResource LargaDarkText}" />
                    <Editor Text="{Binding Description}" Placeholder="Describe the issue..." HeightRequest="90" BackgroundColor="{DynamicResource ThemeSurface}" />
                </VerticalStackLayout>
            </Border>

            <!-- Priority Level -->
            <HorizontalStackLayout Spacing="6" Margin="0,5,0,0">
                <Label Text="PRIORITY LEVEL" FontSize="12" TextColor="{DynamicResource LargaDarkText}" VerticalOptions="Center" />
                <!-- Tap to show what each level means, tap again to hide it (same words as the web Garage). -->
                <Border WidthRequest="22" HeightRequest="22" StrokeThickness="1" Stroke="{DynamicResource LargaPrimaryBlue}"
                        StrokeShape="RoundRectangle 11" BackgroundColor="Transparent" VerticalOptions="Center"
                        SemanticProperties.Description="What the priority levels mean">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TogglePriorityHelpCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="i" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource LargaPrimaryBlue}"
                           HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                </Border>
            </HorizontalStackLayout>
            <Border IsVisible="{Binding IsPriorityHelpVisible}" BackgroundColor="{DynamicResource LargaLightBlue}"
                    StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="12">
                <VerticalStackLayout Spacing="6">
                    <Label FontSize="12" TextColor="{DynamicResource LargaDarkText}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Low: " FontAttributes="Bold" />
                                <Span Text="{x:Static core:PriorityLevelHelp.Low}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label FontSize="12" TextColor="{DynamicResource LargaDarkText}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Medium: " FontAttributes="Bold" />
                                <Span Text="{x:Static core:PriorityLevelHelp.Medium}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label FontSize="12" TextColor="{DynamicResource LargaDarkText}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="High: " FontAttributes="Bold" />
                                <Span Text="{x:Static core:PriorityLevelHelp.High}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="{x:Static core:PriorityLevelHelp.Note}" FontSize="12" TextColor="{DynamicResource ThemeTextGray}" />
                </VerticalStackLayout>
            </Border>
            <Border BackgroundColor="{DynamicResource LargaLightBlue}" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="5">
                <Grid ColumnDefinitions="*,*,*">
                    <RadioButton Grid.Column="0" Content="Low" IsChecked="{Binding IsLow}" GroupName="Priority" controls:ThemedRadio.IsEnabled="True" TextColor="{DynamicResource LargaDarkText}" HorizontalOptions="Center" />
                    <RadioButton Grid.Column="1" Content="Medium" IsChecked="{Binding IsMedium}" GroupName="Priority" controls:ThemedRadio.IsEnabled="True" TextColor="{DynamicResource LargaDarkText}" HorizontalOptions="Center" />
                    <RadioButton Grid.Column="2" Content="High" IsChecked="{Binding IsHigh}" GroupName="Priority" controls:ThemedRadio.IsEnabled="True" TextColor="{DynamicResource LargaDarkText}" HorizontalOptions="Center" />
                </Grid>
            </Border>

            <!-- Attach Photo -->
            <Border BackgroundColor="Transparent" StrokeThickness="1" Stroke="{DynamicResource LargaPrimaryBlue}" StrokeShape="RoundRectangle 20" Padding="0" HeightRequest="46">
                <Button Text="📷 Attach supporting photo"
                    Command="{Binding AttachPhotoCommand}"
                    BackgroundColor="Transparent" TextColor="{DynamicResource LargaPrimaryBlue}" FontSize="14" />
            </Border>

            <Border IsVisible="{Binding HasPhoto}" BackgroundColor="{DynamicResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Image Source="{Binding DefectPhoto}" HeightRequest="180" Aspect="AspectFit" />
                    <Button Text="🔄 Retake photo"
                        Command="{Binding AttachPhotoCommand}"
                        BackgroundColor="Transparent" TextColor="{DynamicResource LargaPrimaryBlue}" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsSubmitting}" IsVisible="{Binding IsSubmitting}"
                               Color="{DynamicResource LargaPrimaryBlue}" HeightRequest="28" Margin="0,15,0,0" />
            <Button Text="{Binding SubmitButtonText}"
                    Command="{Binding SubmitReportCommand}"
                    BackgroundColor="{DynamicResource LargaPrimaryBlue}" TextColor="{DynamicResource LargaWhite}"
                    CornerRadius="25" HeightRequest="55" FontSize="16" FontAttributes="Bold" Margin="0,15,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>