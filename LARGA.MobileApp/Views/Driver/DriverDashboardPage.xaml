<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             x:Class="LARGA.MobileApp.Views.Driver.DriverDashboardPage"
             x:DataType="vm:DriverDashboardViewModel"
             BackgroundColor="{StaticResource LargaWhite}"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <!-- Header -->
            <Label Text="{Binding CurrentDate}" TextColor="{StaticResource LargaDarkText}" FontSize="14" Margin="0,10,0,0" />
            <Label Text="{Binding WelcomeMessage}" Style="{StaticResource HeaderTitleStyle}" FontSize="35" LineHeight="1.1" />

            <!-- Status Card -->
            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="20">
                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                    <Ellipse Grid.Row="0" Grid.Column="0" Fill="{StaticResource LargaDarkText}" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" Margin="0,0,10,0" />

                    <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
                        <Label Text="Status:" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource LargaDarkText}" />
                        <Label Text="{Binding StatusText}" Style="{StaticResource StatusDataStyle}" TextColor="{Binding StatusColor}" FontSize="18" />
                    </HorizontalStackLayout>

                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding GpsStatusText}" TextColor="{StaticResource LargaDarkText}" FontSize="14" Margin="0,5,0,0" />
                </Grid>
            </Border>

            <!-- Assigned Unit Card -->
            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="ASSIGNED UNIT" TextColor="{StaticResource LargaDarkText}" FontSize="12" />
                            <Label Text="{Binding AssignedUnitPlate, FallbackValue='Loading...'}" Style="{StaticResource HeaderStyle}" FontSize="32" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource LargaPrimaryBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="50" HeightRequest="40">
                            <Image Source="car_icon.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" HorizontalOptions="Center" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding AssignedUnitDetails}" TextColor="{StaticResource LargaDarkText}" FontSize="14" />
                    <BoxView HeightRequest="1" Color="{StaticResource LargaDarkText}" Margin="0,10" />

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="MAINTENANCE STATUS :" TextColor="{StaticResource LargaDarkText}" FontSize="12" VerticalOptions="Center" />
                        <Border Grid.Column="1" BackgroundColor="{StaticResource LargaPrimaryBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="15,5">
                            <Label Text="{Binding MaintenanceStatus}" TextColor="{StaticResource LargaWhite}" FontSize="14" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Manager Note -->
            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="20">
                <Grid ColumnDefinitions="Auto, *">
                    <Image Grid.Column="0" Source="warning_icon.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Start" Margin="0,0,10,0" />
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Manager Note" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" FontSize="16" />
                        <Label Text="{Binding ManagerNote}" TextColor="Gray" FontSize="14" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <VerticalStackLayout Spacing="10" Margin="0,40,0,0">
                <Button Text="💬 Message Manager" BackgroundColor="{StaticResource LargaPrimaryBlue}" TextColor="{StaticResource LargaWhite}" CornerRadius="10" HorizontalOptions="End" Padding="15,10" Command="{Binding MessageManagerCommand}" />

                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsOffline}">
                    <Button Text="🕒 CLOCK IN   >" Style="{StaticResource LargaButtonStyle}" HeightRequest="60" FontSize="18" Command="{Binding ToggleShiftCommand}" />
                    <Label Text="A vehicle checklist is required before your shift begins." TextColor="{StaticResource LargaDarkText}" FontSize="12" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Button Text="ACTIVE SHIFT SCREEN   >" BackgroundColor="{StaticResource LargaPrimaryBlue}" TextColor="{StaticResource LargaWhite}" CornerRadius="25" HeightRequest="60" FontSize="18" FontAttributes="Bold" Command="{Binding ActiveShiftCommand}" IsVisible="{Binding IsOnline}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>