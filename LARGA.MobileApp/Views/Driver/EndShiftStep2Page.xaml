<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             x:Class="LARGA.MobileApp.Views.Driver.EndShiftStep2Page"
             x:DataType="vm:EndShiftStep2ViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Grid ColumnDefinitions="Auto, *">
                <ImageButton Source="back_icon.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" Padding="8" BackgroundColor="Transparent" Clicked="OnBackButtonClicked" />
            </Grid>

            <Label Text="STEP 2 OF 2" Style="{StaticResource StatusDataStyle}" TextColor="Gray" FontSize="12" />
            <Label Text="End-of-Shift Inspection" FontSize="32" Style="{StaticResource HeaderStyle}" TextColor="Black" LineHeight="1.1" />
            <Label Text="GHK·4471·MP · Complete all items before ending your shift." FontSize="12" TextColor="Gray" />

            <ProgressBar Progress="1.0" ProgressColor="#0099CC" HeightRequest="4" Margin="0,10,0,0" />
            <Label Text="2 / 2 completed" FontSize="14" Style="{StaticResource StatusDataStyle}" TextColor="Black" Margin="0,5,0,0" />

            <!-- Return Metrics -->
            <Border BackgroundColor="#AEE2F0" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Return Metrics" FontAttributes="Bold" FontSize="16" TextColor="Black" />
                    <Label Text="Final Odometer:" FontSize="12" TextColor="Gray" />

                    <Button Text="📷 Scan odometer dashboard" Command="{Binding ScanOdometerCommand}" 
                            BackgroundColor="White" TextColor="Black" CornerRadius="10" HeightRequest="45" HorizontalOptions="Fill">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsOdometerScanned}" Value="True">
                                <Setter Property="BackgroundColor" Value="#0099CC" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="Text" Value="✅ Odometer Scanned" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <!-- Fuel Verification -->
            <Border BackgroundColor="#AEE2F0" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Fuel Verification" FontAttributes="Bold" FontSize="16" TextColor="Black" />
                    <Label Text="Checked fuel gauge dashboard" FontSize="12" TextColor="Gray" Margin="0,0,0,10" />

                    <!-- Option 1: Half Tank -->
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectFuelCommand}" CommandParameter="HalfTank" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <RadioButton GroupName="FuelLevel" IsChecked="{Binding IsHalfTankSelected}" VerticalOptions="Center" />
                        <Label Text="Half-tank" TextColor="Black" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Option 2: Below Half Tank -->
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Margin="0,5,0,10">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectFuelCommand}" CommandParameter="BelowHalf" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <RadioButton GroupName="FuelLevel" IsChecked="{Binding IsBelowHalfTankSelected}" VerticalOptions="Center" />
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Below half-tank" TextColor="Black" />
                            <Label Text="(Penalty to the previous driver: ₱ 50.00)" TextColor="Red" TextDecorations="Underline" FontSize="10" IsVisible="{Binding PenaltyNoteVisible}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <Button Text="📷 Attach photo" Command="{Binding AttachFuelPhotoCommand}" 
                            BackgroundColor="White" TextColor="Black" CornerRadius="10" HeightRequest="45" HorizontalOptions="Fill" Margin="0,5,0,0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding HasPhoto}" Value="True">
                                <Setter Property="BackgroundColor" Value="#0099CC" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="Text" Value="✅ Photo Attached" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <Button Text="🛡️ Confirm &amp; End Shift" Command="{Binding ConfirmEndShiftCommand}" 
                    BackgroundColor="#AEE2F0" TextColor="#0099CC" Style="{StaticResource LargaButtonStyle}" HeightRequest="60" FontSize="18" Margin="0,20,0,0">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsComplete}" Value="True">
                        <Setter Property="BackgroundColor" Value="#0099CC" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>