<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             x:Class="LARGA.MobileApp.Views.Driver.EndShiftStep2Page"
             x:DataType="vm:EndShiftStep2ViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource ThemeSurface}">

    <ScrollView>
        <VerticalStackLayout Padding="20,0" Spacing="12">

            <Label Text="STEP 2 OF 2" TextColor="{DynamicResource ThemeTextGray}" FontSize="12" />
            <Label Text="End-of-Shift Inspection" FontSize="32" Style="{StaticResource HeaderStyle}" TextColor="{DynamicResource ThemeTextBlack}" LineHeight="1.1" />
            <Label Text="GHK·4471·MP · Complete all items before ending your shift." FontSize="12" TextColor="{DynamicResource ThemeTextGray}" />

            <ProgressBar Progress="1.0" ProgressColor="#0099CC" HeightRequest="4" Margin="0,10,0,0" />
            <Label Text="2 / 2 completed" FontSize="14" Style="{StaticResource StatusDataStyle}" TextColor="{DynamicResource ThemeTextBlack}" Margin="0,5,0,0" />

            <!-- Return Metrics -->
            <Border BackgroundColor="{DynamicResource ThemePanel}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Return Metrics" FontAttributes="Bold" FontSize="16" TextColor="{DynamicResource ThemeTextBlack}" />
                    <Label Text="Final Odometer:" FontSize="12" TextColor="{DynamicResource ThemeTextGray}" />

                    <!-- Dynamically binds to OdometerButtonText and shrinks horizontally -->
                    <Button Text="{Binding OdometerButtonText}" Command="{Binding ScanOdometerCommand}" 
                            BackgroundColor="{DynamicResource ThemeSurface}" TextColor="{DynamicResource ThemeTextBlack}" CornerRadius="10" HeightRequest="45" HorizontalOptions="Fill">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsOdometerScanned}" Value="True">
                                <Setter Property="BackgroundColor" Value="#0099CC" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="HorizontalOptions" Value="Start" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <!-- Fuel Verification -->
            <Border BackgroundColor="{DynamicResource ThemePanel}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Fuel Verification" FontAttributes="Bold" FontSize="16" TextColor="{DynamicResource ThemeTextBlack}" />
                    <Label Text="Checked fuel gauge dashboard" FontSize="12" TextColor="{DynamicResource ThemeTextGray}" Margin="0,0,0,10" />

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectFuelCommand}" CommandParameter="HalfTank" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <RadioButton GroupName="FuelLevel" IsChecked="{Binding IsHalfTankSelected}" VerticalOptions="Center" />
                        <Label Text="Half-tank" TextColor="{DynamicResource ThemeTextBlack}" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Margin="0,5,0,10">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectFuelCommand}" CommandParameter="BelowHalf" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <RadioButton GroupName="FuelLevel" IsChecked="{Binding IsBelowHalfTankSelected}" VerticalOptions="Center" />
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Below half-tank" TextColor="{DynamicResource ThemeTextBlack}" />
                            <Label Text="(₱ 50.00 penalty added to today's boundary)" TextColor="Red" TextDecorations="Underline" FontSize="10" IsVisible="{Binding PenaltyNoteVisible}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <Button Text="📷 Attach photo" Command="{Binding AttachFuelPhotoCommand}" 
                            BackgroundColor="{DynamicResource ThemeSurface}" TextColor="{DynamicResource ThemeTextBlack}" CornerRadius="10" HeightRequest="45" HorizontalOptions="Fill" Margin="0,5,0,0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding HasPhoto}" Value="True">
                                <Setter Property="BackgroundColor" Value="#0099CC" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="Text" Value="✅ Photo Attached" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- Dynamically renders the captured photo -->
                    <Image Source="{Binding FuelPhoto}" IsVisible="{Binding HasPhoto}" HeightRequest="150" Aspect="AspectFill" Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Confirm & End Shift -->
            <Button Text="🛡️ Confirm &amp; End Shift" Command="{Binding ConfirmEndShiftCommand}" 
                    BackgroundColor="{DynamicResource ThemePanel}" TextColor="#0099CC" CornerRadius="25" HeightRequest="55" FontSize="16" FontAttributes="Bold" Margin="0,20,0,0">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsComplete}" Value="True">
                        <Setter Property="BackgroundColor" Value="#0099CC" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>