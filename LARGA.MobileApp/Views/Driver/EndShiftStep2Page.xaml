<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             x:Class="LARGA.MobileApp.Views.Driver.EndShiftStep2Page"
             x:DataType="vm:EndShiftStep2ViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource LargaWhite}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Grid ColumnDefinitions="Auto, *">
                <ImageButton Grid.Column="0" Source="back_icon.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" Padding="8" BackgroundColor="Transparent" Clicked="OnBackButtonClicked" />
            </Grid>

            <Label Text="STEP 2 OF 2" TextColor="Gray" FontSize="12" />
            <Label Text="End-of-Shift Inspection" FontSize="32" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" LineHeight="1.1" />
            <Label Text="GHK·4471·MP · Complete all items before ending your shift." FontSize="12" TextColor="Gray" />

            <ProgressBar Progress="1.0" ProgressColor="{StaticResource LargaPrimaryBlue}" HeightRequest="4" Margin="0,10,0,0" />
            <Label Text="2 / 2 completed" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" Margin="0,5,0,0" />

            <!-- Return Metrics -->
            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Return Metrics" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource LargaDarkText}" />
                    <Label Text="Final Odometer:" FontSize="13" TextColor="{StaticResource LargaDarkText}" />

                    <Border BackgroundColor="{StaticResource LargaPrimaryBlue}" StrokeShape="RoundRectangle 20" Padding="0" HeightRequest="42" HorizontalOptions="Start" WidthRequest="200">
                        <Button Text="{Binding FinalOdometer, StringFormat='📷 {0}'}"
                                Command="{Binding ScanOdometerCommand}"
                                BackgroundColor="Transparent" TextColor="{StaticResource LargaWhite}" FontSize="13" FontAttributes="Bold" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Fuel Verification -->
            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Fuel Verification" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource LargaDarkText}" />
                    <Label Text="Checked fuel gauge dashboard" FontSize="13" TextColor="{StaticResource LargaDarkText}" />

                    <RadioButton Content="Half-tank" IsChecked="{Binding IsHalfTank}" GroupName="FuelLevel" TextColor="{StaticResource LargaDarkText}" />
                    <VerticalStackLayout Spacing="0">
                        <RadioButton Content="Below half-tank" IsChecked="{Binding IsBelowHalfTank}" GroupName="FuelLevel" TextColor="{StaticResource LargaDarkText}" />
                        <Label Text="(Penalty to the previous driver: ₱ 50.00)"
                               FontSize="11" TextColor="Red" Margin="30,0,0,0"
                               IsVisible="{Binding PenaltyNoteVisible}" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="{StaticResource LargaPrimaryBlue}" StrokeShape="RoundRectangle 20" Padding="0" HeightRequest="42" HorizontalOptions="Start" WidthRequest="180" Margin="0,4,0,0">
                        <Button Text="📷 Attached photo"
                                Command="{Binding AttachFuelPhotoCommand}"
                                BackgroundColor="Transparent" TextColor="{StaticResource LargaWhite}" FontSize="13" FontAttributes="Bold" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Button Text="🛡  Confirm &amp; End Shift"
                    Command="{Binding ConfirmEndShiftCommand}"
                    BackgroundColor="{StaticResource LargaPrimaryBlue}" TextColor="{StaticResource LargaWhite}"
                    CornerRadius="25" HeightRequest="55" FontSize="16" FontAttributes="Bold" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>