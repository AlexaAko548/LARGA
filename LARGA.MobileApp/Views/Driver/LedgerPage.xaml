<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             x:Class="LARGA.MobileApp.Views.Driver.LedgerPage"
             x:DataType="vm:LedgerViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">

            <!-- Header -->
            <Label Text="{Binding CurrentDate}" FontSize="14" TextColor="Gray" Margin="0,10,0,0"/>
            <Label Text="My Ledger" FontSize="32" FontAttributes="Bold" TextColor="Black" Margin="0,0,0,10"/>

            <!-- Current Shift Payment Card -->
            <Border BackgroundColor="#AEE2F0" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="CURRENT SHIFT PAYMENT" FontSize="12" TextColor="Black" CharacterSpacing="1"/>
                    <Label Text="{Binding CurrentShiftPayment}" FontSize="20" FontAttributes="Bold" TextColor="Black"/>
                </VerticalStackLayout>
            </Border>

            <!-- Outstanding Debt Balance Card -->
            <Border BackgroundColor="#AEE2F0" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                    <Label Grid.Row="0" Grid.ColumnSpan="2" Text="OUTSTANDING DEBT BALANCE" FontSize="12" TextColor="Black" CharacterSpacing="1"/>
                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding OutstandingDebtBalance}" FontSize="20" FontAttributes="Bold" TextColor="Black" VerticalOptions="Center"/>
                    <Label Grid.Row="1" Grid.Column="1" Text="Details" FontSize="14" TextColor="Black" TextDecorations="Underline" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewDebtDetailsCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>

            <!-- Payment History Card -->
            <Border BackgroundColor="#AEE2F0" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="PAYMENT HISTORY" FontSize="12" TextColor="Black" CharacterSpacing="1" Margin="0,0,0,5"/>

                    <!-- Dynamic List Generator -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PaymentHistory}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PaymentRecord">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="{Binding DisplayText}" FontSize="14" TextColor="Black" FontFamily="DMMonoRegular"/>
                                    <BoxView HeightRequest="1" Color="#80BBD0" Margin="0"/>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- See All Button -->
                    <Label Text="See all" FontSize="14" TextColor="Black" TextDecorations="Underline" HorizontalOptions="End" Margin="0,10,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewAllHistoryCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>