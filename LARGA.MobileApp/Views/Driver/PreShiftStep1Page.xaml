<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             x:Class="LARGA.MobileApp.Views.Driver.PreShiftStep1Page"
             x:DataType="vm:PreShiftStep1ViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <!-- Header Back Button -->
            <Grid ColumnDefinitions="Auto, *">
                <ImageButton Grid.Column="0" Source="back_icon.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" Padding="8" BackgroundColor="Transparent" Clicked="OnBackButtonClicked" />
            </Grid>

            <Label Text="STEP 1 OF 2" TextColor="Gray" FontSize="12" />
            <Label Text="Pre-Shift Inspection" FontSize="32" FontAttributes="Bold" TextColor="Black" LineHeight="1.1" />
            <Label Text="GHK·4471·MP · Complete all items before starting your shift" FontSize="12" TextColor="Gray" />

            <!-- Real-Time Progress Bar & Label -->
            <ProgressBar Progress="{Binding ProgressRatio}" ProgressColor="#0099CC" HeightRequest="4" Margin="0,10,0,0" />
            <Label Text="{Binding ProgressText}" FontSize="14" FontAttributes="Bold" TextColor="Black" Margin="0,5,0,0" />

            <!-- Row 1: Tire Condition -->
            <Border BackgroundColor="#AEE2F0" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="0">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Tire Condition" FontAttributes="Bold" FontSize="16" TextColor="Black" />
                        <Label Text="All 4 tires inspected + Spare tire in trunk." FontSize="12" TextColor="Black" />
                    </VerticalStackLayout>
                    <ImageButton Grid.Column="1" Source="check_icon.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" Padding="6" BackgroundColor="Transparent" 
                                 Command="{Binding PassItemCommand}" CommandParameter="Tires" IsVisible="{Binding TiresCheckVisible}" VerticalOptions="Center" />
                    <ImageButton Grid.Column="2" Source="close_icon.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" Padding="6" BackgroundColor="Transparent" 
                                 Command="{Binding ReportDefectCommand}" CommandParameter="Tires" IsVisible="{Binding TiresCloseVisible}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Row 2: Under the Hood -->
            <Border BackgroundColor="#AEE2F0" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="0">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Under the Hood" FontAttributes="Bold" FontSize="16" TextColor="Black" />
                        <Label Text="Oil level (dipstick) + Coolant/Water OK." FontSize="12" TextColor="Black" />
                    </VerticalStackLayout>
                    <ImageButton Grid.Column="1" Source="check_icon.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" Padding="6" BackgroundColor="Transparent" 
                                 Command="{Binding PassItemCommand}" CommandParameter="Hood" IsVisible="{Binding HoodCheckVisible}" VerticalOptions="Center" />
                    <ImageButton Grid.Column="2" Source="close_icon.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" Padding="6" BackgroundColor="Transparent" 
                                 Command="{Binding ReportDefectCommand}" CommandParameter="Hood" IsVisible="{Binding HoodCloseVisible}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Row 3: Lights & Electronics -->
            <Border BackgroundColor="#AEE2F0" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="0">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Lights &amp; Electronics" FontAttributes="Bold" FontSize="16" TextColor="Black" />
                        <Label Text="Headlights, signals, and horn are working. No dashboard warning lights." FontSize="12" TextColor="Black" />
                    </VerticalStackLayout>
                    <ImageButton Grid.Column="1" Source="check_icon.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" Padding="6" BackgroundColor="Transparent" 
                                 Command="{Binding PassItemCommand}" CommandParameter="Lights" IsVisible="{Binding LightsCheckVisible}" VerticalOptions="Center" />
                    <ImageButton Grid.Column="2" Source="close_icon.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" Padding="6" BackgroundColor="Transparent" 
                                 Command="{Binding ReportDefectCommand}" CommandParameter="Lights" IsVisible="{Binding LightsCloseVisible}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Row 4: Interior & Comfort -->
            <Border BackgroundColor="#AEE2F0" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="0">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Interior &amp; Comfort" FontAttributes="Bold" FontSize="16" TextColor="Black" />
                        <Label Text="Seats/floors clean + AC is cooling." FontSize="12" TextColor="Black" />
                    </VerticalStackLayout>
                    <ImageButton Grid.Column="1" Source="check_icon.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" Padding="6" BackgroundColor="Transparent" 
                                 Command="{Binding PassItemCommand}" CommandParameter="Interior" IsVisible="{Binding InteriorCheckVisible}" VerticalOptions="Center" />
                    <ImageButton Grid.Column="2" Source="close_icon.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" Padding="6" BackgroundColor="Transparent" 
                                 Command="{Binding ReportDefectCommand}" CommandParameter="Interior" IsVisible="{Binding InteriorCloseVisible}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Row 5: Exterior Scratches / Dents -->
            <Border BackgroundColor="#AEE2F0" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="0">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Exterior Scratches / Dents" FontAttributes="Bold" FontSize="16" TextColor="Black" />
                        <Label Text="Walk-around completed" FontSize="12" TextColor="Black" />
                    </VerticalStackLayout>
                    <ImageButton Grid.Column="1" Source="check_icon.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" Padding="6" BackgroundColor="Transparent" 
                                 Command="{Binding PassItemCommand}" CommandParameter="Exterior" IsVisible="{Binding ExteriorCheckVisible}" VerticalOptions="Center" />
                    <ImageButton Grid.Column="2" Source="close_icon.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" Padding="6" BackgroundColor="Transparent" 
                                 Command="{Binding ReportDefectCommand}" CommandParameter="Exterior" IsVisible="{Binding ExteriorCloseVisible}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Next Button -->
            <Button Text="Next   >" Command="{Binding NextCommand}" BackgroundColor="#AEE2F0" TextColor="#0099CC" CornerRadius="25" HeightRequest="55" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>