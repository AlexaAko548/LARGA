<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             x:Class="LARGA.MobileApp.Views.Driver.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             BackgroundColor="{StaticResource LargaWhite}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="My Profile" FontSize="32" Style="{StaticResource HeaderStyle}" TextColor="{StaticResource LargaDarkText}" Margin="0,10,0,0" />

            <!-- Profile card -->
            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 15" StrokeThickness="0" Padding="20">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border StrokeShape="RoundRectangle 40" HeightRequest="80" WidthRequest="80" BackgroundColor="#777777" StrokeThickness="0" />
                    <Label Text="{Binding FullName}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" HorizontalOptions="Center" />
                    <Label Text="Driver" FontSize="13" TextColor="#555555" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- License & Credentials -->
            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="15">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="LICENSE &amp; CREDENTIALS" FontSize="12" TextColor="{StaticResource LargaDarkText}" CharacterSpacing="1" />
                        <Label Grid.Column="1" Text="{Binding StatusText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding StatusColor}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#80BBD0" />
                    <Label Text="{Binding CredentialsSummary}" FontSize="14" TextColor="{StaticResource LargaDarkText}" />
                    <Label Text="Your license details are verified and set by your manager." FontSize="11" TextColor="#777777" Margin="0,5,0,0" />
                </VerticalStackLayout>
            </Border>

            <Button Text="LOG OUT" Command="{Binding LogoutCommand}"
                    BackgroundColor="#F2665E" TextColor="White" CornerRadius="25"
                    HeightRequest="55" FontSize="16" FontAttributes="Bold" Margin="0,30,0,20" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
