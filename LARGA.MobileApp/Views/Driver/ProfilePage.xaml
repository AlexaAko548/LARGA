<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             x:Class="LARGA.MobileApp.Views.Driver.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             BackgroundColor="{StaticResource LargaPageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="My Profile" FontSize="30" Style="{StaticResource HeaderStyle}" TextColor="{StaticResource LargaNavy}" Margin="0,10,0,4" />

            <!-- Profile card -->
            <Border Style="{StaticResource ManagerCardStyle}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border StrokeShape="RoundRectangle 38" HeightRequest="76" WidthRequest="76" BackgroundColor="{StaticResource LargaPrimaryBlue}" StrokeThickness="0">
                        <Label Text="{Binding Initials}" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource LargaWhite}"
                               HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                    </Border>
                    <Label Text="{Binding FullName}" FontSize="19" FontAttributes="Bold" TextColor="{StaticResource LargaNavy}" HorizontalOptions="Center" />
                    <Border BackgroundColor="{StaticResource LargaAccentBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="14,5">
                        <Label Text="Driver" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource LargaPrimaryBlue}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- License & Credentials -->
            <Border Style="{StaticResource ManagerCardStyle}">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <Label Grid.Column="0" Text="LICENSE &amp; CREDENTIALS" Style="{StaticResource EyebrowLabelStyle}" VerticalOptions="Center" />
                        <Border Grid.Column="1" BackgroundColor="{Binding StatusBgColor}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="9,3">
                            <Label Text="{Binding StatusText}" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.4" TextColor="{Binding StatusColor}" />
                        </Border>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource LargaCardBorder}" />
                    <Label Text="{Binding CredentialsSummary}" FontSize="14" TextColor="{StaticResource LargaNavy}" Margin="0,12,0,0" />
                    <Label Text="Your license details are verified and set by your manager." FontSize="11" TextColor="{StaticResource LargaMutedText}" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <Button Text="LOG OUT" Command="{Binding LogoutCommand}"
                    BackgroundColor="{StaticResource LargaDanger}" TextColor="{StaticResource LargaWhite}" CornerRadius="25"
                    HeightRequest="54" FontSize="15" FontAttributes="Bold" Margin="0,20,0,20" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
