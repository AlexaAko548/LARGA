<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             x:Class="LARGA.MobileApp.Views.Driver.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             BackgroundColor="{StaticResource LargaWhite}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="My Profile" FontSize="32" Style="{StaticResource HeaderStyle}" TextColor="{StaticResource LargaDarkText}" Margin="0,10,0,0" />

            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="20">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border StrokeShape="RoundRectangle 40"
                            HeightRequest="80"
                            WidthRequest="80"
                            BackgroundColor="{StaticResource LargaPrimaryBlue}"
                            StrokeThickness="0">
                        <Image Source="{Binding ProfileImageUrl}" Aspect="AspectFill" />
                    </Border>

                    <Label Text="{Binding FullName}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" HorizontalOptions="Center"  />

                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="15" HorizontalOptions="Center">
                        <Label Grid.Column="0" Text="Contact #:" FontSize="13" TextColor="#555555" HorizontalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding ContactNumber}" FontSize="13" TextColor="#555555" HorizontalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="15">
                <VerticalStackLayout Spacing="12">
                    <Label Text="LICENSE &amp; CREDENTIALS" FontAttributes="Bold" FontSize="16"  TextColor="{StaticResource LargaDarkText}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                        <Label Grid.Column="0" Text="LTO License No:" FontSize="15" TextColor="{StaticResource LargaDarkText}" />
                        <Label Grid.Column="1" Text="{Binding LicenseNumber}" FontSize="16" TextColor="{StaticResource LargaDarkText}" HorizontalTextAlignment="End" FontFamily="DMMonoMedium" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#1A1A1A" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                        <Label Grid.Column="0" Text="Expiry Date:" FontSize="15" TextColor="{StaticResource LargaDarkText}" />
                        <Label Grid.Column="1" Text="{Binding ExpiryDateDisplay}" FontSize="16" TextColor="{StaticResource LargaDarkText}" HorizontalTextAlignment="End" FontFamily="DMMonoMedium" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#1A1A1A" />

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="Status:" FontSize="15" TextColor="{StaticResource LargaDarkText}" />
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                HeightRequest="20"
                                WidthRequest="20"
                                BackgroundColor="{Binding StatusColor}"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                StrokeThickness="0" />
                        <Label Grid.Column="2" Text="{Binding StatusText}" FontSize="16" TextColor="{StaticResource LargaDarkText}" FontFamily="DMMonoMedium" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#1A1A1A" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                        <Label Grid.Column="0" Text="DL Codes:" FontSize="15" TextColor="{StaticResource LargaDarkText}" />
                        <Label Grid.Column="1" Text="{Binding DlCodes}" FontSize="16" TextColor="{StaticResource LargaDarkText}" HorizontalTextAlignment="End" FontFamily="DMMonoMedium" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="15">
                <VerticalStackLayout Spacing="12">
                    <Label Text="MY PERFORMANCE STANDING" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                        <Label Grid.Column="0" Text="Payment Reliability:" FontSize="15" TextColor="{StaticResource LargaDarkText}" />
                        <Label Grid.Column="1" Text="{Binding PaymentReliability}" FontSize="16" TextColor="{StaticResource LargaDarkText}" HorizontalTextAlignment="End" FontFamily="DMMonoMedium" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#1A1A1A" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                        <Label Grid.Column="0" Text="Shift Punctuality:" FontSize="15" TextColor="{StaticResource LargaDarkText}" />
                        <Label Grid.Column="1" Text="{Binding ShiftPunctualityDisplay}" FontSize="16" TextColor="{StaticResource LargaDarkText}" HorizontalTextAlignment="End" FontFamily="DMMonoMedium" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#1A1A1A" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                        <Label Grid.Column="0" Text="Damage History:" FontSize="15" TextColor="{StaticResource LargaDarkText}" />
                        <Label Grid.Column="1" Text="{Binding DamageHistoryDisplay}" FontSize="16" TextColor="{StaticResource LargaDarkText}" HorizontalTextAlignment="End" FontFamily="DMMonoMedium" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="ACCOUNT SETTINGS" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource LargaDarkText}" />

                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="5,3">
                        <Label Grid.Column="0" FontSize="30" VerticalOptions="Center" TextColor="{StaticResource LargaDarkText}" />
                        <Label Grid.Column="1" Text="›  Change password" FontSize="15" TextColor="{StaticResource LargaDarkText}" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangePasswordCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="5,3">
                        <Label Grid.Column="0" FontSize="30" VerticalOptions="Center" TextColor="{StaticResource LargaDarkText}" />
                        <Label Grid.Column="1" Text="›  Update Contact Number" FontSize="15" TextColor="{StaticResource LargaDarkText}" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UpdateContactNumberCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="LOG OUT"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="#F2665E"
                    TextColor="White"
                    CornerRadius="25"
                    HeightRequest="55"
                    FontSize="16"
                    Style="{StaticResource HeaderStyle}"
                    Margin="0,10,0,20" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
