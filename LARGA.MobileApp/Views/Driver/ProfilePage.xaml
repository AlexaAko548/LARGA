<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             x:Class="LARGA.MobileApp.Views.Driver.ProfilePage"
             BackgroundColor="{StaticResource LargaWhite}"
             Title="Profile">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
        <Label Text="Driver Profile" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource LargaDarkText}" />
        <Button Text="Temporary Logout" BackgroundColor="Red" TextColor="{StaticResource LargaWhite}" CornerRadius="10" Command="{Binding LogoutCommand}" WidthRequest="200" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>