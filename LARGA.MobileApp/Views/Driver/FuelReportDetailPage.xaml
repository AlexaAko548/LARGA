<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             x:Class="LARGA.MobileApp.Views.Driver.FuelReportDetailPage"
             x:DataType="vm:FuelReportDetailViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource LargaWhite}">

    <ScrollView>
        <VerticalStackLayout Padding="20,0" Spacing="15">

            <Label Text="Fuel Report Details" Margin="0,-10,0,0" FontSize="32" Style="{StaticResource HeaderStyle}" TextColor="{StaticResource LargaDarkText}" />

            <!-- Status -->
            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10">
                <Label Text="{Binding Status}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" HorizontalTextAlignment="Center" />
            </Border>

            <!-- Station & OR Number -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Fuel Station" FontSize="12" TextColor="{StaticResource LargaDarkText}" />
                        <Label Text="{Binding FuelStation}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="OR Number" FontSize="12" TextColor="{StaticResource LargaDarkText}" />
                        <Label Text="{Binding OrNumber}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Cost & Liters -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Total Cost" FontSize="12" TextColor="{StaticResource LargaDarkText}" />
                        <Label Text="{Binding FuelCostDisplay}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Liters Refueled" FontSize="12" TextColor="{StaticResource LargaDarkText}" />
                        <Label Text="{Binding LitersDisplay}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Odometer & Date -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Odometer" FontSize="12" TextColor="{StaticResource LargaDarkText}" />
                        <Label Text="{Binding OdometerDisplay}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Transaction Date" FontSize="12" TextColor="{StaticResource LargaDarkText}" />
                        <Label Text="{Binding DateLoggedDisplay}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Receipt Photo -->
            <Border IsVisible="{Binding HasPhoto}" BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Receipt Photo" FontSize="12" TextColor="{StaticResource LargaDarkText}" />
                    <Image Source="{Binding Photo}" HeightRequest="250" Aspect="AspectFit" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Go Back" Command="{Binding GoBackCommand}" BackgroundColor="Transparent" TextColor="Gray" BorderColor="Gray" BorderWidth="1" CornerRadius="25" Margin="0,10,0,20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>