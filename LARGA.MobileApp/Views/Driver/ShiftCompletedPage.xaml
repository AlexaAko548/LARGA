<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             x:Class="LARGA.MobileApp.Views.Driver.ShiftCompletedPage"
             x:DataType="vm:ShiftCompletedViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <Grid RowDefinitions="*,Auto" Padding="20">

        <VerticalStackLayout Grid.Row="0" Spacing="15" VerticalOptions="Start" Margin="0,20,0,0">
            <!-- Dynamic Date -->
            <Label Text="{Binding CurrentDateDisplay}" TextColor="Black" FontSize="14" />
            <Label Text="Shift Completed" FontSize="32" FontAttributes="Bold" TextColor="Black" />

            <!-- Dynamic Name inside FormattedText -->
            <Label FontSize="14" TextColor="Black">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding CompletionMessage}" />
                        <Span Text="OFF." FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Border BackgroundColor="#AEE2F0" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="TODAY'S BOUNDARY" FontSize="12" TextColor="Black" />
                    <!-- Fixed Boundary Amount -->
                    <Label Text="{Binding BoundaryAmountDisplay}" FontSize="28" FontAttributes="Bold" TextColor="Black" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#AEE2F0" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                <Label Text="Please proceed to the office to remit your cash boundary to the manager to clear your ledger."
                       FontSize="13" TextColor="Black" />
            </Border>
        </VerticalStackLayout>

        <Button Grid.Row="1"
                Text="RETURN TO HOMESCREEN   &gt;"
                Command="{Binding ReturnToHomeCommand}"
                BackgroundColor="#0099CC" TextColor="White"
                CornerRadius="25" HeightRequest="55" FontSize="16" FontAttributes="Bold"
                Margin="0,20,0,20" />

    </Grid>
</ContentPage>