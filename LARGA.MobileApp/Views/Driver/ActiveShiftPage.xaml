<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="LARGA.MobileApp.Views.Driver.ActiveShiftPage"
             x:DataType="viewmodels:ActiveShiftViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource ThemeSurface}">

    <Grid>
        <!-- MAIN CONTENT: cards scroll; the action buttons are pinned below them, just above
             the tab bar (same layout as DriverDashboardPage). -->
        <Grid RowDefinitions="*, Auto">

            <ScrollView Grid.Row="0">
                <VerticalStackLayout Padding="20" Spacing="7" Margin="0,-10">

                    <!-- Status Banner -->
                    <Frame BackgroundColor="#1E1E1E" CornerRadius="8" Padding="15,10" HasShadow="False">
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Ellipse WidthRequest="15" HeightRequest="15" Fill="Transparent" Stroke="{Binding StatusBannerColor}" StrokeThickness="2" VerticalOptions="Center"/>
                            <Label Text="{Binding StatusBannerText}" Style="{StaticResource StatusDataStyle}" TextColor="White" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Frame>

                    <Label Text="{Binding ShiftStartTimeDisplay, StringFormat='Shift started at {0}'}" FontSize="16" TextColor="{DynamicResource ThemeTextBlack}" Margin="0,10,0,0"/>

                    <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,15">
                        <Label Grid.Column="0" Text="{Binding ShiftStatus}" Style="{StaticResource HeaderTitleStyle}" TextColor="{DynamicResource ThemeTextBlack}" FontSize="38" VerticalOptions="Center"/>

                        <!-- SOS Icon Button -->
                        <Border Grid.Column="1" BackgroundColor="#FF2424" Stroke="#FF7373" StrokeThickness="6" StrokeShape="RoundRectangle 30" WidthRequest="60" HeightRequest="60" VerticalOptions="Center" HorizontalOptions="Center">
                            <Border.Behaviors>
                                <toolkit:TouchBehavior LongPressDuration="3000" LongPressCommand="{Binding SendSosCommand}" />
                            </Border.Behaviors>
                            <Image Source="sos_icon.png" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Top Metric Cards -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <Frame Grid.Column="0" BackgroundColor="{DynamicResource ThemePanelAlt}" CornerRadius="12" Padding="15" HasShadow="False">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="DURATION" FontSize="14" TextColor="{DynamicResource ThemeTextSecondary}"/>
                                <Label Text="{Binding DurationDisplay}" Style="{StaticResource StatusDataStyle}" FontSize="24" TextColor="{DynamicResource ThemeTextBlack}"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Grid.Column="1" BackgroundColor="{DynamicResource ThemePanelAlt}" CornerRadius="12" Padding="15" HasShadow="False">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="TAXI UNIT" FontSize="14" TextColor="{DynamicResource ThemeTextSecondary}"/>
                                <Label Text="{Binding TaxiUnit}" FontSize="16" Style="{StaticResource StatusDataStyle}" TextColor="{DynamicResource ThemeTextBlack}"/>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- Shift Metrics -->
                    <Frame BackgroundColor="{DynamicResource ThemePanelAlt}" CornerRadius="12" Padding="15" HasShadow="False">
                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *">
                            <Label Grid.Row="0" Grid.Column="0" Text="SHIFT METRICS" FontSize="14" TextColor="{DynamicResource ThemeTextSecondary}"/>
                            <Label Grid.Row="0" Grid.Column="1" Text="Live" FontSize="14" TextColor="#00A000" HorizontalOptions="End" FontAttributes="Bold"/>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Margin="0,15,0,0" HorizontalOptions="Center">
                                <Label Text="{Binding Distance}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource ThemeTextBlack}" HorizontalOptions="Center"/>
                                <Label Text="Distance (km)" FontSize="12" TextColor="{DynamicResource ThemeTextSecondary}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Margin="0,15,0,0" HorizontalOptions="Center">
                                <Label Text="{Binding BoundaryStatus}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource ThemeTextBlack}" HorizontalOptions="Center"/>
                                <Label Text="Boundary Status" FontSize="12" TextColor="{DynamicResource ThemeTextSecondary}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>

                    <Frame BackgroundColor="{DynamicResource ThemePanelAlt}" CornerRadius="8" Padding="15,10" HasShadow="False">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="RETURN UNIT BY :" FontSize="16" TextColor="{DynamicResource ThemeTextSecondary}" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding ShiftEndsAt}" Style="{StaticResource StatusDataStyle}" FontSize="20" TextColor="{DynamicResource ThemeTextBlack}"/>
                        </Grid>
                    </Frame>

                    <Frame BackgroundColor="{DynamicResource ThemePanelAlt}" CornerRadius="8" Padding="15,10" HasShadow="False">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="TIME REMAINING :" FontSize="16" TextColor="{DynamicResource ThemeTextSecondary}" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding TimeRemainingDisplay}" Style="{StaticResource StatusDataStyle}" FontSize="20" TextColor="{DynamicResource ThemeTextBlack}"/>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Standard Action Buttons -->
            <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="15" Padding="20,10,20,16" IsVisible="{Binding IsActive}">
                <Button Grid.Column="0" Text="PAUSE" Style="{StaticResource LargaButtonStyle}" FontSize="18" BackgroundColor="#0099CC" TextColor="White" CornerRadius="25" HeightRequest="55" Command="{Binding RequestPauseCommand}"/>
                <Button Grid.Column="1" Text="CLOCK OUT" Style="{StaticResource LargaButtonStyle}" FontSize="18" BackgroundColor="#0099CC" TextColor="White" CornerRadius="25" HeightRequest="55" Command="{Binding ClockOutCommand}"/>
            </Grid>
        </Grid>

        <!-- PAUSE CONFIRMATION OVERLAY -->
        <ContentView IsVisible="{Binding IsPauseAlertVisible}" BackgroundColor="#90000000" InputTransparent="False" ZIndex="10">
            <Frame BackgroundColor="{DynamicResource ThemeSurface}" CornerRadius="16" Padding="25" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="300" HasShadow="True">
                <VerticalStackLayout Spacing="25">
                    <Label Text="Pause your shift?" Style="{StaticResource StatusDataStyle}" FontSize="18" HorizontalOptions="Center" TextColor="{DynamicResource ThemeTextBlack}"/>
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <Button Grid.Column="0" Text="NO" Style="{StaticResource LargaButtonStyle}" BackgroundColor="#0099CC" TextColor="White" CornerRadius="10" HeightRequest="45" Command="{Binding CancelPauseCommand}"/>
                        <Button Grid.Column="1" Text="YES" Style="{StaticResource LargaButtonStyle}" BackgroundColor="#0099CC" TextColor="White" CornerRadius="10" HeightRequest="45" Command="{Binding ConfirmPauseCommand}"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </ContentView>

        <!-- PAUSE OVERLAY -->
        <ContentView IsVisible="{Binding IsPaused}" BackgroundColor="#90000000" InputTransparent="False" ZIndex="5">
            <Grid RowDefinitions="*, Auto">
                <VerticalStackLayout Grid.Row="0" Spacing="14" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border BackgroundColor="#0099CC" StrokeThickness="0" StrokeShape="RoundRectangle 60" WidthRequest="120" HeightRequest="120" HorizontalOptions="Center">
                        <Image Source="pause_overlay_icon.png" WidthRequest="56" HeightRequest="56" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Shift paused" Style="{StaticResource StatusDataStyle}" FontSize="18" TextColor="White" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Button Grid.Row="1" Text="RESUME" Style="{StaticResource LargaButtonStyle}" BackgroundColor="#0099CC" TextColor="White" CornerRadius="25" HeightRequest="60" Margin="20,0,20,40" Command="{Binding ResumeShiftCommand}"/>
            </Grid>
        </ContentView>

        <!-- CLOCK OUT CONFIRMATION OVERLAY -->
        <ContentView IsVisible="{Binding IsClockOutAlertVisible}" BackgroundColor="#90000000" InputTransparent="False" ZIndex="10">
            <Frame BackgroundColor="{DynamicResource ThemeSurface}" CornerRadius="16" Padding="25" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="300" HasShadow="True">
                <VerticalStackLayout Spacing="25">
                    <Label Text="Are you sure?" Style="{StaticResource StatusDataStyle}" FontSize="18" HorizontalOptions="Center" TextColor="{DynamicResource ThemeTextBlack}"/>
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <Button Grid.Column="0" Text="NO" Style="{StaticResource LargaButtonStyle}" BackgroundColor="#0099CC" TextColor="White" CornerRadius="10" HeightRequest="45" Command="{Binding CancelClockOutCommand}"/>
                        <Button Grid.Column="1" Text="YES" Style="{StaticResource LargaButtonStyle}" BackgroundColor="#0099CC" TextColor="White" CornerRadius="10" HeightRequest="45" Command="{Binding ConfirmClockOutCommand}"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </ContentView>

        <!-- SOS ALERT OVERLAY -->
        <ContentView IsVisible="{Binding IsSosAlertVisible}" BackgroundColor="#90000000" InputTransparent="False" ZIndex="10">
            <Frame BackgroundColor="{DynamicResource ThemeDangerSoft}" CornerRadius="16" Padding="25" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="320" HasShadow="True">
                <VerticalStackLayout Spacing="20">
                    <Label Text="{Binding SosAlertTitle}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{DynamicResource ThemeTextBlack}"/>
                    <Label Text="{Binding SosAlertBody}" FontSize="14" HorizontalTextAlignment="Center" TextColor="{DynamicResource ThemeTextBlack}"/>
                    <Button Text="OK" IsVisible="{Binding IsSosDismissable}" Style="{StaticResource LargaButtonStyle}" FontSize="18" BackgroundColor="#0099CC" TextColor="White" CornerRadius="20" WidthRequest="100" HorizontalOptions="Center" Command="{Binding DismissSosCommand}"/>
                </VerticalStackLayout>
            </Frame>
        </ContentView>
    </Grid>
</ContentPage>