<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             x:Class="LARGA.MobileApp.Views.Driver.ScanDriverLicensePage"
             x:DataType="vm:ScanDriverLicenseViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource LargaWhite}">

    <ScrollView>
        <VerticalStackLayout Padding="20,0" Spacing="15">

            <Label Text="&lt; Cancel" FontSize="14" TextColor="{StaticResource LargaPrimaryBlue}" Margin="0,15,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CancelCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Review Step -->
            <VerticalStackLayout Spacing="15" IsVisible="{Binding IsReviewStep}">
                <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10">
                    <Label Text="SCANNED DRIVER'S LICENSE" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" HorizontalTextAlignment="Center" />
                </Border>

                <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10">
                    <Image Source="{Binding CapturedImage}" HeightRequest="220" Aspect="AspectFit" />
                </Border>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15" HorizontalOptions="Center">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 25" HeightRequest="50" WidthRequest="50" BackgroundColor="{StaticResource LargaLightBlue}" StrokeThickness="0">
                        <Button Text="🔄" Command="{Binding RetakeCommand}" BackgroundColor="Transparent" FontSize="18" />
                    </Border>
                </Grid>

                <Button Text="Confirm" Command="{Binding ConfirmScanCommand}" IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="{StaticResource LargaPrimaryBlue}" TextColor="{StaticResource LargaWhite}"
                        CornerRadius="25" HeightRequest="55" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0" />
            </VerticalStackLayout>

            <!-- Verify Step -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsVerifyStep}">
                <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10">
                    <Label Text="VERIFY LICENSE INFORMATION" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" HorizontalTextAlignment="Center" />
                </Border>

                <Label Text="Scanning successful." FontSize="22" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" />
                <Label Text="⚠ Please check if the scanned information is correct. Tap any field to fix or fill it in." FontSize="13" TextColor="#777777" />

                <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Name" FontSize="12" TextColor="{StaticResource LargaPrimaryBlue}" FontAttributes="Bold" />
                        <Entry Text="{Binding NameDisplay}" Placeholder="Not detected - enter manually" FontSize="15"
                               TextColor="{StaticResource LargaDarkText}" BackgroundColor="Transparent" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Sex" FontSize="12" TextColor="{StaticResource LargaPrimaryBlue}" FontAttributes="Bold" />
                        <Entry Text="{Binding SexDisplay}" Placeholder="Not detected - enter manually" FontSize="15"
                               TextColor="{StaticResource LargaDarkText}" BackgroundColor="Transparent" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="DL Codes" FontSize="12" TextColor="{StaticResource LargaPrimaryBlue}" FontAttributes="Bold" />
                        <Entry Text="{Binding DlCodesDisplay}" Placeholder="Not detected - enter manually" FontSize="15"
                               TextColor="{StaticResource LargaDarkText}" BackgroundColor="Transparent" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="License Number" FontSize="12" TextColor="{StaticResource LargaPrimaryBlue}" FontAttributes="Bold" />
                        <Entry Text="{Binding LicenseNumberDisplay}" Placeholder="Not detected - enter manually" FontSize="15"
                               TextColor="{StaticResource LargaDarkText}" BackgroundColor="Transparent" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Expiry Date" FontSize="12" TextColor="{StaticResource LargaPrimaryBlue}" FontAttributes="Bold" />
                        <DatePicker Date="{Binding ExpiryDate}" Format="MMM d, yyyy" FontSize="15"
                                    TextColor="{StaticResource LargaDarkText}" BackgroundColor="Transparent" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10">
                    <Image Source="{Binding CapturedImage}" HeightRequest="150" Aspect="AspectFit" />
                </Border>

                <Button Text="Confirm &amp; Save" Command="{Binding ConfirmAndSaveCommand}" IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="{StaticResource LargaPrimaryBlue}" TextColor="{StaticResource LargaWhite}"
                        CornerRadius="25" HeightRequest="55" FontSize="16" FontAttributes="Bold" Margin="0,10,0,20" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
