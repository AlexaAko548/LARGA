<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             x:Class="LARGA.MobileApp.Views.Driver.PreShiftStep2Page"
             x:DataType="vm:PreShiftStep2ViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Grid ColumnDefinitions="Auto, *">
                <ImageButton Source="back_icon.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" Padding="8" BackgroundColor="Transparent" Clicked="OnBackButtonClicked" />
            </Grid>

            <Label Text="STEP 2 OF 2" Style="{StaticResource StatusDataStyle}" TextColor="Gray" FontSize="12" />
            <Label Text="Pre-Shift Inspection" FontSize="32" Style="{StaticResource HeaderStyle}" TextColor="Black" LineHeight="1.1" />
            <Label Text="GHK·4471·MP · Complete all items before starting your shift" FontSize="12" TextColor="Gray" />
            <Label Text="1 / 2 completed" FontSize="14" Style="{StaticResource StatusDataStyle}" TextColor="Black" Margin="0,5,0,0" />

            <!-- Starting Metrics Card -->
            <Border BackgroundColor="#AEE2F0" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Starting Metrics" FontAttributes="Bold" FontSize="18" FontFamily="Inter" TextColor="Black" />
                    <Label Text="Starting Odometer:" FontSize="13" TextColor="Gray" />
                    <Button Text="📷 Scan odometer dashboard" Command="{Binding ScanOdometerCommand}" 
                            BackgroundColor="White" TextColor="Black" CornerRadius="10" HeightRequest="45" HorizontalOptions="Fill">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsOdometerScanned}" Value="True">
                                <Setter Property="BackgroundColor" Value="#0099CC" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="Text" Value="✅ Odometer Scanned" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <!-- Fuel Verification Card -->
            <Border BackgroundColor="#AEE2F0" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Fuel Verification" FontAttributes="Bold" FontSize="18" FontFamily="Inter" TextColor="Black" />
                    <Label Text="Checked fuel gauge dashboard" FontSize="13" TextColor="Gray" />

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <RadioButton GroupName="Fuel" IsChecked="{Binding IsHalfTankSelected}" />
                        <Label Text="Half-tank" TextColor="Black" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <RadioButton GroupName="Fuel" IsChecked="{Binding IsBelowHalfTankSelected}" />
                        <VerticalStackLayout>
                            <Label Text="Below half-tank" TextColor="Black" />
                            <Label Text="(Penalty to the previous driver : ₱ 50.00)" TextColor="Blue" TextDecorations="Underline" FontSize="10" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <Button Text="📷 Attach photo" Command="{Binding AttachPhotoCommand}" 
                            BackgroundColor="White" TextColor="Black" CornerRadius="10" HeightRequest="45" HorizontalOptions="Fill" Margin="0,10,0,0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding HasPhoto}" Value="True">
                                <Setter Property="BackgroundColor" Value="#0099CC" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="Text" Value="✅ Photo Attached" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Image Source="{Binding FuelPhoto}" IsVisible="{Binding HasPhoto}" HeightRequest="150" Aspect="AspectFill" Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Confirm & Start Shift Button -->
            <Button Text="🛡️ Confirm &amp; Start Shift" Command="{Binding ConfirmStartShiftCommand}" 
                    BackgroundColor="#AEE2F0" TextColor="#0099CC" CornerRadius="25" Style="{StaticResource LargaButtonStyle}" HeightRequest="60" FontSize="18" Margin="0,15,0,0">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding CanStartShift}" Value="True">
                        <Setter Property="BackgroundColor" Value="#0099CC" />
                        <Setter Property="TextColor" Value="White" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>