<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             x:Class="LARGA.MobileApp.Views.Driver.FuelReportPage"
             x:DataType="vm:FuelReportViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource LargaWhite}">

    <ScrollView>
        <VerticalStackLayout Padding="20,0" Spacing="15">
            <Label Text="Submit Report" FontSize="32" Style="{StaticResource HeaderStyle}" TextColor="{StaticResource LargaDarkText}" Margin="0,-10,0,0" />

            <!-- Tab Badge -->
            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10">
                <Label Text="FUEL SUBMISSION" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" HorizontalTextAlignment="Center" />
            </Border>

            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 18" StrokeThickness="0" Padding="18">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="14" ColumnSpacing="12">

                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6" VerticalOptions="Center">
                        <Label Text="Cost (PHP)" VerticalOptions="Center" TextColor="{StaticResource LargaDarkText}" FontSize="15" />
                        <Label Text="Edited" IsVisible="{Binding IsCostManuallyEdited}" VerticalOptions="Center" TextColor="#B45309" FontSize="11" FontAttributes="Bold" />
                    </HorizontalStackLayout>
                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16" HeightRequest="45" Padding="14,0">
                        <Entry Text="{Binding Cost}" IsReadOnly="True" BackgroundColor="Transparent" VerticalOptions="Center" HorizontalTextAlignment="End" Keyboard="Numeric">
                            <Entry.Triggers>
                                <DataTrigger TargetType="Entry" Binding="{Binding IsCostEditable}" Value="True">
                                    <Setter Property="IsReadOnly" Value="False" />
                                </DataTrigger>
                            </Entry.Triggers>
                        </Entry>
                    </Border>

                    <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6" VerticalOptions="Center">
                        <Label Text="Quantity (L)" VerticalOptions="Center" TextColor="{StaticResource LargaDarkText}" FontSize="15" />
                        <Label Text="Edited" IsVisible="{Binding IsQuantityManuallyEdited}" VerticalOptions="Center" TextColor="#B45309" FontSize="11" FontAttributes="Bold" />
                    </HorizontalStackLayout>
                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16" HeightRequest="45" Padding="14,0">
                        <Entry Text="{Binding Quantity}" IsReadOnly="True" BackgroundColor="Transparent" VerticalOptions="Center" HorizontalTextAlignment="End" Keyboard="Numeric">
                            <Entry.Triggers>
                                <DataTrigger TargetType="Entry" Binding="{Binding IsQuantityEditable}" Value="True">
                                    <Setter Property="IsReadOnly" Value="False" />
                                </DataTrigger>
                            </Entry.Triggers>
                        </Entry>
                    </Border>

                    <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Spacing="6" VerticalOptions="Center">
                        <Label Text="Fuel Station" VerticalOptions="Center" TextColor="{StaticResource LargaDarkText}" FontSize="15" />
                        <Label Text="Edited" IsVisible="{Binding IsFuelStationManuallyEdited}" VerticalOptions="Center" TextColor="#B45309" FontSize="11" FontAttributes="Bold" />
                    </HorizontalStackLayout>
                    <Border Grid.Row="2" Grid.Column="1" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16" HeightRequest="45" Padding="14,0">
                        <Entry Text="{Binding FuelStation}" IsReadOnly="True" BackgroundColor="Transparent" VerticalOptions="Center" HorizontalTextAlignment="End">
                            <Entry.Triggers>
                                <DataTrigger TargetType="Entry" Binding="{Binding IsFuelStationEditable}" Value="True">
                                    <Setter Property="IsReadOnly" Value="False" />
                                </DataTrigger>
                            </Entry.Triggers>
                        </Entry>
                    </Border>

                    <HorizontalStackLayout Grid.Row="3" Grid.Column="0" Spacing="6" VerticalOptions="Center">
                        <Label Text="Date" VerticalOptions="Center" TextColor="{StaticResource LargaDarkText}" FontSize="15" />
                        <Label Text="Edited" IsVisible="{Binding IsReceiptDateManuallyEdited}" VerticalOptions="Center" TextColor="#B45309" FontSize="11" FontAttributes="Bold" />
                    </HorizontalStackLayout>
                    <Border Grid.Row="3" Grid.Column="1" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16" HeightRequest="45" Padding="14,0">
                        <Entry Text="{Binding ReceiptDateText}" IsReadOnly="True" BackgroundColor="Transparent" VerticalOptions="Center" HorizontalTextAlignment="End">
                            <Entry.Triggers>
                                <DataTrigger TargetType="Entry" Binding="{Binding IsReceiptDateEditable}" Value="True">
                                    <Setter Property="IsReadOnly" Value="False" />
                                </DataTrigger>
                            </Entry.Triggers>
                        </Entry>
                    </Border>

                    <Label Grid.Row="4" Grid.Column="0" Text="Odometer" VerticalOptions="Center" TextColor="{StaticResource LargaDarkText}" FontSize="15" />
                    <Grid Grid.Row="4" Grid.Column="1">
                        <Button Text="📷 Scan odometer dashboard" Command="{Binding ScanOdometerCommand}" BackgroundColor="White" TextColor="Black" CornerRadius="16" HeightRequest="45" HorizontalOptions="Fill" VerticalOptions="Fill">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsOdometerScanned}" Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16" HeightRequest="52" Padding="14,0" IsVisible="False">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsOdometerScanned}" Value="True">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ScanOdometerCommand}" />
                            </Border.GestureRecognizers>
                            <Entry Text="{Binding Odometer}" IsReadOnly="True" InputTransparent="True" BackgroundColor="Transparent" VerticalOptions="Center" HorizontalTextAlignment="End" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <HorizontalStackLayout Spacing="10">
                <Border BackgroundColor="Transparent" StrokeThickness="1" Stroke="{StaticResource LargaPrimaryBlue}" StrokeShape="RoundRectangle 20" Padding="0" HeightRequest="46" HorizontalOptions="FillAndExpand">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding HasPhoto}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Button Text="📷 Scan fuel receipt photo" Command="{Binding ScanReceiptCommand}"
                            BackgroundColor="Transparent" TextColor="{StaticResource LargaPrimaryBlue}" FontSize="14" />
                </Border>

                <Border BackgroundColor="Transparent" StrokeThickness="1" Stroke="{StaticResource LargaPrimaryBlue}" StrokeShape="RoundRectangle 20" Padding="0" HeightRequest="46" IsVisible="{Binding HasPhoto}">
                    <Button Text="Redo" Command="{Binding RedoReceiptCommand}"
                            BackgroundColor="Transparent" TextColor="{StaticResource LargaPrimaryBlue}" FontSize="14" Padding="18,0" />
                </Border>
            </HorizontalStackLayout>

            <Label Text="{Binding ReceiptParsingWarning}"
                   IsVisible="{Binding IsReceiptParsingUncertain}"
                   TextColor="#B45309"
                   FontSize="12" />

            <!-- Scanned Photo Preview -->
            <Border IsVisible="{Binding HasPhoto}" BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Image Source="{Binding ReceiptPhoto}" HeightRequest="250" Aspect="AspectFit" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Submit" Command="{Binding SubmitReportCommand}" IsEnabled="{Binding CanSubmit}"
                    BackgroundColor="#AEE2F0" TextColor="#7A8A99"
                    CornerRadius="25" HeightRequest="55" FontSize="16" FontAttributes="Bold" Margin="0,10,0,20">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding CanSubmit}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource LargaPrimaryBlue}" />
                        <Setter Property="TextColor" Value="{StaticResource LargaWhite}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>