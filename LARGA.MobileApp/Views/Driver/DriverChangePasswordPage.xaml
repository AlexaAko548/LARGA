<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             x:Class="LARGA.MobileApp.Views.Driver.DriverChangePasswordPage"
             x:DataType="vm:DriverChangePasswordViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource LargaWhite}">

    <ScrollView>
        <VerticalStackLayout Padding="20,0" Spacing="15">

            <Label Text="Change Password"
                   FontSize="32"
                   Style="{StaticResource HeaderStyle}"
                   TextColor="{StaticResource LargaDarkText}"
				   Margin="0,-10,0,0" />

            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 15" StrokeThickness="0" Padding="20,10">
                <Entry Text="{Binding CurrentPassword}" Placeholder="Current Password" IsPassword="True" BackgroundColor="Transparent"
                       TextColor="{StaticResource LargaDarkText}" PlaceholderColor="#777777" FontSize="16" />
            </Border>

            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 15" StrokeThickness="0" Padding="20,10">
                <Entry Text="{Binding NewPassword}" Placeholder="New Password" IsPassword="True" BackgroundColor="Transparent"
                       TextColor="{StaticResource LargaDarkText}" PlaceholderColor="#777777" FontSize="16" />
            </Border>

            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 15" StrokeThickness="0" Padding="20,10">
                <Entry Text="{Binding ConfirmNewPassword}" Placeholder="Confirm New Password" IsPassword="True" BackgroundColor="Transparent"
                       TextColor="{StaticResource LargaDarkText}" PlaceholderColor="#777777" FontSize="16" />
            </Border>

            <Button Text="CONFIRM &amp; SAVE"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="{StaticResource LargaPrimaryBlue}"
                    TextColor="{StaticResource LargaWhite}"
                    CornerRadius="42"
                    HeightRequest="84"
                    FontSize="24"
                    Style="{StaticResource HeaderStyle}"
                    Margin="0,100,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
