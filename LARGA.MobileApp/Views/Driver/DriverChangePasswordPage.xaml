<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Driver"
             xmlns:shared="clr-namespace:LARGA.MobileApp.ViewModels.Shared"
             xmlns:controls="clr-namespace:LARGA.MobileApp.Controls"
             x:Class="LARGA.MobileApp.Views.Driver.DriverChangePasswordPage"
             x:DataType="vm:DriverChangePasswordViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource ThemeSurface}">

    <ScrollView>
        <VerticalStackLayout Padding="20,0" Spacing="15" Margin="0,10">

            <Label Text="Change Password" FontSize="32" Style="{StaticResource HeaderStyle}" TextColor="{DynamicResource LargaDarkText}" />

            <Border BackgroundColor="{DynamicResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15,5,5,5">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Text="{Binding CurrentPassword}" Placeholder="Current Password" IsPassword="{Binding CurrentPasswordField.IsHidden}" BackgroundColor="Transparent"
                           TextColor="{DynamicResource LargaDarkText}" PlaceholderColor="{DynamicResource ThemeTextSecondary}" VerticalOptions="Center" />
                    <ImageButton Grid.Column="1" Source="{Binding CurrentPasswordField.Icon}" Command="{Binding CurrentPasswordField.ToggleCommand}"
                                 SemanticProperties.Description="{Binding CurrentPasswordField.Description}" controls:ThemedIcon.IsEnabled="True"
                                 WidthRequest="44" HeightRequest="44" Padding="10" BackgroundColor="Transparent" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border BackgroundColor="{DynamicResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15,5,5,5">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Text="{Binding NewPassword}" Placeholder="New Password" IsPassword="{Binding NewPasswordField.IsHidden}" BackgroundColor="Transparent"
                           TextColor="{DynamicResource LargaDarkText}" PlaceholderColor="{DynamicResource ThemeTextSecondary}" VerticalOptions="Center" />
                    <ImageButton Grid.Column="1" Source="{Binding NewPasswordField.Icon}" Command="{Binding NewPasswordField.ToggleCommand}"
                                 SemanticProperties.Description="{Binding NewPasswordField.Description}" controls:ThemedIcon.IsEnabled="True"
                                 WidthRequest="44" HeightRequest="44" Padding="10" BackgroundColor="Transparent" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Password policy (InputValidator.PasswordRules), ticked off while typing -->
            <VerticalStackLayout Spacing="2" Padding="5,0" BindableLayout.ItemsSource="{Binding PasswordRules}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="shared:PasswordRuleStatus">
                        <Label FontSize="13" TextColor="{DynamicResource ThemeTextSecondary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Glyph}" />
                                    <Span Text="  " />
                                    <Span Text="{Binding Text}" />
                                </FormattedString>
                            </Label.FormattedText>
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsMet}" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource LargaSuccess}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Border BackgroundColor="{DynamicResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15,5,5,5">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Text="{Binding ConfirmNewPassword}" Placeholder="Confirm New Password" IsPassword="{Binding ConfirmPasswordField.IsHidden}" BackgroundColor="Transparent"
                           TextColor="{DynamicResource LargaDarkText}" PlaceholderColor="{DynamicResource ThemeTextSecondary}" VerticalOptions="Center" />
                    <ImageButton Grid.Column="1" Source="{Binding ConfirmPasswordField.Icon}" Command="{Binding ConfirmPasswordField.ToggleCommand}"
                                 SemanticProperties.Description="{Binding ConfirmPasswordField.Description}" controls:ThemedIcon.IsEnabled="True"
                                 WidthRequest="44" HeightRequest="44" Padding="10" BackgroundColor="Transparent" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Label Text="Passwords don't match." FontSize="13" TextColor="{DynamicResource LargaDanger}" Padding="5,0" IsVisible="{Binding ShowMismatch}" />

            <!-- Faded until the form can be saved; shrinks slightly while pressed -->
            <Button Text="CONFIRM &amp; SAVE" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
                    BackgroundColor="{DynamicResource LargaPrimaryBlue}" TextColor="{DynamicResource LargaWhite}"
                    CornerRadius="25" HeightRequest="55" FontSize="16" FontAttributes="Bold" Margin="0,15,0,20">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Scale" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.85" />
                                <Setter Property="Scale" Value="0.97" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Scale" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
