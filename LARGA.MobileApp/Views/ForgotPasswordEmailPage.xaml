<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels"
             x:Class="LARGA.MobileApp.Views.ForgotPasswordEmailPage"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *">
        <!-- Curved Background -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                BackgroundColor="{StaticResource LargaLightBlue}"
                StrokeShape="RoundRectangle 0,0,50,50"
                StrokeThickness="0"
                VerticalOptions="Start"
                HeightRequest="500" />

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20">
            <ImageButton Source="back_icon.png" HorizontalOptions="Start" WidthRequest="24" BackgroundColor="Transparent" Clicked="OnBackButtonClicked" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Padding="30" Spacing="0" VerticalOptions="FillAndExpand">

            <Label Text="Forgot password" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   TextColor="{StaticResource LargaDarkText}"
                   HorizontalOptions="Center" 
                   Margin="0, 40, 0, 10" />

            <Label Text="Please enter your email to receive a verification code."
                   HorizontalTextAlignment="Center"
                   FontSize="14"
                   Margin="0,0,0,50"
                   TextColor="{StaticResource LargaDarkText}"/>

            <Border Style="{StaticResource LargaEntryBorderStyle}">
                <Entry Placeholder="Email" Text="{Binding Email}" Style="{StaticResource LargaEntryStyle}" Keyboard="Email" />
            </Border>

            <!-- Bottom Spacer -->
            <BoxView HeightRequest="1" Color="Transparent" VerticalOptions="FillAndExpand" />

            <Button Text="Send email" Style="{StaticResource LargaButtonStyle}" Command="{Binding SendEmailCommand}" WidthRequest="200" HorizontalOptions="Center" Margin="0,0,0,20"/>
        </VerticalStackLayout>
    </Grid>

</ContentPage>