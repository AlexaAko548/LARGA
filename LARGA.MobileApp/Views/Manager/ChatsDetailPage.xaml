<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LARGA.MobileApp.Views.Manager.ChatsDetailPage"
             BackgroundColor="{StaticResource LargaWhite}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Custom Header -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource LargaLightBlue}" Padding="15,10" ColumnDefinitions="Auto, *, Auto">
            <ImageButton Grid.Column="0" Source="back_icon.png" WidthRequest="32" Margin="-10,-10,0,0" HeightRequest="32" Aspect="AspectFit" Padding="10" BackgroundColor="Transparent" Command="{Binding GoBackCommand}" />
            <Label Grid.Column="1" Text="{Binding DriverName}" TextColor="{StaticResource LargaDarkText}" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" Margin="10,0,0,0" />
            <ImageButton Grid.Column="2" Source="phone.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" Padding="8" BackgroundColor="Transparent" Command="{Binding CallDriverCommand}" />
        </Grid>

        <!-- Chat Area -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Messages}" Margin="20" VerticalScrollBarVisibility="Never" ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="20" Margin="0,0,0,15" MaximumWidthRequest="250">
                        <Border.Style>
                            <Style TargetType="Border">
                                <!-- Default style (Manager messages go to the right, blue) -->
                                <Setter Property="HorizontalOptions" Value="End" />
                                <Setter Property="BackgroundColor" Value="{StaticResource LargaPrimaryBlue}" />
                                <Style.Triggers>
                                    <!-- Driver messages go to the left, gray -->
                                    <DataTrigger TargetType="Border" Binding="{Binding IsDriver}" Value="True">
                                        <Setter Property="HorizontalOptions" Value="Start" />
                                        <Setter Property="BackgroundColor" Value="Gray" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Label Text="{Binding Text}" TextColor="{StaticResource LargaWhite}" FontSize="14" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Input Area -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Padding="15,10,15,20" BackgroundColor="{StaticResource LargaWhite}">
            <Border Grid.Column="0" BackgroundColor="{StaticResource LargaLightBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 25" HeightRequest="50">
                <Entry Text="{Binding NewMessage}" Placeholder="Aa" PlaceholderColor="{StaticResource LargaDarkText}" TextColor="{StaticResource LargaDarkText}" BackgroundColor="Transparent" Margin="15,0" VerticalOptions="Center" />
            </Border>
            <ImageButton Grid.Column="1" Command="{Binding SendMessageCommand}" Source="{Binding SubmitIcon}" WidthRequest="44" HeightRequest="44" Aspect="AspectFit" Padding="8" BackgroundColor="Transparent" Margin="10,0,0,0" VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>