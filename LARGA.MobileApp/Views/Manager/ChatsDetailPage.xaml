<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:LARGA.MobileApp.Controls"
             x:Class="LARGA.MobileApp.Views.Manager.ChatsDetailPage"
             BackgroundColor="{DynamicResource ThemeSurface}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Custom Header -->
        <Grid Grid.Row="0" BackgroundColor="{DynamicResource LargaLightBlue}" Padding="15,10" ColumnDefinitions="Auto, *, Auto">
            <ImageButton controls:ThemedIcon.IsEnabled="True" Grid.Column="0" Source="back_icon.png" WidthRequest="32" Margin="-10,-10,0,0" HeightRequest="32" Aspect="AspectFit" Padding="10" BackgroundColor="Transparent" Command="{Binding GoBackCommand}" />
            <Label Grid.Column="1" Text="{Binding DriverName}" TextColor="{DynamicResource LargaDarkText}" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" Margin="10,0,0,0" />
            <ImageButton controls:ThemedIcon.IsEnabled="True" Grid.Column="2" Source="phone.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" Padding="8" BackgroundColor="Transparent" Command="{Binding CallDriverCommand}" />
        </Grid>

        <!-- Chat Area -->
        <CollectionView x:Name="MessagesCollectionView" Grid.Row="1" ItemsSource="{Binding Messages}" Margin="20" VerticalScrollBarVisibility="Never" ItemsUpdatingScrollMode="KeepLastItemInView">
            <!-- Shown while chats/{driverId}/messages is empty (the chat doc is only created on the first send) -->
            <CollectionView.EmptyView>
                <Label Text="{Binding EmptyStateText}" IsVisible="{Binding HasLoadedMessages}" TextColor="{DynamicResource ThemeTextGray}" FontSize="14"
                       HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 15" Padding="20" Margin="0,0,0,15" MaximumWidthRequest="250">
                        <Border.Style>
                            <Style TargetType="Border">
                                <!-- Shared conversation: the viewer's own messages on the right (blue);
                                     the driver's on the left (gray); other staff on the left (light blue). -->
                                <Setter Property="HorizontalOptions" Value="Start" />
                                <Setter Property="BackgroundColor" Value="Gray" />
                                <Style.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsOtherStaff}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource LargaLightBlue}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsMine}" Value="True">
                                        <Setter Property="HorizontalOptions" Value="End" />
                                        <Setter Property="BackgroundColor" Value="{DynamicResource LargaPrimaryBlue}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <VerticalStackLayout Spacing="4">
                            <!-- Shared conversation: who on the staff side wrote it -->
                            <Label Text="{Binding SenderLabel}" IsVisible="{Binding ShowSender}" FontSize="11" FontAttributes="Bold" Opacity="0.85">
                                <Label.Style>
                                    <Style TargetType="Label">
                                        <Setter Property="TextColor" Value="{DynamicResource LargaWhite}" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsOtherStaff}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource LargaDarkText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                            <Label Text="{Binding Text}" FontSize="14">
                                <Label.Style>
                                    <Style TargetType="Label">
                                        <Setter Property="TextColor" Value="{DynamicResource LargaWhite}" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsOtherStaff}" Value="True">
                                                <Setter Property="TextColor" Value="{DynamicResource LargaDarkText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Input Area -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Padding="15,10,15,20" BackgroundColor="{DynamicResource ThemeSurface}">
            <Border Grid.Column="0" BackgroundColor="{DynamicResource LargaLightBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 25" HeightRequest="50">
                <Entry Text="{Binding NewMessage}" Placeholder="Aa" PlaceholderColor="{DynamicResource LargaDarkText}" TextColor="{DynamicResource LargaDarkText}" BackgroundColor="Transparent" Margin="15,0" VerticalOptions="Center" />
            </Border>
            <ImageButton controls:ThemedIcon.IsEnabled="True" Grid.Column="1" Command="{Binding SendMessageCommand}" Source="{Binding SubmitIcon}" WidthRequest="44" HeightRequest="44" Aspect="AspectFit" Padding="8" BackgroundColor="Transparent" Margin="10,0,0,0" VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>