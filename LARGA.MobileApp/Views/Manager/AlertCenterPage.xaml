<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Manager"
             xmlns:local="clr-namespace:LARGA.MobileApp.Views.Manager"
             x:Class="LARGA.MobileApp.Views.Manager.AlertCenterPage"
             x:Name="Root"
             x:DataType="vm:AlertCenterViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- SOS TEMPLATE -->
            <DataTemplate x:Key="SosTemplate" x:DataType="vm:AlertItem">
                <Border BackgroundColor="#AEE2F0" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16" Margin="0,0,0,12">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Image Grid.Column="0" Source="warning_icon.png" WidthRequest="24" HeightRequest="24" />
                            <Label Grid.Column="1" Text="EMERGENCY SOS ALERT" FontAttributes="Bold" FontSize="13"
                                   TextColor="#D32F2F" Margin="8,0,0,0" VerticalOptions="Center" />
                            <ImageButton Grid.Column="2" Source="close_icon.svg" WidthRequest="24" HeightRequest="24"
                                         BackgroundColor="Transparent"
                                         Command="{Binding Source={x:Reference Root}, Path=BindingContext.DismissAlertCommand}"
                                         CommandParameter="{Binding .}" />
                        </Grid>
                        <Label Text="{Binding DriverName}" FontAttributes="Bold" FontSize="18" TextColor="Black" />
                        <Label Text="{Binding Subtitle}" FontSize="13" TextColor="#555555" />
                        <Label Text="{Binding Timestamp}" FontSize="13" TextColor="#777777" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,8,0,0">
                            <Border Grid.Column="0" BackgroundColor="White" StrokeShape="RoundRectangle 12" HeightRequest="46">
                                <ImageButton Source="car.svg" WidthRequest="20" HeightRequest="20" BackgroundColor="Transparent"
                                             Command="{Binding Source={x:Reference Root}, Path=BindingContext.ViewLocationCommand}"
                                             CommandParameter="{Binding .}" />
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="White" StrokeShape="RoundRectangle 12" HeightRequest="46">
                                <ImageButton Source="phone.svg" WidthRequest="20" HeightRequest="20" BackgroundColor="Transparent"
                                             Command="{Binding Source={x:Reference Root}, Path=BindingContext.CallDriverCommand}"
                                             CommandParameter="{Binding .}" />
                            </Border>
                            <Border Grid.Column="2" BackgroundColor="White" StrokeShape="RoundRectangle 12" HeightRequest="46">
                                <ImageButton Source="send_icon.svg" WidthRequest="20" HeightRequest="20" BackgroundColor="Transparent"
                                             Command="{Binding Source={x:Reference Root}, Path=BindingContext.MessageDriverCommand}"
                                             CommandParameter="{Binding .}" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>

            <!-- FUEL DISCREPANCY TEMPLATE -->
            <DataTemplate x:Key="FuelDiscrepancyTemplate" x:DataType="vm:AlertItem">
                <Border BackgroundColor="#AEE2F0" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16" Margin="0,0,0,12">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Image Grid.Column="0" Source="report.svg" WidthRequest="24" HeightRequest="24" />
                            <Label Grid.Column="1" Text="FUEL DISCREPANCY" FontAttributes="Bold" FontSize="13"
                                   TextColor="#E53935" Margin="8,0,0,0" VerticalOptions="Center" />
                            <ImageButton Grid.Column="2" Source="close_icon.svg" WidthRequest="24" HeightRequest="24"
                                         BackgroundColor="Transparent"
                                         Command="{Binding Source={x:Reference Root}, Path=BindingContext.DismissAlertCommand}"
                                         CommandParameter="{Binding .}" />
                        </Grid>
                        <Label Text="{Binding DriverName}" FontAttributes="Bold" FontSize="18" TextColor="Black" />
                        <Label Text="{Binding Subtitle}" FontSize="13" TextColor="#555555" />
                        <Label Text="{Binding Timestamp}" FontSize="13" TextColor="#777777" />

                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" HeightRequest="48" Margin="0,8,0,0">
                            <Button Text="DISMISS" BackgroundColor="Transparent" TextColor="Black" FontAttributes="Bold" FontSize="14"
                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.DismissAlertCommand}"
                                    CommandParameter="{Binding .}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>

            <!-- SHIFT APPROVAL TEMPLATE -->
            <DataTemplate x:Key="ShiftApprovalTemplate" x:DataType="vm:AlertItem">
                <Border BackgroundColor="#AEE2F0" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="16" Margin="0,0,0,12">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Image Grid.Column="0" Source="warning_icon.png" WidthRequest="24" HeightRequest="24" />
                            <Label Grid.Column="1" Text="SHIFT APPROVAL REQUIRED" FontAttributes="Bold" FontSize="13"
                                   TextColor="#D32F2F" Margin="8,0,0,0" VerticalOptions="Center" />
                            <ImageButton Grid.Column="2" Source="close_icon.svg" WidthRequest="24" HeightRequest="24"
                                         BackgroundColor="Transparent"
                                         Command="{Binding Source={x:Reference Root}, Path=BindingContext.DismissAlertCommand}"
                                         CommandParameter="{Binding .}" />
                        </Grid>
                        <Label Text="{Binding DriverName}" FontAttributes="Bold" FontSize="18" TextColor="Black" />
                        <Label Text="{Binding Timestamp}" FontSize="13" TextColor="#777777" />

                        <BoxView HeightRequest="1" Color="#8FC3E0" Margin="0,6" />

                        <Label Text="🔴 PRE-SHIFT DEFECT REPORTED" FontAttributes="Bold" FontSize="12" TextColor="#E53935" />

                        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                            <Label Grid.Row="0" Grid.Column="0" Text="FAILED ITEM:" FontSize="12" TextColor="#777777" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding FailedItem}" FontSize="14" TextColor="Black" />
                            <Label Grid.Row="1" Grid.Column="0" Text="PRIORITY:" FontSize="12" TextColor="#777777" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Priority}" FontSize="14" TextColor="Black" />
                        </Grid>

                        <Label Text="DRIVER'S DESCRIPTION:" FontSize="12" TextColor="#777777" Margin="0,4,0,0" />
                        <Label Text="{Binding DriverDescription}" FontSize="14" TextColor="Black" />

                        <BoxView HeightRequest="1" Color="#8FC3E0" Margin="0,6" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border Grid.Column="0" BackgroundColor="White" StrokeShape="RoundRectangle 12" HeightRequest="50">
                                <Button Text="Deny &amp; Send to Garage" BackgroundColor="Transparent" TextColor="Black" FontSize="12" FontAttributes="Bold"
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.DenyShiftCommand}"
                                        CommandParameter="{Binding .}" />
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="White" StrokeShape="RoundRectangle 12" HeightRequest="50">
                                <Button Text="Approve Shift" BackgroundColor="Transparent" TextColor="Black" FontSize="14" FontAttributes="Bold"
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.ApproveShiftCommand}"
                                        CommandParameter="{Binding .}" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>

            <local:AlertTemplateSelector x:Key="AlertSelector"
                                          SosTemplate="{StaticResource SosTemplate}"
                                          FuelDiscrepancyTemplate="{StaticResource FuelDiscrepancyTemplate}"
                                          ShiftApprovalTemplate="{StaticResource ShiftApprovalTemplate}" />

        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label Text="Alert Center" FontSize="28" FontAttributes="Bold" TextColor="Black" />
            <Label Text="{Binding Alerts.Count, StringFormat='{0} active notifications'}" FontSize="14" TextColor="Gray" Margin="0,0,0,8" />

            <CollectionView ItemsSource="{Binding Alerts}" ItemTemplate="{StaticResource AlertSelector}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>