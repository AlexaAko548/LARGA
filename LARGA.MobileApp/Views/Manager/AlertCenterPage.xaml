<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LARGA.MobileApp.Views.Manager.AlertCenterPage"
             Title="Alert Center">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="12">

            <Label Text="Alert Center"
                   FontSize="24"
                   FontAttributes="Bold" />

            <Label x:Name="ActiveNotificationsLabel"
                   Text="0 active notifications"
                   FontSize="14"
                   TextColor="Gray" />

            <CollectionView x:Name="AlertsCollectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#1976D2"
                               BackgroundColor="#E3F2FD"
                               Padding="12"
                               CornerRadius="8"
                               Margin="0,5">
                            <VerticalStackLayout Spacing="6">

                                <Label Text="SHIFT APPROVAL REQUIRED"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       TextColor="#D32F2F" />

                                <Label Text="{Binding DriverName}"
                                       FontAttributes="Bold" />

                                <Label Text="{Binding UnitLabel}"
                                       FontSize="13"
                                       TextColor="Gray" />

                                <BoxView HeightRequest="1" Color="LightGray" />

                                <Label Text="{Binding FailedItemLabel}" FontSize="13" />
                                <Label Text="{Binding PriorityLabel}" FontSize="13" />
                                <Label Text="{Binding DriverDescription}" FontSize="13" />

                                <HorizontalStackLayout Spacing="10" Margin="0,8,0,0">
                                    <Button Text="Deny &amp; Send to Garage"
                                            BackgroundColor="#D32F2F"
                                            TextColor="White"
                                            CommandParameter="{Binding ChecklistId}"
                                            Clicked="OnDenyClicked" />
                                    <Button Text="Approve Shift"
                                            BackgroundColor="#388E3C"
                                            TextColor="White"
                                            CommandParameter="{Binding ChecklistId}"
                                            Clicked="OnApproveClicked" />
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>