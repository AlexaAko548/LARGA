<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Manager"
             xmlns:local="clr-namespace:LARGA.MobileApp.Views.Manager"
             x:Class="LARGA.MobileApp.Views.Manager.AlertCenterPage"
             x:Name="Root"
             x:DataType="vm:AlertCenterViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource LargaPageBg}">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- SOS TEMPLATE -->
            <DataTemplate x:Key="SosTemplate" x:DataType="vm:AlertItem">
                <Border Style="{StaticResource ManagerCardStyle}" Margin="0,0,0,12">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0" Style="{StaticResource IconChipStyle}" BackgroundColor="{StaticResource LargaDangerBg}">
                                <Label Text="🆘" Style="{StaticResource IconChipGlyphStyle}" FontSize="15" />
                            </Border>
                            <Label Grid.Column="1" Text="EMERGENCY SOS ALERT" FontAttributes="Bold" FontSize="12" CharacterSpacing="0.6"
                                   TextColor="{StaticResource LargaDanger}" VerticalOptions="Center" />
                            <ImageButton Grid.Column="2" Source="close_icon.svg" WidthRequest="18" HeightRequest="18"
                                         BackgroundColor="Transparent" VerticalOptions="Center"
                                         Command="{Binding Source={x:Reference Root}, Path=BindingContext.DismissAlertCommand}"
                                         CommandParameter="{Binding .}" />
                        </Grid>
                        <Label Text="{Binding DriverName}" FontAttributes="Bold" FontSize="17" TextColor="{StaticResource LargaNavy}" />
                        <Label Text="{Binding Subtitle}" FontSize="13" TextColor="{StaticResource LargaMutedText}" />
                        <Label Text="{Binding Timestamp}" FontSize="12" TextColor="{StaticResource LargaMutedText}" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,6,0,0">
                            <Border Grid.Column="0" BackgroundColor="{StaticResource LargaAccentBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="54">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.ViewLocationCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image Source="car.svg" WidthRequest="16" HeightRequest="16" />
                                    <Label Text="Locate" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource LargaPrimaryBlue}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource LargaAccentBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="54">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.CallDriverCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image Source="phone.svg" WidthRequest="16" HeightRequest="16" />
                                    <Label Text="Call" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource LargaPrimaryBlue}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" BackgroundColor="{StaticResource LargaAccentBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="54">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.MessageDriverCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image Source="send_icon.svg" WidthRequest="16" HeightRequest="16" />
                                    <Label Text="Message" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource LargaPrimaryBlue}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>

            <!-- FUEL DISCREPANCY TEMPLATE -->
            <DataTemplate x:Key="FuelDiscrepancyTemplate" x:DataType="vm:AlertItem">
                <Border Style="{StaticResource ManagerCardStyle}" Margin="0,0,0,12">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0" Style="{StaticResource IconChipStyle}" BackgroundColor="{StaticResource LargaWarningBg}">
                                <Label Text="⛽" Style="{StaticResource IconChipGlyphStyle}" FontSize="15" />
                            </Border>
                            <Label Grid.Column="1" Text="FUEL DISCREPANCY" FontAttributes="Bold" FontSize="12" CharacterSpacing="0.6"
                                   TextColor="{StaticResource LargaWarning}" VerticalOptions="Center" />
                            <ImageButton Grid.Column="2" Source="close_icon.svg" WidthRequest="18" HeightRequest="18"
                                         BackgroundColor="Transparent" VerticalOptions="Center"
                                         Command="{Binding Source={x:Reference Root}, Path=BindingContext.DismissAlertCommand}"
                                         CommandParameter="{Binding .}" />
                        </Grid>
                        <Label Text="{Binding DriverName}" FontAttributes="Bold" FontSize="17" TextColor="{StaticResource LargaNavy}" />
                        <Label Text="{Binding Subtitle}" FontSize="13" TextColor="{StaticResource LargaMutedText}" />
                        <Label Text="{Binding Timestamp}" FontSize="12" TextColor="{StaticResource LargaMutedText}" />

                        <Border BackgroundColor="{StaticResource LargaAccentBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="46" Margin="0,6,0,0">
                            <Button Text="DISMISS" BackgroundColor="Transparent" TextColor="{StaticResource LargaNavy}" FontAttributes="Bold" FontSize="13"
                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.DismissAlertCommand}"
                                    CommandParameter="{Binding .}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>

            <!-- SHIFT APPROVAL TEMPLATE -->
            <DataTemplate x:Key="ShiftApprovalTemplate" x:DataType="vm:AlertItem">
                <Border Style="{StaticResource ManagerCardStyle}" Margin="0,0,0,12">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0" Style="{StaticResource IconChipStyle}" BackgroundColor="{StaticResource LargaDangerBg}">
                                <Label Text="⚠" Style="{StaticResource IconChipGlyphStyle}" FontSize="17" TextColor="{StaticResource LargaDanger}" />
                            </Border>
                            <Label Grid.Column="1" Text="SHIFT APPROVAL REQUIRED" FontAttributes="Bold" FontSize="12" CharacterSpacing="0.6"
                                   TextColor="{StaticResource LargaDanger}" VerticalOptions="Center" />
                            <ImageButton Grid.Column="2" Source="close_icon.svg" WidthRequest="18" HeightRequest="18"
                                         BackgroundColor="Transparent" VerticalOptions="Center"
                                         Command="{Binding Source={x:Reference Root}, Path=BindingContext.DismissAlertCommand}"
                                         CommandParameter="{Binding .}" />
                        </Grid>
                        <Label Text="{Binding DriverName}" FontAttributes="Bold" FontSize="17" TextColor="{StaticResource LargaNavy}" />
                        <Label Text="{Binding Timestamp}" FontSize="12" TextColor="{StaticResource LargaMutedText}" />

                        <BoxView HeightRequest="1" Color="{StaticResource LargaCardBorder}" Margin="0,2" />

                        <Border BackgroundColor="{StaticResource LargaDangerBg}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="9,5" HorizontalOptions="Start">
                            <Label Text="PRE-SHIFT DEFECT REPORTED" FontAttributes="Bold" FontSize="10" CharacterSpacing="0.4" TextColor="{StaticResource LargaDanger}" />
                        </Border>

                        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="6" Margin="0,4,0,0">
                            <Label Grid.Row="0" Grid.Column="0" Text="FAILED ITEM" Style="{StaticResource EyebrowLabelStyle}" FontSize="11" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding FailedItem}" FontSize="14" TextColor="{StaticResource LargaNavy}" />
                            <Label Grid.Row="1" Grid.Column="0" Text="PRIORITY" Style="{StaticResource EyebrowLabelStyle}" FontSize="11" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Priority}" FontSize="14" TextColor="{StaticResource LargaNavy}" />
                        </Grid>

                        <Label Text="DRIVER'S DESCRIPTION" Style="{StaticResource EyebrowLabelStyle}" FontSize="11" Margin="0,6,0,0" />
                        <Label Text="{Binding DriverDescription}" FontSize="14" TextColor="{StaticResource LargaNavy}" />

                        <BoxView HeightRequest="1" Color="{StaticResource LargaCardBorder}" Margin="0,2" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border Grid.Column="0" BackgroundColor="{StaticResource LargaAccentBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="50">
                                <Button Text="Deny &amp; Send to Garage" BackgroundColor="Transparent" TextColor="{StaticResource LargaNavy}" FontSize="12" FontAttributes="Bold"
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.DenyShiftCommand}"
                                        CommandParameter="{Binding .}" />
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource LargaPrimaryBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="50">
                                <Button Text="Approve Shift" BackgroundColor="Transparent" TextColor="{StaticResource LargaWhite}" FontSize="14" FontAttributes="Bold"
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.ApproveShiftCommand}"
                                        CommandParameter="{Binding .}" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>

            <local:AlertTemplateSelector x:Key="AlertSelector"
                                          SosTemplate="{StaticResource SosTemplate}"
                                          FuelDiscrepancyTemplate="{StaticResource FuelDiscrepancyTemplate}"
                                          ShiftApprovalTemplate="{StaticResource ShiftApprovalTemplate}" />

        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label Text="Alert Center" FontSize="28" Style="{StaticResource HeaderStyle}" TextColor="{StaticResource LargaNavy}" />
            <Label Text="{Binding Alerts.Count, StringFormat='{0} active notifications'}" FontSize="14" TextColor="{StaticResource LargaMutedText}" Margin="0,0,0,8" />

            <CollectionView ItemsSource="{Binding Alerts}" ItemTemplate="{StaticResource AlertSelector}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>