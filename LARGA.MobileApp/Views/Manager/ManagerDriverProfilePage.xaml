<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Manager"
             x:Class="LARGA.MobileApp.Views.Manager.ManagerDriverProfilePage"
             x:DataType="vm:ManagerDriverProfileViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource LargaPageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="20,0" Spacing="14">

            <Label Text="&lt; Back" FontSize="14" TextColor="{StaticResource LargaPrimaryBlue}" Margin="0,15,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Label Text="Driver Profile" FontSize="28" Style="{StaticResource HeaderStyle}" TextColor="{StaticResource LargaNavy}" />

            <Border Style="{StaticResource ManagerCardStyle}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 30" HeightRequest="60" WidthRequest="60" BackgroundColor="{StaticResource LargaPrimaryBlue}" StrokeThickness="0">
                        <Label Text="{Binding Initials}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource LargaWhite}"
                               HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                        <Label Text="{Binding FullName}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource LargaNavy}" />
                        <Border BackgroundColor="{Binding StatusBgColor}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="9,3" HorizontalOptions="Start">
                            <Label Text="{Binding StatusText}" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.4" TextColor="{Binding StatusColor}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource ManagerCardStyle}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="LICENSE &amp; CREDENTIALS" Style="{StaticResource EyebrowLabelStyle}" Margin="0,0,0,8" />
                    <BoxView HeightRequest="1" Color="{StaticResource LargaCardBorder}" />

                    <Label Text="No details yet." FontSize="14" TextColor="{StaticResource LargaMutedText}" IsVisible="{Binding HasNoCredentials}"
                           HorizontalTextAlignment="Center" HorizontalOptions="Center" Margin="0,14,0,4" />

                    <VerticalStackLayout Spacing="0" IsVisible="{Binding HasCredentials}">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Grid.Column="0" Text="LTO License No." FontSize="13" TextColor="{StaticResource LargaMutedText}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding LicenseNumberDisplay}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource LargaNavy}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource LargaCardBorder}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Grid.Column="0" Text="Expiry Date" FontSize="13" TextColor="{StaticResource LargaMutedText}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding ExpiryDateDisplay}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource LargaNavy}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource LargaCardBorder}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                            <Label Grid.Column="0" Text="Status" FontSize="13" TextColor="{StaticResource LargaMutedText}" VerticalOptions="Center" />
                            <Border Grid.Column="1" BackgroundColor="{Binding StatusBgColor}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="9,3" HorizontalOptions="End">
                                <Label Text="{Binding StatusText}" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.4" TextColor="{Binding StatusColor}" />
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource LargaCardBorder}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,10,0,0">
                            <Label Grid.Column="0" Text="DL Codes" FontSize="13" TextColor="{StaticResource LargaMutedText}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding DlCodesDisplay}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource LargaNavy}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="Transparent" StrokeThickness="1.5" Stroke="{StaticResource LargaPrimaryBlue}" StrokeShape="RoundRectangle 20" Padding="0" HeightRequest="48" Margin="0,0,0,24">
                <Button Text="📷 SCAN &amp; UPDATE LICENSE" Command="{Binding UploadLicensePhotoCommand}"
                        BackgroundColor="Transparent" TextColor="{StaticResource LargaPrimaryBlue}" FontSize="13" FontAttributes="Bold" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
