<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Manager"
             x:Class="LARGA.MobileApp.Views.Manager.ManagerDriverProfilePage"
             x:DataType="vm:ManagerDriverProfileViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource LargaWhite}">

    <ScrollView>
        <VerticalStackLayout Padding="20,0" Spacing="15">

            <Label Text="&lt; Back" FontSize="14" TextColor="{StaticResource LargaPrimaryBlue}" Margin="0,15,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Label Text="Driver Profile" FontSize="32" Style="{StaticResource HeaderStyle}" TextColor="{StaticResource LargaDarkText}" />

            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="15">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 30" HeightRequest="60" WidthRequest="60" BackgroundColor="#777777" StrokeThickness="0" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding FullName}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" />
                        <Label Text="{Binding StatusText}" FontSize="13" TextColor="{Binding StatusColor}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="LICENSE &amp; CREDENTIALS" FontSize="12" TextColor="{StaticResource LargaDarkText}" CharacterSpacing="1" />
                    <BoxView HeightRequest="1" Color="#80BBD0" Margin="0,0,0,5" />

                    <Label Text="No details yet." FontSize="14" TextColor="#777777" IsVisible="{Binding HasNoCredentials}"
                           HorizontalTextAlignment="Center" HorizontalOptions="Center" Margin="0,5,0,5" />

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasCredentials}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="LTO License No." FontSize="13" TextColor="#555555" />
                            <Label Grid.Column="1" Text="{Binding LicenseNumberDisplay}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Expiry Date" FontSize="13" TextColor="#555555" />
                            <Label Grid.Column="1" Text="{Binding ExpiryDateDisplay}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Status" FontSize="13" TextColor="#555555" />
                            <Label Grid.Column="1" Text="{Binding StatusText}" FontSize="13" FontAttributes="Bold" TextColor="{Binding StatusColor}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="DL Codes" FontSize="13" TextColor="#555555" />
                            <Label Grid.Column="1" Text="{Binding DlCodesDisplay}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" HorizontalTextAlignment="End" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="Transparent" StrokeThickness="1" Stroke="{StaticResource LargaPrimaryBlue}" StrokeShape="RoundRectangle 20" Padding="0" HeightRequest="46">
                <Button Text="📷 SCAN &amp; UPDATE LICENSE" Command="{Binding UploadLicensePhotoCommand}"
                        BackgroundColor="Transparent" TextColor="{StaticResource LargaPrimaryBlue}" FontSize="13" FontAttributes="Bold" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
