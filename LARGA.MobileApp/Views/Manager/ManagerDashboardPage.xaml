<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Manager"
             x:Class="LARGA.MobileApp.Views.Manager.ManagerDashboardPage"
             x:DataType="vm:FleetMapViewModel"
             Title="Map"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource LargaPageBg}">

    <Grid>
        <!-- The Mapsui MapControl (renders MapTiler tiles) is built in code-behind and
             dropped into this host. Border clips its content to StrokeShape, so the map
             itself is confined to this rounded-rect viewport instead of running full-bleed
             behind the header/legend/chips. -->
        <Border x:Name="MapBorder" StrokeThickness="2" Stroke="{StaticResource LargaPrimaryBlue}" StrokeShape="RoundRectangle 16"
                Margin="10,172,10,84" Padding="0">
            <ContentView x:Name="MapHost" />
        </Border>

        <!-- Header + stat pills, floating over the map. Its own SizeChanged (wired in
             code-behind) pushes the map border's top margin below it, so the two never
             overlap even as header content grows (e.g. the date label). -->
        <VerticalStackLayout x:Name="HeaderStack" VerticalOptions="Start" Padding="16,50,16,0" Spacing="10">
            <Label Text="{Binding CurrentDateText}" FontSize="13" TextColor="{StaticResource LargaNavy}"
                   HorizontalOptions="Start" Margin="4,0,0,0" />
            <Border Style="{StaticResource ManagerCardStyle}" Padding="14,10">
                <Label Text="Live Fleet" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource LargaNavy}" />
            </Border>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0" BackgroundColor="{StaticResource LargaAccentBlue}" Stroke="{StaticResource LargaPrimaryBlue}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="6,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFilterCommand}" CommandParameter="{x:Static vm:FleetDriverStatus.Active}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                        <Label Text="{Binding ActiveCount}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource LargaNavy}" HorizontalOptions="Center" />
                        <Label Text="Active" FontSize="10" TextColor="{StaticResource LargaNavy}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="{StaticResource LargaAccentBlue}" Stroke="{StaticResource LargaPrimaryBlue}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="6,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFilterCommand}" CommandParameter="{x:Static vm:FleetDriverStatus.OnBreak}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                        <Label Text="{Binding OnBreakCount}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource LargaNavy}" HorizontalOptions="Center" />
                        <Label Text="On Break" FontSize="10" TextColor="{StaticResource LargaNavy}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" BackgroundColor="{StaticResource LargaAccentBlue}" Stroke="{StaticResource LargaPrimaryBlue}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="6,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFilterCommand}" CommandParameter="{x:Static vm:FleetDriverStatus.Idle}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                        <Label Text="{Binding IdleCount}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource LargaNavy}" HorizontalOptions="Center" />
                        <Label Text="Idle" FontSize="10" TextColor="{StaticResource LargaNavy}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="3" BackgroundColor="{StaticResource LargaAccentBlue}" Stroke="{StaticResource LargaPrimaryBlue}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="6,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFilterCommand}" CommandParameter="{x:Static vm:FleetDriverStatus.Sos}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                        <Label Text="{Binding SosCount}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource LargaNavy}" HorizontalOptions="Center" />
                        <Label Text="SOS" FontSize="10" TextColor="{StaticResource LargaNavy}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>

        <!-- Status legend - dark card floating over the map's bottom-left corner, above the
             unit shortcut row. -->
        <Border BackgroundColor="{StaticResource LargaNavy}" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                Padding="12,10" HorizontalOptions="Start" VerticalOptions="End" Margin="16,0,0,88"
                IsVisible="{Binding IsChipsRowVisible}">
            <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="8">
                    <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="#1E8E5A" />
                    <Label Text="Active" FontSize="12" TextColor="White" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="#C97A1B" />
                    <Label Text="On Break" FontSize="12" TextColor="White" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{StaticResource LargaDanger}" />
                    <Label Text="SOS" FontSize="12" TextColor="White" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{StaticResource LargaMutedText}" />
                    <Label Text="Idle" FontSize="12" TextColor="White" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Unit shortcuts - jump straight to any taxi, whether or not it currently has a
             pin on screen. Hidden while the detail sheet is open since both dock to the
             bottom edge. -->
        <ScrollView Orientation="Horizontal" VerticalOptions="End" Margin="0,0,0,16"
                    IsVisible="{Binding IsChipsRowVisible}">
            <HorizontalStackLayout Spacing="8" Padding="16,0" BindableLayout.ItemsSource="{Binding UnitChips}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:UnitChip">
                        <Border StrokeShape="RoundRectangle 20" Padding="12,8"
                                BackgroundColor="{StaticResource LargaAccentBlue}"
                                Stroke="{StaticResource LargaPrimaryBlue}"
                                StrokeThickness="{Binding SelectionStrokeThickness}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectUnitCommand}"
                                                       CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6">
                                <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{Binding StatusColor}" VerticalOptions="Center" />
                                <Label Text="{Binding UnitLabel}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource LargaNavy}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Selected driver bottom sheet -->
        <Border IsVisible="{Binding IsDetailVisible}" Style="{StaticResource ManagerCardStyle}"
                VerticalOptions="End" Margin="12,0,12,20">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                    <Border Grid.Column="0" WidthRequest="10" HeightRequest="10" StrokeThickness="0"
                            BackgroundColor="{Binding SelectedPin.StatusColor}" StrokeShape="Ellipse" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding SelectedPin.StatusLabel}" FontSize="12" FontAttributes="Bold"
                           CharacterSpacing="0.4" TextColor="{Binding SelectedPin.StatusColor}" VerticalOptions="Center" HorizontalOptions="Start" />
                    <Grid Grid.Column="2" WidthRequest="32" HeightRequest="32">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseDetailCommand}" />
                        </Grid.GestureRecognizers>
                        <Image Source="close_icon.svg" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                    </Grid>
                </Grid>

                <VerticalStackLayout Spacing="1">
                    <Label Text="{Binding SelectedPin.UnitLabel}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource LargaNavy}" />
                    <Label Text="{Binding SelectedPin.DriverName}" FontSize="14" TextColor="{StaticResource LargaMutedText}" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" BackgroundColor="{StaticResource LargaAccentBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,8">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="LOCATION" Style="{StaticResource EyebrowLabelStyle}" FontSize="10" />
                            <Label Text="{Binding SelectedLocationText}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource LargaNavy}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{StaticResource LargaAccentBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,8">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="ASSIGNED UNIT" Style="{StaticResource EyebrowLabelStyle}" FontSize="10" />
                            <Label Text="{Binding SelectedPin.PlateNumber}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource LargaNavy}" />
                            <Label Text="{Binding SelectedPin.UnitDetails}" FontSize="11" TextColor="{StaticResource LargaMutedText}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border BackgroundColor="{StaticResource LargaDangerBg}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10,6" IsVisible="{Binding SelectedPin.IsSos}">
                    <Label Text="⚠ SOS active — driver may need immediate assistance" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource LargaDanger}" />
                </Border>

                <BoxView HeightRequest="1" BackgroundColor="{StaticResource LargaCardBorder}" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                    <HorizontalStackLayout Grid.Column="0" Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CallCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Image Source="phone.svg" WidthRequest="15" HeightRequest="15">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{Binding SelectedPin.CallAccentColor}" />
                            </Image.Behaviors>
                        </Image>
                        <Label Text="Call" FontSize="13" FontAttributes="Bold" TextColor="{Binding SelectedPin.CallAccentColor}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding MessageCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Image Source="send_icon.svg" WidthRequest="15" HeightRequest="15" />
                        <Label Text="Message" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource LargaPrimaryBlue}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Image Source="car.svg" WidthRequest="15" HeightRequest="15" />
                        <Label Text="Navigate" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource LargaPrimaryBlue}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
