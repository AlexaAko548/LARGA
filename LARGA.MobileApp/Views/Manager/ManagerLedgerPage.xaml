<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Manager"
             xmlns:models="clr-namespace:LARGA.MobileApp.Models"
             x:Class="LARGA.MobileApp.Views.Manager.ManagerLedgerPage"
             x:DataType="vm:ManagerLedgerViewModel"
             x:Name="RootPage"
             BackgroundColor="#FFFFFF"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- MAIN CONTENT -->
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">
                <!-- Header -->
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Quick Ledger"
                               FontSize="28"
                               LineBreakMode="NoWrap"
                               FontAttributes="Bold"
                               TextColor="#111827"
                               FontFamily="BarlowCondensedBold" />
                        <Label Text="{Binding PendingCount, StringFormat='{0} pending clearances'}" FontSize="14" TextColor="#6B7280" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="+ Other Payment"
                            Command="{Binding OpenOtherPaymentCommand}"
                            BackgroundColor="#019BCF"
                            TextColor="White"
                            CornerRadius="20"
                            FontSize="16"
                            FontFamily="BarlowCondensedBold"
                            Padding="14,4"
                            HeightRequest="40"
                            VerticalOptions="Center"
                            HorizontalOptions="End" />
                </Grid>

                <!-- PENDING SECTION -->
                <Label Text="PENDING" FontSize="13" FontAttributes="Bold" TextColor="#1D1D1D" Margin="0,8,0,0" />

                <CollectionView ItemsSource="{Binding PendingClearances}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:LedgerItemModel">
                            <Border StrokeShape="RoundRectangle 16" BackgroundColor="#A6DCEE" StrokeThickness="0" Margin="0,0,0,12" Padding="14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.OpenRecordPaymentCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="10">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="👤" FontSize="16" VerticalOptions="Center" />
                                        <VerticalStackLayout>
                                            <Label Text="{Binding DriverName}" FontAttributes="Bold" TextColor="#1D1D1D" FontSize="16" />
                                            <Label Text="{Binding PlateNumber}" FontSize="11" TextColor="#5A6B75" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>

                                    <Border StrokeShape="RoundRectangle 14" BackgroundColor="White" StrokeThickness="0" Padding="14,10">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <VerticalStackLayout>
                                                <Label Text="Expected" FontSize="12" TextColor="#8B8B8B" />
                                                <Label Text="{Binding FormattedExpected}" FontAttributes="Bold" TextColor="#111111" FontSize="18" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="↗" FontSize="20" TextColor="#111111" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border IsVisible="{Binding ShowPendingEmptyState}"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="#EAF6FB"
                        Stroke="#B8E3F2"
                        StrokeThickness="1"
                        Padding="16"
                        Margin="0,-6,0,6">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="No pending payments"
                               FontFamily="BarlowCondensedSemiBold"
                               FontSize="18"
                               HorizontalTextAlignment="Center"
                               TextColor="#274454" />
                        <Label Text="You're all caught up for now."
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               TextColor="#5A6B75" />
                    </VerticalStackLayout>
                </Border>

                <!-- PAYMENT DONE TODAY SECTION -->
                <Label Text="PAYMENT DONE TODAY" FontSize="13" FontAttributes="Bold" TextColor="#1D1D1D" Margin="0,8,0,0" />

                <CollectionView ItemsSource="{Binding CompletedToday}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:LedgerItemModel">
                            <Border StrokeShape="RoundRectangle 16" BackgroundColor="#A6DCEE" StrokeThickness="0" Margin="0,0,0,10" Padding="14">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Label Grid.Column="0" Text="✔" FontSize="15" TextColor="#1D1D1D" VerticalOptions="Center" Margin="0,0,10,0"/>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding DriverName}" FontAttributes="Bold" TextColor="#1D1D1D" FontSize="15" />
                                        <Label Text="{Binding CompletedMetaText}" FontSize="12" TextColor="#5A6B75" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding StatusDisplayText}" FontAttributes="Bold" FontSize="15" TextColor="#1D1D1D" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- RECORD PAYMENT MODAL OVERLAY -->
        <Grid BackgroundColor="#66000000"
              IsVisible="{Binding Source={x:Reference RootPage}, Path=BindingContext.PaymentModalViewModel.IsVisible}">
            <Border StrokeShape="RoundRectangle 20"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Margin="24"
                    Padding="20"
                    VerticalOptions="Center"
                    BindingContext="{Binding Source={x:Reference RootPage}, Path=BindingContext.PaymentModalViewModel}"
                    x:DataType="vm:RecordPaymentViewModel">
                <VerticalStackLayout Spacing="12">
                    <!-- Header row -->
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding ModalTitle}" FontSize="19" FontAttributes="Bold" TextColor="#111827" FontFamily="BarlowCondensedBold" />
                            <Label Text="{Binding CurrentDriverName}" FontSize="12" TextColor="#6B7280" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="#D7EEF7"
                                StrokeThickness="0"
                                WidthRequest="32" HeightRequest="32"
                                Padding="0"
                                HorizontalOptions="End" VerticalOptions="Start">
                            <Button Text="✕"
                                    Command="{Binding CloseCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#1D1D1D"
                                    FontSize="13"
                                    Padding="0" />
                        </Border>
                    </Grid>

                    <!-- Driver / Category pickers (Other Payment flow only) -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" IsVisible="{Binding HasAvailableDrivers}">
                        <Border StrokeShape="RoundRectangle 20" BackgroundColor="#A6DCEE" Stroke="#40B4DB" StrokeThickness="1.5" Padding="14,0" HeightRequest="44">
                            <Picker ItemsSource="{Binding AvailableDrivers}"
                                    SelectedItem="{Binding SelectedDriver}"
                                    ItemDisplayBinding="{Binding FullName}"
                                    Title="Select Driver"
                                    BackgroundColor="Transparent"
                                    TextColor="#1D1D1D"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 20" BackgroundColor="#A6DCEE" Stroke="#40B4DB" StrokeThickness="1.5" Padding="14,0" HeightRequest="44">
                            <Picker ItemsSource="{Binding Categories}"
                                    SelectedItem="{Binding SelectedCategory}"
                                    Title="Category"
                                    BackgroundColor="Transparent"
                                    TextColor="#1D1D1D"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <Border IsVisible="{Binding ShowOtherPaymentEmptyState}"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="#EAF6FB"
                            Stroke="#B8E3F2"
                            StrokeThickness="1"
                            Padding="14,10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="No drivers with pending debts"
                                   FontFamily="BarlowCondensedSemiBold"
                                   FontSize="17"
                                   TextColor="#274454" />
                            <Label Text="There are currently no eligible drivers for Other Payment."
                                   FontSize="12"
                                   TextColor="#5A6B75" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Expected Amount (regular payment flow only) -->
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding ShowExpectedAmount}">
                        <Label Text="Expected Amount" FontSize="12" TextColor="#6B7280" />
                        <Border StrokeShape="RoundRectangle 20" BackgroundColor="#A6DCEE" Stroke="#40B4DB" StrokeThickness="1.5" Padding="16,0" HeightRequest="48">
                            <Entry Text="{Binding CurrentExpectedAmount, Mode=OneWay, StringFormat='{0:F2}'}" IsReadOnly="True" BackgroundColor="Transparent" TextColor="#111111" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="Amount Received (PHP)" FontSize="12" TextColor="#6B7280" />
                    <Border StrokeShape="RoundRectangle 20" BackgroundColor="#A6DCEE" Stroke="#40B4DB" StrokeThickness="1.5" Padding="16,0" HeightRequest="48">
                        <Entry Text="{Binding AmountReceived}" Keyboard="Numeric" BackgroundColor="Transparent" TextColor="#111111" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
                    </Border>

                    <!-- Payment Method Selectors -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="8" Margin="0,6,0,0">
                        <Button Grid.Column="0" Text="CASH"
                                Command="{Binding SelectMethodCommand}"
                                CommandParameter="CASH"
                                CornerRadius="20"
                                FontFamily="BarlowCondensedBold">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsEWallet}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#A6DCEE" />
                                    <Setter Property="TextColor" Value="#1D1D1D" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding IsEWallet}" Value="False">
                                    <Setter Property="BackgroundColor" Value="#019BCF" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" Text="E-WALLET (GCASH)"
                                Command="{Binding SelectMethodCommand}"
                                CommandParameter="GCASH"
                                CornerRadius="20"
                                FontFamily="BarlowCondensedBold">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsEWallet}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#019BCF" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding IsEWallet}" Value="False">
                                    <Setter Property="BackgroundColor" Value="#A6DCEE" />
                                    <Setter Property="TextColor" Value="#1D1D1D" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>

                    <!-- E-Wallet Specific Section -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsEWallet}">
                        <Button Text="📷 Scan receipt"
                                Command="{Binding OpenScanReceiptCommand}"
                                BackgroundColor="#E6F5FA"
                                TextColor="#1D1D1D"
                                BorderColor="#40B4DB"
                                BorderWidth="1"
                                CornerRadius="16"
                                HorizontalOptions="End"
                                Padding="16,6" />

                        <Label Text="Receipt Details" FontSize="11" TextColor="#6B7280" Margin="0,2,0,0" />

                        <!-- Amount row -->
                        <Border StrokeShape="RoundRectangle 14" BackgroundColor="#A6DCEE" Stroke="#40B4DB" StrokeThickness="1.5" Padding="14,0" HeightRequest="44">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <Label Text="Amount" FontSize="13" TextColor="#3E5B66" VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding ReceiptAmount}"
                                       Placeholder="—"
                                       Keyboard="Numeric"
                                        IsReadOnly="True"
                                       BackgroundColor="Transparent"
                                       TextColor="#111111"
                                       PlaceholderColor="#6B8A97"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Date row -->
                        <Border StrokeShape="RoundRectangle 14" BackgroundColor="#A6DCEE" Stroke="#40B4DB" StrokeThickness="1.5" Padding="14,0" HeightRequest="44">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <Label Text="Date" FontSize="13" TextColor="#3E5B66" VerticalOptions="Center" />
                                <DatePicker Grid.Column="1"
                                            Date="{Binding ReceiptDate}"
                                            Format="MMM dd, yyyy"
                                            IsEnabled="False"
                                            BackgroundColor="Transparent"
                                            TextColor="#111111"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Reference No. row -->
                        <Border StrokeShape="RoundRectangle 14" BackgroundColor="#A6DCEE" Stroke="#40B4DB" StrokeThickness="1.5" Padding="14,0" HeightRequest="44">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <Label Text="Reference No." FontSize="13" TextColor="#3E5B66" VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding ReferenceNumber}"
                                       Placeholder="—"
                                        IsReadOnly="True"
                                       BackgroundColor="Transparent"
                                       TextColor="#111111"
                                       PlaceholderColor="#6B8A97"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{Binding ValidationMessage}" TextColor="#B91C1C" FontSize="12" IsVisible="{Binding HasValidationMessage}" />

                    <Button Text="CONFIRM PAYMENT"
                            Command="{Binding ConfirmPaymentCommand}"
                            BackgroundColor="#019BCF"
                            TextColor="White"
                            FontFamily="BarlowCondensedBold"
                            FontSize="22"
                            CornerRadius="24"
                            HeightRequest="54"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>