<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Manager"
             x:Class="LARGA.MobileApp.Views.Manager.ManagerProfilePage"
             x:DataType="vm:ManagerProfileViewModel"
             BackgroundColor="{StaticResource LargaWhite}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="My Profile" FontSize="32" Style="{StaticResource HeaderStyle}" TextColor="{StaticResource LargaDarkText}" Margin="0,10,0,0" />

            <!-- Profile card -->
            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 15" StrokeThickness="0" Padding="20">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border StrokeShape="RoundRectangle 40" HeightRequest="80" WidthRequest="80" BackgroundColor="#777777" StrokeThickness="0" />
                    <Label Text="{Binding FullName}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" HorizontalOptions="Center" />
                    <Label Text="{Binding RoleDisplay}" FontSize="13" TextColor="#555555" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Driver Management -->
            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="15">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ViewDriverManagementCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Driver Management" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" />
                        <Label Text="{Binding DriverCountDisplay}" FontSize="12" TextColor="#555555" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="&gt;" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Fleet Registry -->
            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="15">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ViewFleetRegistryCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Fleet Registry" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" />
                        <Label Text="{Binding FleetCountDisplay}" FontSize="12" TextColor="#555555" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="&gt;" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource LargaDarkText}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Account Settings -->
            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="15">
                <VerticalStackLayout Spacing="12">
                    <Label Text="ACCOUNT SETTINGS" FontSize="12" TextColor="{StaticResource LargaDarkText}" CharacterSpacing="1" />
                    <BoxView HeightRequest="1" Color="#80BBD0" />

                    <Label Text="›  Change password" FontSize="14" TextColor="{StaticResource LargaDarkText}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangePasswordCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="›  Update Contact Number" FontSize="14" TextColor="{StaticResource LargaDarkText}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UpdateContactNumberCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Button Text="LOG OUT" Command="{Binding LogoutCommand}"
                    BackgroundColor="#F2665E" TextColor="White" CornerRadius="25"
                    HeightRequest="55" FontSize="16" FontAttributes="Bold" Margin="0,30,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
