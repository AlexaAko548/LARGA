<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Manager"
             x:Class="LARGA.MobileApp.Views.Manager.ManagerProfilePage"
             x:DataType="vm:ManagerProfileViewModel"
             BackgroundColor="{StaticResource LargaPageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="My Profile" FontSize="30" Style="{StaticResource HeaderStyle}" TextColor="{StaticResource LargaNavy}" Margin="0,10,0,4" />

            <!-- Profile card -->
            <Border Style="{StaticResource ManagerCardStyle}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border StrokeShape="RoundRectangle 38" HeightRequest="76" WidthRequest="76" BackgroundColor="{StaticResource LargaPrimaryBlue}" StrokeThickness="0">
                        <Label Text="{Binding Initials}" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource LargaWhite}"
                               HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                    </Border>
                    <Label Text="{Binding FullName}" FontSize="19" FontAttributes="Bold" TextColor="{StaticResource LargaNavy}" HorizontalOptions="Center" />
                    <Border BackgroundColor="{StaticResource LargaAccentBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="14,5">
                        <Label Text="{Binding RoleDisplay}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource LargaPrimaryBlue}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Driver Management -->
            <Border Style="{StaticResource ManagerCardStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ViewDriverManagementCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Grid.Column="0" Style="{StaticResource IconChipStyle}">
                        <Label Text="☰" Style="{StaticResource IconChipGlyphStyle}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Driver Management" Style="{StaticResource CardValueStyle}" FontSize="15" />
                        <Label Text="{Binding DriverCountDisplay}" FontSize="12" TextColor="{StaticResource LargaMutedText}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource LargaMutedText}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Fleet Registry -->
            <Border Style="{StaticResource ManagerCardStyle}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ViewFleetRegistryCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Grid.Column="0" Style="{StaticResource IconChipStyle}">
                        <Label Text="▤" Style="{StaticResource IconChipGlyphStyle}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Fleet Registry" Style="{StaticResource CardValueStyle}" FontSize="15" />
                        <Label Text="{Binding FleetCountDisplay}" FontSize="12" TextColor="{StaticResource LargaMutedText}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{StaticResource LargaMutedText}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Account Settings -->
            <Border Style="{StaticResource ManagerCardStyle}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="ACCOUNT SETTINGS" Style="{StaticResource EyebrowLabelStyle}" Margin="0,0,0,8" />
                    <BoxView HeightRequest="1" Color="{StaticResource LargaCardBorder}" />

                    <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                        <Label Grid.Column="0" Text="Change password" FontSize="14" TextColor="{StaticResource LargaNavy}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="›" FontSize="18" TextColor="{StaticResource LargaMutedText}" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangePasswordCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource LargaCardBorder}" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                        <Label Grid.Column="0" Text="Update Contact Number" FontSize="14" TextColor="{StaticResource LargaNavy}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="›" FontSize="18" TextColor="{StaticResource LargaMutedText}" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UpdateContactNumberCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="LOG OUT" Command="{Binding LogoutCommand}"
                    BackgroundColor="{StaticResource LargaDanger}" TextColor="{StaticResource LargaWhite}" CornerRadius="25"
                    HeightRequest="54" FontSize="15" FontAttributes="Bold" Margin="0,10,0,24" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
