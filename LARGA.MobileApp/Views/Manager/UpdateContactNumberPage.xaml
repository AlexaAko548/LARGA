<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Manager"
             x:Class="LARGA.MobileApp.Views.Manager.UpdateContactNumberPage"
             x:DataType="vm:UpdateContactNumberViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource LargaPageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="20,0" Spacing="6">

            <Label Text="&lt; Back" FontSize="14" TextColor="{StaticResource LargaPrimaryBlue}" Margin="0,15,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Label Text="Update Contact Number" FontSize="26" Style="{StaticResource HeaderStyle}" TextColor="{StaticResource LargaNavy}" Margin="0,0,0,10" />

            <Label Text="CURRENT NUMBER" Style="{StaticResource EyebrowLabelStyle}" Margin="4,0,0,4" />
            <Border BackgroundColor="{StaticResource LargaWhite}" Stroke="{StaticResource LargaCardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15,4" Margin="0,0,0,12">
                <Entry Text="{Binding CurrentNumber}" Placeholder="Number on file" Keyboard="Telephone" BackgroundColor="Transparent"
                       TextColor="{StaticResource LargaNavy}" PlaceholderColor="{StaticResource LargaMutedText}" />
            </Border>

            <Label Text="NEW NUMBER" Style="{StaticResource EyebrowLabelStyle}" Margin="4,0,0,4" />
            <Border BackgroundColor="{StaticResource LargaWhite}" Stroke="{StaticResource LargaCardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15,4" Margin="0,0,0,12">
                <Entry Text="{Binding NewNumber}" Placeholder="e.g. +63 9XX XXX XXXX" Keyboard="Telephone" BackgroundColor="Transparent"
                       TextColor="{StaticResource LargaNavy}" PlaceholderColor="{StaticResource LargaMutedText}" />
            </Border>

            <Label Text="CONFIRM NEW NUMBER" Style="{StaticResource EyebrowLabelStyle}" Margin="4,0,0,4" />
            <Border BackgroundColor="{StaticResource LargaWhite}" Stroke="{StaticResource LargaCardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15,4" Margin="0,0,0,12">
                <Entry Text="{Binding ConfirmNewNumber}" Placeholder="Re-enter new number" Keyboard="Telephone" BackgroundColor="Transparent"
                       TextColor="{StaticResource LargaNavy}" PlaceholderColor="{StaticResource LargaMutedText}" />
            </Border>

            <Button Text="CONFIRM &amp; SAVE" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="{StaticResource LargaPrimaryBlue}" TextColor="{StaticResource LargaWhite}"
                    CornerRadius="25" HeightRequest="54" FontSize="15" FontAttributes="Bold" Margin="0,12,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
