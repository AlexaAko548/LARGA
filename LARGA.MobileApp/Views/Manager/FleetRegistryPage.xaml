<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Manager"
             x:Class="LARGA.MobileApp.Views.Manager.FleetRegistryPage"
             x:DataType="vm:FleetRegistryViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource LargaWhite}">

    <ScrollView>
        <VerticalStackLayout Padding="20,0" Spacing="15">

            <Label Text="&lt; Back" FontSize="14" TextColor="{StaticResource LargaPrimaryBlue}" Margin="0,15,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Label Text="Fleet Registry" FontSize="32" Style="{StaticResource HeaderStyle}" TextColor="{StaticResource LargaDarkText}" />

            <Border BackgroundColor="{StaticResource LargaLightBlue}" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="15">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Taxis}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaxiListItem">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding PlateNumber}" FontSize="15" TextColor="{StaticResource LargaDarkText}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding StatusText}" FontSize="13" TextColor="{Binding StatusColor}" VerticalOptions="Center" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="#80BBD0" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
