<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Auth"
             x:Class="LARGA.MobileApp.Views.Auth.LandingPage"
             x:DataType="vm:LandingViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <Grid RowDefinitions="*, Auto">
        <!-- Top Blue Area -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource LargaLightBlue}"
                StrokeShape="RoundRectangle 0,0,50,50"
                StrokeThickness="0">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <Image Source="larga_logo.webp" WidthRequest="300" Aspect="AspectFit" />
            </VerticalStackLayout>
        </Border>

        <!-- Bottom White Area -->
        <VerticalStackLayout Grid.Row="1" Padding="30,20,30,40" Spacing="15">
            <Button Text="Driver" 
                    BackgroundColor="#0099CC" TextColor="White" CornerRadius="25" HeightRequest="50" FontAttributes="Bold"
                    Command="{Binding SelectRoleCommand}" CommandParameter="Driver"/>
            <Button Text="Manager" 
                    BackgroundColor="#0099CC" TextColor="White" CornerRadius="25" HeightRequest="50" FontAttributes="Bold"
                    Command="{Binding SelectRoleCommand}" CommandParameter="Manager"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>