<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Auth"
             x:Class="LARGA.MobileApp.Views.Auth.ForcedPasswordChangePage"
             x:DataType="vm:ForcedPasswordChangeViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource ThemeSurface}">

    <ScrollView>
        <VerticalStackLayout Padding="20,0" Spacing="15" Margin="0,30,0,10">

            <Label Text="Set a New Password"
                   FontSize="32"
                   Style="{StaticResource HeaderStyle}"
                   TextColor="{DynamicResource LargaDarkText}" />

            <Label Text="Your manager gave you a temporary password. Choose your own before you continue."
                   FontSize="14"
                   TextColor="{DynamicResource ThemeTextSecondary}" />

            <Border BackgroundColor="{DynamicResource LargaLightBlue}" StrokeShape="RoundRectangle 15" StrokeThickness="0" Padding="20,10">
                <Entry Text="{Binding CurrentPassword}" Placeholder="Temporary Password" IsPassword="True" BackgroundColor="Transparent"
                       TextColor="{DynamicResource LargaDarkText}" PlaceholderColor="{DynamicResource ThemeTextTertiary}" FontSize="16" />
            </Border>

            <Border BackgroundColor="{DynamicResource LargaLightBlue}" StrokeShape="RoundRectangle 15" StrokeThickness="0" Padding="20,10">
                <Entry Text="{Binding NewPassword}" Placeholder="New Password" IsPassword="True" BackgroundColor="Transparent"
                       TextColor="{DynamicResource LargaDarkText}" PlaceholderColor="{DynamicResource ThemeTextTertiary}" FontSize="16" />
            </Border>

            <Border BackgroundColor="{DynamicResource LargaLightBlue}" StrokeShape="RoundRectangle 15" StrokeThickness="0" Padding="20,10">
                <Entry Text="{Binding ConfirmNewPassword}" Placeholder="Confirm New Password" IsPassword="True" BackgroundColor="Transparent"
                       TextColor="{DynamicResource LargaDarkText}" PlaceholderColor="{DynamicResource ThemeTextTertiary}" FontSize="16" />
            </Border>

            <Button Text="CONFIRM &amp; SAVE"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="{DynamicResource LargaPrimaryBlue}"
                    TextColor="{DynamicResource LargaWhite}"
                    CornerRadius="42"
                    HeightRequest="84"
                    FontSize="24"
                    Style="{StaticResource HeaderStyle}"
                    Margin="0,60,0,0" />

            <Button Text="Sign out"
                    Command="{Binding SignOutCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource LargaPrimaryBlue}"
                    FontSize="15"
                    Margin="0,0,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
