<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Auth"
             x:Class="LARGA.MobileApp.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <Grid RowDefinitions="*, Auto">
        <!-- Top Blue Area -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource LargaLightBlue}"
                StrokeShape="RoundRectangle 0,0,50,50"
                StrokeThickness="0">
            <Grid RowDefinitions="Auto, *">
                <!-- Header -->
                <Grid Grid.Row="0" Padding="10,20,20,0">
                    <ImageButton Source="back_icon.png" 
                     HorizontalOptions="Start" 
                     WidthRequest="24" 
                     HeightRequest="24" 
                     Aspect="AspectFit"
                     Padding="4"
                     BackgroundColor="Transparent" 
                     Clicked="OnBackButtonClicked" />   
                </Grid>

                <!-- Content Inside Blue Area -->
                <VerticalStackLayout Grid.Row="1" Padding="30, 0, 30, 30" Spacing="15" VerticalOptions="Center">
                    <Label Text="Welcome back!" 
                           Style="{StaticResource HeaderTitleStyle}" 
                           FontSize="40"
                           TextColor="Black"
                           HorizontalOptions="Center" 
                           Margin="0, 0, 0, 70" />

                    <!-- Blue filled input fields -->
                    <Border BackgroundColor="#0099CC" StrokeShape="RoundRectangle 10" StrokeThickness="0" HeightRequest="50">
                        <Entry Placeholder="Email" Text="{Binding Email}" PlaceholderColor="#E0E0E0" TextColor="White" Keyboard="Email" VerticalOptions="Center" Margin="15,0" BackgroundColor="Transparent" />
                    </Border>

                    <Border BackgroundColor="#0099CC" StrokeShape="RoundRectangle 10" StrokeThickness="0" HeightRequest="50">
                        <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="True" PlaceholderColor="#E0E0E0" TextColor="White" VerticalOptions="Center" Margin="15,0" BackgroundColor="Transparent" />
                    </Border>

                    <Label Text="Forgot password?" 
                           TextColor="Black"
                           HorizontalOptions="End" 
                           TextDecorations="Underline"
                           FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Bottom White Area -->
        <VerticalStackLayout Grid.Row="1" Padding="30,20,30,40" Spacing="15">
            <Label Text="{Binding ErrorMessage}" TextColor="Red" HorizontalOptions="Center" />

            <Button Text="Login" BackgroundColor="#0099CC" TextColor="White" CornerRadius="25" HeightRequest="50" Style="{StaticResource LargaButtonStyle}" FontSize="18" Command="{Binding LoginCommand}" WidthRequest="250" HorizontalOptions="Center"/>

            <Label Text="Don't have an account?&#10;Please refer to your manager to open your account."
                   HorizontalTextAlignment="Center"
                   FontSize="12"
                   TextColor="Gray" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>