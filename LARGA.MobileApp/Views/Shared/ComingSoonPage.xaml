<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels.Shared"
             x:Class="LARGA.MobileApp.Views.Shared.ComingSoonPage"
             x:DataType="vm:ComingSoonViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource LargaPageBg}">

    <VerticalStackLayout Padding="20,0" Spacing="14">

        <Label Text="&lt; Back" FontSize="14" TextColor="{StaticResource LargaPrimaryBlue}" Margin="0,15,0,0">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoBackCommand}" />
            </Label.GestureRecognizers>
        </Label>

        <Label Text="{Binding Title}" FontSize="26" Style="{StaticResource HeaderStyle}" TextColor="{StaticResource LargaNavy}" />

        <VerticalStackLayout VerticalOptions="Center" Spacing="14" Margin="0,60,0,0">
            <Border StrokeShape="RoundRectangle 32" HeightRequest="64" WidthRequest="64" BackgroundColor="{StaticResource LargaAccentBlue}" StrokeThickness="0" HorizontalOptions="Center">
                <Label Text="⏳" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
            </Border>
            <Label Text="{Binding Title, StringFormat='{0} is coming soon.'}" FontSize="13" TextColor="{StaticResource LargaMutedText}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>
