<?xml version="1.0" encoding="utf-8" ?>
<!-- Deliberately low-key: no red screen or giant numbers, so a Hostile-protocol countdown on
     the driver's phone doesn't draw the attention of whoever is in the cab. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LARGA.MobileApp.Views.Shared.EmergencyCountdownPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource ThemePageBg}">

    <Border BackgroundColor="{DynamicResource ThemeSurface}"
            Stroke="{DynamicResource LargaCardBorder}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 16"
            Padding="24"
            Margin="24,0"
            VerticalOptions="Center">

        <VerticalStackLayout Spacing="12">
            <Label x:Name="TitleLabel"
                   FontFamily="BarlowCondensedBold"
                   FontSize="22"
                   TextColor="{DynamicResource LargaDarkText}"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="MessageLabel"
                   FontFamily="InterRegular"
                   FontSize="14"
                   TextColor="{DynamicResource LargaMutedText}"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="SecondsLabel"
                   FontFamily="BarlowCondensedBold"
                   FontSize="40"
                   TextColor="{DynamicResource LargaDarkText}"
                   HorizontalTextAlignment="Center" />

            <Button Text="CANCEL"
                    FontFamily="InterBold"
                    FontSize="16"
                    HeightRequest="56"
                    CornerRadius="12"
                    Margin="0,8,0,0"
                    BackgroundColor="{DynamicResource LargaPrimaryBlue}"
                    TextColor="{DynamicResource LargaWhite}"
                    Clicked="OnCancelClicked" />
        </VerticalStackLayout>
    </Border>
</ContentPage>
