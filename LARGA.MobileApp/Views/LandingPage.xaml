<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LARGA.MobileApp.ViewModels"
             x:Class="LARGA.MobileApp.Views.LandingPage"
             x:DataType="vm:LandingViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">

    <Grid RowDefinitions="7*, 3*">
        <!-- Top Blue Area -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource LargaLightBlue}"
                StrokeShape="RoundRectangle 0,0,40,40"
                StrokeThickness="0">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <!-- Using the taxi logo rather than the default .NET bot -->
                <Image Source="larga_logo.webp" WidthRequest="250" HeightRequest="250" Aspect="AspectFit" />
            </VerticalStackLayout>
        </Border>

        <!-- Bottom White Area -->
        <VerticalStackLayout Grid.Row="1" Padding="30" Spacing="15" VerticalOptions="Center">
            <Button Text="Driver" Style="{StaticResource LargaButtonStyle}" 
                    Command="{Binding SelectRoleCommand}" CommandParameter="Driver"/>
            <Button Text="Manager" Style="{StaticResource LargaButtonStyle}"
                    Command="{Binding SelectRoleCommand}" CommandParameter="Manager"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>