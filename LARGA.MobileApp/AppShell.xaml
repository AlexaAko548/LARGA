<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LARGA.MobileApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:auth="clr-namespace:LARGA.MobileApp.Views.Auth"
    xmlns:driver="clr-namespace:LARGA.MobileApp.Views.Driver"
    xmlns:manager="clr-namespace:LARGA.MobileApp.Views.Manager"
    Title="LARGA.MobileApp"
    FlyoutBehavior="Disabled">
    <!-- Disables the sidebar globally -->
    <!-- The initial startup page -->
    <ShellContent
        Title="Welcome"
        ContentTemplate="{DataTemplate auth:LandingPage}"
        Route="landing"
        Shell.NavBarIsVisible="False" />
    <!-- Hides the top title bar -->
    <!-- Driver Dashboard with Bottom Tabs -->
    <TabBar Route="driver-dashboard">
        <Tab Title="Home" Icon="car.png">
            <ShellContent ContentTemplate="{DataTemplate driver:DriverDashboardPage}" />
        </Tab>
        <Tab Title="Ledger" Icon="ledger.png">
            <ShellContent ContentTemplate="{DataTemplate driver:LedgerPage}" />
        </Tab>
        <Tab Title="Reports" Icon="report.png">
            <ShellContent ContentTemplate="{DataTemplate driver:ReportsPage}" />
        </Tab>
        <Tab Title="Profile" Icon="profile.png">
            <ShellContent ContentTemplate="{DataTemplate driver:ProfilePage}" />
        </Tab>
    </TabBar>
    <!-- Manager Dashboard Route -->
    <ShellContent
        Title="Manager Dashboard"
        ContentTemplate="{DataTemplate manager:ManagerDashboardPage}"
        Route="manager-dashboard"
        FlyoutItemIsVisible="False" />
    <!-- Manager Alert Center Route -->
    <ShellContent
        Title="Alert Center"
        ContentTemplate="{DataTemplate manager:AlertCenterPage}"
        Route="alertcenter"
        Shell.NavBarIsVisible="False"
        FlyoutItemIsVisible="False" />
</Shell>