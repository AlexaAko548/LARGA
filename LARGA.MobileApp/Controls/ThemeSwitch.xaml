<?xml version="1.0" encoding="utf-8" ?>
<!-- Appearance picker (System / Light / Dark) for the driver and manager profile pages. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LARGA.MobileApp.Controls.ThemeSwitch">

    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="5,3">
        <Label Grid.Column="0" Text="›  Appearance" FontSize="15" TextColor="{DynamicResource LargaDarkText}" VerticalOptions="Center" />

        <Border Grid.Column="1" HorizontalOptions="End" StrokeThickness="1" Stroke="{DynamicResource LargaPrimaryBlue}"
                StrokeShape="RoundRectangle 18" Padding="2" BackgroundColor="Transparent">
            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="2">
                <Button x:Name="SystemButton" Grid.Column="0" Text="System" Clicked="OnSystemClicked" />
                <Button x:Name="LightButton" Grid.Column="1" Text="Light" Clicked="OnLightClicked" />
                <Button x:Name="DarkButton" Grid.Column="2" Text="Dark" Clicked="OnDarkClicked" />
            </Grid>
        </Border>
    </Grid>
</ContentView>
