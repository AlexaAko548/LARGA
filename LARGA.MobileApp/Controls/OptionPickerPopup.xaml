<?xml version="1.0" encoding="utf-8" ?>
<!-- Themed option list, used instead of the native Picker dialog (which follows the Android theme, not the app's) so a
     dropdown looks like the rest of the app. Same card as ConfirmationPopup. Show it with OptionPickerPopup.ShowAsync(...). -->
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                x:Class="LARGA.MobileApp.Controls.OptionPickerPopup"
                Color="Transparent">

    <Border BackgroundColor="{DynamicResource ThemeSurface}"
            Stroke="{DynamicResource LargaCardBorder}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 20"
            Padding="20,18"
            WidthRequest="320">
        <Border.Shadow>
            <Shadow Brush="{StaticResource LargaNavy}" Opacity="0.18" Radius="18" Offset="0,8" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="12">
            <Label x:Name="TitleLabel"
                   FontFamily="BarlowCondensedBold" FontSize="21"
                   TextColor="{DynamicResource ThemeTextBlack}" />

            <ScrollView MaximumHeightRequest="360">
                <VerticalStackLayout x:Name="OptionsLayout" Spacing="8" />
            </ScrollView>

            <Button Text="Cancel" Clicked="OnCancelClicked"
                    BackgroundColor="{DynamicResource LargaLightBlue}"
                    TextColor="{DynamicResource LargaDarkText}"
                    FontFamily="BarlowCondensedSemiBold" FontAttributes="Bold" FontSize="15"
                    CornerRadius="19" HeightRequest="42" TextTransform="None" Margin="0,4,0,0" />
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
