<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): nothing from this app goes to cloud backup or to a new phone in a
     device-to-device transfer (audit F-01). The app holds shift IDs, drafts and the Firestore offline
     cache with ledgers and driver details; a new phone signs in and downloads what it is allowed to see. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
