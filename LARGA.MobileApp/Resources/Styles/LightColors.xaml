<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!-- Light palette. DarkColors.xaml defines the same keys; ThemeService swaps the two in
     Application.Resources at runtime, so views reference these with DynamicResource. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="LARGA.MobileApp.Resources.Styles.LightColors">

    <Color x:Key="LargaDarkText">#1D1D1D</Color>
    <Color x:Key="LargaPrimaryBlue">#019BCF</Color>
    <!-- Always white (text on blue buttons). Card/panel backgrounds use ThemeSurface. -->
    <Color x:Key="LargaWhite">#FFFFFF</Color>
    <Color x:Key="LargaLightBlue">#A6DCEE</Color>

    <!-- Manager UI refresh: a richer palette than the single flat LargaLightBlue fill used
         everywhere before - a neutral page ground, elevated white cards, a muted secondary
         text color, and proper success/danger/warning pairs for status chips, matching the
         ManagerWeb dashboard's look instead of every element being the same light-blue block. -->
    <Color x:Key="LargaPageBg">#F2F7FA</Color>
    <Color x:Key="LargaNavy">#0F2A3D</Color>
    <!-- LargaNavy as a fill (white text on it); LargaNavy itself turns light in dark mode. -->
    <Color x:Key="LargaNavySurface">#0F2A3D</Color>
    <Color x:Key="LargaMutedText">#6B808A</Color>
    <Color x:Key="LargaCardBorder">#DCEAF0</Color>
    <Color x:Key="LargaAccentBlue">#EAF6FC</Color>
    <Color x:Key="LargaSuccess">#1E8E5A</Color>
    <Color x:Key="LargaSuccessBg">#E3F5EC</Color>
    <Color x:Key="LargaDanger">#D33F3F</Color>
    <Color x:Key="LargaDangerBg">#FBEAEA</Color>
    <Color x:Key="LargaWarning">#C97A1B</Color>
    <Color x:Key="LargaWarningBg">#FBF0E0</Color>

    <!-- Theme tokens for colors views used to hardcode. Light values are the exact literals
         they replace, so light mode looks the same as before. -->
    <Color x:Key="ThemePageBg">#FFFFFF</Color>
    <Color x:Key="ThemeSurface">#FFFFFF</Color>
    <Color x:Key="ThemeTextBlack">#000000</Color>
    <Color x:Key="ThemeTextGray">#808080</Color>
    <Color x:Key="ThemeTextSecondary">#555555</Color>
    <Color x:Key="ThemeTextTertiary">#777777</Color>
    <Color x:Key="ThemePanel">#AEE2F0</Color>
    <Color x:Key="ThemePanelAlt">#A1D6E2</Color>
    <Color x:Key="ThemeDivider">#80BBD0</Color>
    <Color x:Key="ThemeDividerDark">#1A1A1A</Color>
    <Color x:Key="ThemeDividerLight">#D3D3D3</Color>
    <Color x:Key="ThemeEditedText">#B45309</Color>
    <Color x:Key="ThemeWarningText">#8A6D00</Color>
    <Color x:Key="ThemeOrangeText">#E65100</Color>
    <Color x:Key="ThemeDangerSoft">#FFD6D6</Color>
    <Color x:Key="ThemeNoteBg">#FDECEA</Color>
    <Color x:Key="ThemeWarningSoft">#FFF3CD</Color>
    <Color x:Key="ThemeOrangeSoft">#FFE0B2</Color>
    <Color x:Key="ThemeTabUnselected">#999999</Color>

</ResourceDictionary>
