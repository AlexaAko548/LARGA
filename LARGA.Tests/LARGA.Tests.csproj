<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LARGA.SharedCore\LARGA.SharedCore.csproj" />
    <!-- Maintenance tests call the Garage page's own helpers (Garage.razor). -->
    <ProjectReference Include="..\LARGA.ManagerWeb\LARGA.ManagerWeb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fixtures/Fuel: ML Kit blocks captured from the emulator (LARGA-OCR logcat lines, DEBUG test hook).
         Fixtures/Sos: SensorTrace recordings and gen_sos_traces.py output. -->
    <None Include="Fixtures\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
