rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.trim().lower();
    }

    function isManager() {
      return request.auth != null && getUserRole() == 'manager';
    }

    function isStaff() {
      return request.auth != null && getUserRole() in ['manager', 'assistant manager'];
    }

    function isDriver() {
      return request.auth != null && getUserRole() == 'driver';
    }

    function isLargaUser() {
      return request.auth != null && getUserRole() in ['manager', 'assistant manager', 'driver'];
    }

    function expiresAfterDays(days) {
      let d = request.resource.data;
      return !('expireAt' in d)
        || (resource != null && resource.data.get('expireAt', null) == d.expireAt)
        || (d.expireAt is timestamp
            && d.expireAt > request.time + duration.value(days - 7, 'd')
            && d.expireAt < request.time + duration.value(days + 7, 'd'));
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow write: if isManager() || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['fcmToken', 'tokenUpdatedAt', 'phoneNumber']));
    }

    match /shifts/{shiftId} {
      allow read: if isStaff() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if isDriver()
                    && request.resource.data.keys().hasOnly(['driverId', 'taxiId', 'shiftStart', 'startMileage',
                                                             'status', 'shiftId', 'isOnBreak', 'managerNote'])
                    && request.resource.data.driverId == request.auth.uid
                    && request.resource.data.status == 'Active'
                    && request.resource.data.shiftId in ['', shiftId]
                    && request.resource.data.taxiId is string && request.resource.data.taxiId.size() > 0
                    && request.resource.data.startMileage is int && request.resource.data.startMileage > 0
                    && request.resource.data.get('isOnBreak', false) == false
                    && request.resource.data.get('managerNote', '') == ''
                    && request.resource.data.shiftStart == request.time && phHour(request.time) >= 6;
      allow update: if isManager() || (isDriver() && driverShiftUpdateOk(shiftId));
    }

    function driverShiftUpdateOk(shiftId) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      let gpsKeys = ['currentLatitude', 'currentLongitude', 'currentSpeed', 'currentHeading',
                     'currentPositionUpdatedAt', 'lastMovingAt', 'distanceKm'];
      return before.driverId == request.auth.uid
        && changed.hasOnly(gpsKeys.concat(['isOnBreak', 'shiftId', 'shiftEnd', 'endMileage', 'status',
                                           'managerNote', 'fuelPenalty']))
        && (!changed.hasAny(gpsKeys) || before.status == 'Active')
        && (!changed.hasAny(['shiftEnd']) || after.shiftEnd == request.time)
        && (!changed.hasAny(['status']) || (before.status == 'Active' && after.status in ['Completed', 'Auto-Closed']))
        && (!changed.hasAny(['fuelPenalty']) || after.fuelPenalty == 0 || after.fuelPenalty == 50)
        && (!changed.hasAny(['managerNote']) || after.managerNote == '')
        && (!changed.hasAny(['endMileage']) || after.status != 'Completed'
            || before.get('startMileage', 0) == 0 || after.endMileage >= before.startMileage)
        && (!changed.hasAny(['shiftId']) || after.shiftId == shiftId);
    }

    function phHour(t) {
      return (t.hours() + 8) % 24;
    }

    match /ledger_locks/{driverId} {
      allow read, write: if isStaff();
    }

    match /shift_locks/{lockId} {
      allow read: if isLargaUser();
      allow write: if isManager() || (isDriver() && ownShiftLock(lockId));
    }

    function ownShiftLock(lockId) {
      let shiftLock = request.resource.data;
      let lockedShift = getAfter(/databases/$(database)/documents/shifts/$(shiftLock.shiftId)).data;
      return shiftLock.driverId == request.auth.uid
        && lockedShift.driverId == request.auth.uid
        && lockId in ['driver_' + request.auth.uid, 'unit_' + lockedShift.taxiId]
        && (shiftLock.get('released', false) == true
              ? lockedShift.status != 'Active'
              : lockedShift.status == 'Active' && shiftLock.get('shiftStart', null) == lockedShift.shiftStart);
    }

    match /shift_schedules/{docId} {
      allow read: if isStaff() || (request.auth != null && docId.matches(request.auth.uid + '_[0-9]{8}'));
      allow write: if isManager();
    }

    match /clockin_requests/{requestId} {
      allow read: if isStaff() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if isDriver() && request.resource.data.driverId == request.auth.uid
                    && request.resource.data.status == 'Pending';
      allow update: if isManager() || (isDriver() && resource.data.driverId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'shiftId'])
                    && ((resource.data.status == 'Pending' && request.resource.data.status == 'Cancelled')
                        || (resource.data.status == 'Approved' && request.resource.data.status == 'ClockedIn')));
    }

    match /debt_adjustments/{adjustmentId} {
      allow read: if isStaff() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow write: if isManager();
    }

    match /driverPerformance/{driverId} {
      allow read: if isOwner(driverId) || isStaff();
      allow write: if isManager();
    }

    match /chats/{driverId} {
      allow read, write: if isManager() || isOwner(driverId);

      match /messages/{messageId} {
        allow read, delete: if isManager() || isOwner(driverId);
        allow create, update: if isManager() || (isOwner(driverId) && expiresAfterDays(365));
      }
    }

    match /taxis/{taxiId} {
      allow read: if isLargaUser();
      allow create, update, delete: if isManager();
    }

    match /system_configs/{configId} {
      allow read: if isLargaUser();
      allow write: if isManager();
    }

    match /boundary_payments/{paymentId} {
      allow read: if isStaff() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if isStaff()
                    && request.resource.data.amountPaid is number
                    && request.resource.data.amountPaid > 0
                    && request.resource.data.amountPaid < 1000000
                    && request.resource.data.driverId is string && request.resource.data.driverId.size() > 0
                    && request.resource.data.shiftId is string;
      allow delete: if isManager();
    }

    match /payment_references/{reference} {
      allow read, create: if isStaff();
    }

    match /maintenance_logs/{maintenanceId} {
      allow read: if isStaff() || isDriver();
      allow create: if isManager()
                    || (isDriver()
                        && request.resource.data.reportedByDriverId == request.auth.uid
                        && request.resource.data.status == 'Reported');
      allow update: if isManager();
    }

    match /fuel_logs/{fuelId} {
      allow read: if isStaff() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if isDriver()
                    && request.resource.data.driverId == request.auth.uid
                    && (request.resource.data.verificationStatus == 'Pending'
                        || (request.resource.data.verificationStatus == 'Flagged'
                            && request.resource.data.get('autoFlagged', false) == true
                            && request.resource.data.get('flaggedAt', null) == request.time))
                    && request.resource.data.submittedAt == request.time
                    && request.resource.data.litersRefueled is number
                    && request.resource.data.litersRefueled > 0 && request.resource.data.litersRefueled <= 200
                    && request.resource.data.fuelCost is number
                    && request.resource.data.fuelCost > 0 && request.resource.data.fuelCost <= 20000
                    && fuelShiftOk(request.resource.data.shiftId);
      allow update: if isManager();
    }

    // REQ-4.3-3 / REQ-5.5-6 (FuelShiftRules): a fuel log is always linked to one of the driver's own
    // shifts - the active one, or one that ended within the last 12 hours. An Auto-Closed shift has
    // no shiftEnd (closed at 6:00 AM the day after it started), so its window is bounded from
    // shiftStart: at most 24 h to the auto-close plus the 12 h.
    function fuelShiftOk(shiftId) {
      let shiftPath = /databases/$(database)/documents/shifts/$(shiftId);
      let shift = get(shiftPath).data;
      return shiftId is string && shiftId.size() > 0
        && exists(shiftPath)
        && shift.driverId == request.auth.uid
        && (shift.status == 'Active'
            || (shift.status == 'Completed' && shift.get('shiftEnd', null) is timestamp
                && request.time < shift.shiftEnd + duration.value(12, 'h'))
            || (shift.status == 'Auto-Closed' && request.time < shift.shiftStart + duration.value(36, 'h')));
    }

    match /gps_telemetry/{logId} {
      allow read: if isStaff();
      allow create: if isDriver()
        && request.resource.data.driverId == request.auth.uid
        && expiresAfterDays(90)
        && get(/databases/$(database)/documents/shifts/$(request.resource.data.shiftId)).data.driverId == request.auth.uid
        && get(/databases/$(database)/documents/shifts/$(request.resource.data.shiftId)).data.status == 'Active';
    }

    match /emergency_alerts/{alertId} {
      allow read: if isStaff();
      // SOS-006: the fields ManagerWeb's SosPushService writes (caller check, push claim, address,
      // retention) and the Resolved state are never the driver's to set - a pre-set pushSentAt
      // skipped the caller check and the push, leaving a driver-written callerCheck in place.
      allow create: if isDriver() && request.resource.data.driverId == request.auth.uid
                    && request.resource.data.get('isResolved', false) == false
                    && !request.resource.data.keys().hasAny(['expireAt', 'pushSentAt', 'callerCheck', 'callerVerified',
                         'callerVerificationReason', 'address', 'addressSource', 'resolvedAt'])
                    && exists(/databases/$(database)/documents/shifts/$(request.resource.data.shiftId))
                    && get(/databases/$(database)/documents/shifts/$(request.resource.data.shiftId)).data.driverId == request.auth.uid
                    && get(/databases/$(database)/documents/shifts/$(request.resource.data.shiftId)).data.status == 'Active';
      allow update: if isManager();
    }

    match /spare_parts/{partId} {
      allow read, write: if isManager();
    }

    match /audit_logs/{logId} {
      allow read: if isManager();
      allow create: if isManager() && ownAuditEntry();
      allow create: if isDriver() && ownAuditEntry()
         && request.resource.data.actionType in ['SosTriggered', 'VehicleDefectReported'];
    }

    function ownAuditEntry() {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.timestamp == request.time;
    }

    match /handover_checklists/{checklistId} {
      allow read: if isStaff();
      allow create, update: if isManager() || (isDriver() && ownChecklist(checklistId));
    }

    function ownChecklist(checklistId) {
      let shiftId = request.resource.data.shiftId;
      return checklistId in [shiftId + '_PRE', shiftId + '_END']
        && get(/databases/$(database)/documents/shifts/$(shiftId)).data.driverId == request.auth.uid;
    }

    match /system_alerts/{alertId} {
      allow read: if isStaff();
      allow update: if isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }
  }
}
