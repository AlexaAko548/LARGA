rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The signed-in user's role from users/{uid}, lower-cased.
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.trim().lower();
    }

    // Signed in as a Manager.
    function isManager() {
      return request.auth != null && getUserRole() == 'manager';
    }

    // Signed in as a Manager or an Assistant Manager.
    function isStaff() {
      return request.auth != null && getUserRole() in ['manager', 'assistant manager'];
    }

    // Signed in as a Driver.
    function isDriver() {
      return request.auth != null && getUserRole() == 'driver';
    }

    // Signed in with any LARGA role (not just any Firebase account).
    function isLargaUser() {
      return request.auth != null && getUserRole() in ['manager', 'assistant manager', 'driver'];
    }

    // expireAt (TTL delete date) is about `days` from now, give or take `slack` days for phone clock drift.
    function expiresWithin(days, slack) {
      let d = request.resource.data;
      return !('expireAt' in d)
        || (resource != null && resource.data.get('expireAt', null) == d.expireAt)
        || (d.expireAt is timestamp
            && d.expireAt > request.time + duration.value(days - slack, 'd')
            && d.expireAt < request.time + duration.value(days + slack, 'd'));
    }

    // expiresWithin with a 7-day slack.
    function expiresAfterDays(days) {
      return expiresWithin(days, 7);
    }

    // The signed-in user is this user.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Profiles: staff can read all; users may only change their phone number and clear their own mustChangePassword.
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow write: if (isManager() && !legacyPushTokenSet())
                   || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['fcmToken', 'tokenUpdatedAt', 'phoneNumber', 'mustChangePassword'])
                        && !legacyPushTokenSet()
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['mustChangePassword'])
                            || request.resource.data.mustChangePassword == false));

      // Push tokens, one doc per device: only the owner can read, write or delete them, and nobody can list them.
      match /fcmTokens/{tokenId} {
        allow get, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && pushTokenOk(tokenId);
      }
    }

    // True when a write sets the old users.fcmToken / tokenUpdatedAt fields (they may only be removed now).
    function legacyPushTokenSet() {
      return request.resource != null
        && legacyFieldSet((resource == null ? request.resource.data.keys()
                                            : request.resource.data.diff(resource.data).affectedKeys()), request.resource.data);
    }

    // A changed old token field that is still present after the write.
    function legacyFieldSet(changed, after) {
      return (changed.hasAny(['fcmToken']) && 'fcmToken' in after)
        || (changed.hasAny(['tokenUpdatedAt']) && 'tokenUpdatedAt' in after);
    }

    // A valid token doc: known fields only, doc ID = SHA-256 of the token, lastSeen = server time.
    function pushTokenOk(tokenId) {
      let t = request.resource.data;
      return t.keys().hasOnly(['token', 'platform', 'deviceId', 'lastSeen'])
        && t.keys().hasAll(['token', 'platform', 'lastSeen'])
        && t.token is string && t.token.size() > 0 && t.token.size() <= 4096
        && tokenId == hashing.sha256(t.token).toHexString()
        && t.platform in ['android', 'ios', 'web']
        && t.get('deviceId', '') is string && t.get('deviceId', '').size() <= 64
        && t.lastSeen == request.time;
    }

    // Shifts: a driver clocks in only for themselves, at server time and after 6:00 AM PH.
    match /shifts/{shiftId} {
      allow read: if isStaff() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if isDriver()
                    && request.resource.data.keys().hasOnly(['driverId', 'taxiId', 'shiftStart', 'startMileage',
                                                             'status', 'shiftId', 'isOnBreak', 'managerNote'])
                    && request.resource.data.driverId == request.auth.uid
                    && request.resource.data.status == 'Active'
                    && request.resource.data.shiftId in ['', shiftId]
                    && request.resource.data.taxiId is string && request.resource.data.taxiId.size() > 0
                    && request.resource.data.startMileage is int && request.resource.data.startMileage > 0
                    && request.resource.data.get('isOnBreak', false) == false
                    && request.resource.data.get('managerNote', '') == ''
                    && request.resource.data.shiftStart == request.time && phHour(request.time) >= 6;
      allow update: if isManager() || (isDriver() && driverShiftUpdateOk(shiftId));
    }

    // What a driver may change on their own shift: GPS, break, clock-out (server time) and a few end-of-shift fields.
    function driverShiftUpdateOk(shiftId) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      let gpsKeys = ['currentLatitude', 'currentLongitude', 'currentSpeed', 'currentHeading',
                     'currentPositionUpdatedAt', 'lastMovingAt', 'distanceKm'];
      return before.driverId == request.auth.uid
        && changed.hasOnly(gpsKeys.concat(['isOnBreak', 'shiftId', 'shiftEnd', 'endMileage', 'status',
                                           'managerNote', 'fuelPenalty']))
        && (!changed.hasAny(gpsKeys) || before.status == 'Active')
        && (!changed.hasAny(['shiftEnd']) || after.shiftEnd == request.time)
        && (!changed.hasAny(['status']) || (before.status == 'Active' && after.status in ['Completed', 'Auto-Closed']))
        && (!changed.hasAny(['fuelPenalty']) || after.fuelPenalty == 0 || after.fuelPenalty == 50)
        && (!changed.hasAny(['managerNote']) || after.managerNote == '')
        && (!changed.hasAny(['endMileage']) || after.status != 'Completed'
            || before.get('startMileage', 0) == 0 || after.endMileage >= before.startMileage)
        && (!changed.hasAny(['shiftId']) || after.shiftId == shiftId);
    }

    // The hour of a timestamp in Philippine time (UTC+8).
    function phHour(t) {
      return (t.hours() + 8) % 24;
    }

    // Payment locks that stop two cashiers booking the same driver at once: staff only.
    match /ledger_locks/{driverId} {
      allow read, write: if isStaff();
    }

    // One active shift per driver and per unit: a driver may only take or release locks for their own shift.
    match /shift_locks/{lockId} {
      allow read: if isLargaUser();
      allow write: if isManager() || (isDriver() && ownShiftLock(lockId));
    }

    // The lock belongs to the driver's own shift, and matches whether that shift is active or ended.
    function ownShiftLock(lockId) {
      let shiftLock = request.resource.data;
      let lockedShift = getAfter(/databases/$(database)/documents/shifts/$(shiftLock.shiftId)).data;
      return shiftLock.driverId == request.auth.uid
        && lockedShift.driverId == request.auth.uid
        && lockId in ['driver_' + request.auth.uid, 'unit_' + lockedShift.taxiId]
        && (shiftLock.get('released', false) == true
              ? lockedShift.status != 'Active'
              : lockedShift.status == 'Active' && shiftLock.get('shiftStart', null) == lockedShift.shiftStart);
    }

    // Schedules: staff read all, drivers read their own days, only the Manager writes.
    match /shift_schedules/{docId} {
      allow read: if isStaff() || (request.auth != null && docId.matches(request.auth.uid + '_[0-9]{8}'));
      allow write: if isManager();
    }

    // Clock-in requests: a driver creates their own, and can only cancel it or mark it clocked in.
    match /clockin_requests/{requestId} {
      allow read: if isStaff() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if isDriver() && request.resource.data.driverId == request.auth.uid
                    && request.resource.data.status == 'Pending';
      allow update: if isManager() || (isDriver() && resource.data.driverId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'shiftId'])
                    && ((resource.data.status == 'Pending' && request.resource.data.status == 'Cancelled')
                        || (resource.data.status == 'Approved' && request.resource.data.status == 'ClockedIn')));
    }

    // Debt adjustments: Manager only, except the automatic negative credit staff record with a payment.
    match /debt_adjustments/{adjustmentId} {
      allow read: if isStaff() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow write: if isManager();
      allow create: if isStaff()
                    && request.resource.data.amount is number && request.resource.data.amount < 0
                    && request.resource.data.transactionId is string && request.resource.data.transactionId.size() > 0
                    && request.resource.data.driverId is string && request.resource.data.driverId.size() > 0;
    }

    // Performance stats: the driver and staff can read, only the Manager writes.
    match /driverPerformance/{driverId} {
      allow read: if isOwner(driverId) || isStaff();
      allow write: if isManager();
    }

    // One conversation per driver: only that driver and staff can open it.
    match /chats/{driverId} {
      allow read, delete: if isStaff() || isOwner(driverId);
      allow create, update: if (isStaff() || isOwner(driverId)) && chatReadStateOk();

      // Messages: only the conversation's people read or post them; nobody edits, deletes or sets pushSentAt from an app.
      match /messages/{messageId} {
        allow read: if isStaff() || isOwner(driverId);
        allow create: if !request.resource.data.keys().hasAny(['pushSentAt'])
                      && ((isStaff() && staffChatSenderOk())
                          || (isOwner(driverId) && expiresAfterDays(365)
                              && request.resource.data.get('isDriver', false) == true
                              && !request.resource.data.keys().hasAny(['senderId', 'senderName', 'senderRole'])));
      }
    }

    // Chat read markers: server-time lastMessageAt, own uid as lastSenderId, and only your own lastReadAtMs entry.
    function chatReadStateOk() {
      let after = request.resource.data;
      let before = resource == null ? {} : resource.data;
      let changed = resource == null ? after.keys() : after.diff(before).affectedKeys();
      let readsAfter = after.get('lastReadAtMs', {});
      return (!changed.hasAny(['lastSenderId']) || after.lastSenderId == request.auth.uid)
        && (!changed.hasAny(['lastMessageAt']) || after.lastMessageAt == request.time)
        && !changed.hasAny(['lastReadAt'])
        && (!changed.hasAny(['lastReadAtMs'])
            || (readsAfter is map
                && readsAfter.diff(before.get('lastReadAtMs', {})).affectedKeys().hasOnly([request.auth.uid])
                && readsAfter[request.auth.uid] is int
                && readsAfter[request.auth.uid] > 0
                && readsAfter[request.auth.uid] <= request.time.toMillis()));
    }

    // A staff message carries the sender's real uid, name and role.
    function staffChatSenderOk() {
      let msg = request.resource.data;
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return msg.get('isDriver', false) == false
        && msg.get('senderId', '') == request.auth.uid
        && msg.get('senderName', null) == me.get('fullName', '')
        && msg.get('senderRole', '') is string
        && msg.get('senderRole', '').trim().lower() == me.role.trim().lower();
    }

    // Units: everyone reads, only the Manager edits.
    match /taxis/{taxiId} {
      allow read: if isLargaUser();
      allow create, update, delete: if isManager();
    }

    // Settings: everyone reads, the Manager edits, but never the SOS phone allowlist (ManagerWeb keeps that).
    match /system_configs/{configId} {
      allow read: if isLargaUser();
      allow create: if isManager() && !request.resource.data.keys().hasAny(['managerPhoneNumbers']);
      allow update: if isManager()
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['managerPhoneNumbers']);
      allow delete: if isManager();
    }

    // Payments: staff record them (up to the apps' 100,000 cap), drivers read their own, only the Manager deletes.
    match /boundary_payments/{paymentId} {
      allow read: if isStaff() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if isStaff()
                    && request.resource.data.amountPaid is number
                    && request.resource.data.amountPaid > 0
                    && request.resource.data.amountPaid <= 100000
                    && request.resource.data.driverId is string && request.resource.data.driverId.size() > 0
                    && request.resource.data.shiftId is string;
      allow delete: if isManager();
    }

    // GCash reference numbers already used: staff only, never overwritten.
    match /payment_references/{reference} {
      allow read, create: if isStaff();
    }

    // Maintenance: drivers report defects for themselves, the Manager does the rest.
    match /maintenance_logs/{maintenanceId} {
      allow read: if isStaff() || isDriver();
      allow create: if isManager()
                    || (isDriver()
                        && request.resource.data.reportedByDriverId == request.auth.uid
                        && request.resource.data.status == 'Reported');
      allow update: if isManager();
    }

    // Fuel reports: a driver files their own, with sane amounts, server time and a shift of theirs.
    match /fuel_logs/{fuelId} {
      allow read: if isStaff() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if isDriver()
                    && request.resource.data.driverId == request.auth.uid
                    && (request.resource.data.verificationStatus == 'Pending'
                        || (request.resource.data.verificationStatus == 'Flagged'
                            && request.resource.data.get('autoFlagged', false) == true
                            && request.resource.data.get('flaggedAt', null) == request.time))
                    && request.resource.data.submittedAt == request.time
                    && request.resource.data.litersRefueled is number
                    && request.resource.data.litersRefueled > 0 && request.resource.data.litersRefueled <= 200
                    && request.resource.data.fuelCost is number
                    && request.resource.data.fuelCost > 0 && request.resource.data.fuelCost <= 20000
                    && fuelShiftOk(request.resource.data.shiftId);
      allow update: if isManager();
    }

    // The fuel report's shift exists, is the driver's own, and is active or recently ended.
    function fuelShiftOk(shiftId) {
      let shiftPath = /databases/$(database)/documents/shifts/$(shiftId);
      let shift = get(shiftPath).data;
      return shiftId is string && shiftId.size() > 0
        && exists(shiftPath)
        && shift.driverId == request.auth.uid
        && activeOrEndedWithin12h(shift);
    }

    // The shift is active or ended in the last 12 hours (an auto-closed one ended at 6:00 AM PH the next day).
    function activeOrEndedWithin12h(shift) {
      return shift.status == 'Active'
        || (shift.status == 'Completed' && shift.get('shiftEnd', null) is timestamp
            && request.time < shift.shiftEnd + duration.value(12, 'h'))
        || (shift.status == 'Auto-Closed'
            && request.time <= (shift.shiftStart + duration.value(8, 'h')).date() + duration.value(34, 'h'));
    }

    // One claim per fuel receipt OR number, created with its fuel log so a receipt can't be used twice.
    match /fuel_or_numbers/{orNumber} {
      allow get: if isLargaUser();
      allow list: if isStaff();
      allow create: if isDriver()
                    && request.resource.data.keys().hasOnly(['fuelLogId', 'createdAt'])
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.fuelLogId is string && request.resource.data.fuelLogId.size() > 0
                    && !exists(/databases/$(database)/documents/fuel_logs/$(request.resource.data.fuelLogId))
                    && getAfter(/databases/$(database)/documents/fuel_logs/$(request.resource.data.fuelLogId)).data.driverId == request.auth.uid;
    }

    // GPS points: a driver writes them only during their own active shift; staff read them.
    match /gps_telemetry/{logId} {
      allow read: if isStaff();
      allow create: if isDriver()
        && request.resource.data.driverId == request.auth.uid
        && expiresWithin(7, 2)
        && get(/databases/$(database)/documents/shifts/$(request.resource.data.shiftId)).data.driverId == request.auth.uid
        && get(/databases/$(database)/documents/shifts/$(request.resource.data.shiftId)).data.status == 'Active';
    }

    // SOS: a driver raises it for their own recent shift and can't set the server's fields; staff read, the Manager resolves.
    match /emergency_alerts/{alertId} {
      allow read: if isStaff();
      allow create: if isDriver() && request.resource.data.driverId == request.auth.uid
                    && request.resource.data.get('isResolved', false) == false
                    && !request.resource.data.keys().hasAny(['expireAt', 'pushSentAt', 'callerCheck', 'callerVerified',
                         'callerVerificationReason', 'address', 'addressSource', 'resolvedAt'])
                    && exists(/databases/$(database)/documents/shifts/$(request.resource.data.shiftId))
                    && get(/databases/$(database)/documents/shifts/$(request.resource.data.shiftId)).data.driverId == request.auth.uid
                    && activeOrEndedWithin12h(get(/databases/$(database)/documents/shifts/$(request.resource.data.shiftId)).data);
      allow update: if isManager();
    }

    // Inventory: Manager only.
    match /spare_parts/{partId} {
      allow read, write: if isManager();
    }

    // Audit log: only the Manager reads; users add entries in their own name, drivers only a few action types.
    match /audit_logs/{logId} {
      allow read: if isManager();
      allow create: if isStaff() && ownAuditEntry();
      allow create: if isDriver() && ownAuditEntry()
         && request.resource.data.actionType in ['SosTriggered', 'VehicleDefectReported', 'DriverPasswordChanged'];
    }

    // The entry is in the writer's own name, stamped with server time.
    function ownAuditEntry() {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.timestamp == request.time;
    }

    // Pre/end-of-shift checklists: a driver writes them for their own shift; staff read.
    match /handover_checklists/{checklistId} {
      allow read: if isStaff();
      allow create, update: if isManager() || (isDriver() && ownChecklist(checklistId));
    }

    // The checklist ID is the shift's _PRE or _END, and the shift is the driver's own.
    function ownChecklist(checklistId) {
      let shiftId = request.resource.data.shiftId;
      return checklistId in [shiftId + '_PRE', shiftId + '_END']
        && get(/databases/$(database)/documents/shifts/$(shiftId)).data.driverId == request.auth.uid;
    }

    // Alert Center items: staff read them and can only mark them read.
    match /system_alerts/{alertId} {
      allow read: if isStaff();
      allow update: if isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }
  }
}
