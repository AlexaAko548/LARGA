rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isManager() {
      return request.auth != null && getUserRole() == 'Manager';
    }

    function isDriver() {
      return request.auth != null && getUserRole() == 'Driver';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isManager();
      // Drivers may only change their push token and contact number themselves - not their
      // unit assignment (only the manager assigns units).
      allow write: if isManager() || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['fcmToken', 'tokenUpdatedAt', 'phoneNumber']));
    }

    match /shifts/{shiftId} {
      allow read: if isManager() || (isDriver() && resource.data.driverId == request.auth.uid);
      // A driver can only clock in / update shifts that are their own, and can't hand a
      // shift to someone else.
      allow create: if isDriver() && request.resource.data.driverId == request.auth.uid;
      allow update: if isManager() || (isDriver() && resource.data.driverId == request.auth.uid
                        && request.resource.data.driverId == resource.data.driverId);
    }

    // Schedule Planner exceptions ({driverId}_{yyyyMMdd}): the driver app reads today's own
    // entry to pick up a substitute unit.
    match /shift_schedules/{docId} {
      allow read: if isManager() || (request.auth != null && docId.matches(request.auth.uid + '_[0-9]{8}'));
      allow write: if isManager();
    }

    // Flagged pre-shift inspections waiting for the manager (paper Ch. IV clock-in process).
    // The driver's phone creates its own request (Pending) and reads it while waiting; it may
    // only withdraw a pending one, or mark an approved one used once its shift has started.
    // Approve/deny is done from ManagerWeb (Admin SDK).
    match /clockin_requests/{requestId} {
      allow read: if isManager() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if isDriver() && request.resource.data.driverId == request.auth.uid
                    && request.resource.data.status == 'Pending';
      allow update: if isManager() || (isDriver() && resource.data.driverId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'shiftId'])
                    && ((resource.data.status == 'Pending' && request.resource.data.status == 'Cancelled')
                        || (resource.data.status == 'Approved' && request.resource.data.status == 'ClockedIn')));
    }

    // Manual penalties/credits - the driver's Ledger and Debt Details screens read their own.
    match /debt_adjustments/{adjustmentId} {
      allow read: if isManager() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow write: if isManager();
    }

    match /driverPerformance/{driverId} {
      allow read: if isOwner(driverId) || isManager();
      allow write: if isManager();
    }

    match /chats/{driverId} {
      allow read, write: if isManager() || isOwner(driverId);

      match /messages/{messageId} {
        allow read, write: if isManager() || isOwner(driverId);
      }
    }

    match /taxis/{taxiId} {
      allow read: if request.auth != null;
      // Drivers only ever change a unit's status (clock-in/out).
      allow update: if isManager() || (isDriver() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow create, delete: if isManager();
    }

    match /system_configs/{configId} {
      allow read: if request.auth != null;
      allow write: if isManager();
    }

    // Payments are recorded by managers only (ManagerWeb's Financial Ledger, the app's Quick
    // Ledger). A driver reads only their own, read-only on their Ledger screen - driverId is set
    // on every payment document (older ones are backfilled by ManagerWeb on startup).
    match /boundary_payments/{paymentId} {
      allow read: if isManager() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create, update, delete: if isManager();
    }

    match /maintenance_logs/{maintenanceId} {
      allow read: if isManager() || isDriver();
      // Managers too: denying a flagged clock-in from the manager app files a Garage report for
      // failed checklist items the driver didn't report (LAR-99, same as ManagerWeb).
      allow create: if isDriver() || isManager();
      allow update: if isManager();
    }

    match /fuel_logs/{fuelId} {
      allow read: if isManager() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if isDriver();
      allow update: if isManager();
    }

    // A point can only come from the driver who owns the shift it's for, and is never edited.
    match /gps_telemetry/{logId} {
      allow read: if isManager();
      allow create: if isDriver()
        && request.resource.data.driverId == request.auth.uid
        && get(/databases/$(database)/documents/shifts/$(request.resource.data.shiftId)).data.driverId == request.auth.uid;
    }

    // Driver SOS (Active Shift screen) - a driver can only raise one as themselves.
    // Resolved from ManagerWeb's SOS Dispatch (Admin SDK) or the manager's Alert Center.
    match /emergency_alerts/{alertId} {
      allow read: if isManager();
      allow create: if isDriver() && request.resource.data.driverId == request.auth.uid;
      allow update: if isManager();
    }

    match /spare_parts/{partId} {
      allow read, write: if isManager();
    }

    match /audit_logs/{logId} {
      allow read, write: if isManager();
    }

    match /handover_checklists/{checklistId} {
      allow read: if isManager();
      allow create: if isDriver();
      allow update: if isManager();
    }

    // Raised by ManagerWeb's background checks (Admin SDK); managers only mark them read.
    match /system_alerts/{alertId} {
      allow read: if isManager();
      allow update: if isManager() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }
  }
}
